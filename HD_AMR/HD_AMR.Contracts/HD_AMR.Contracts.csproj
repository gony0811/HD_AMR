<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!--
      의존성을 의도적으로 0으로 유지한다.
      이 프로젝트는 Windows 제어 프로그램(HD_AMR.Web)과 Jetson Orin Nano 위에서 도는
      LiDAR 서비스(linux-arm64) 양쪽이 함께 참조한다. NModbus/OpenCvSharp.runtime.win/
      RealSense 같은 Windows 전용 패키지가 하나라도 섞이면 Jetson 쪽 빌드가 깨진다.
      System.Text.Json 은 net8.0 공유 프레임워크에 포함되어 있어 패키지 참조가 필요 없다.
    -->

</Project>
