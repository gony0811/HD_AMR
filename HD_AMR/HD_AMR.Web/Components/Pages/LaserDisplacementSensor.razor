@page "/laser"
@rendermode InteractiveServer
@using HD_AMR.Models
@using HD_AMR.Service
@using HD_AMR.Communication
@implements IDisposable
@inject LaserDisplacementSensorService Svc
@inject CobotService Cobot
@inject LaserHeadCalibrationRoutine Routine
@inject ParameterService Params

<PageTitle>Laser Displacement Sensor</PageTitle>

<h1 class="page-title">Laser Displacement Sensor</h1>
<p class="page-subtitle">레이저 변위 센서 — EtherNet/IP 통신 연결 및 3채널 거리 측정</p>

<div class="card card-surface mb-3" style="max-width: 720px;">
    <div class="card-body">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h5 class="card-title mb-0">통신 연결 (EtherNet/IP)</h5>
            <span class="badge @(Svc.IsConnected ? "bg-success" : "bg-secondary")">
                @(Svc.IsConnected ? "연결됨" : "끊김")
            </span>
        </div>

        @* 다른 모듈(AMR/Camera 등)과 동일하게 상시 자동 접속 — 수동 연결/해제 없이 상태만 표시.
           대상 IP/포트는 appsettings 로 설정하며 여기서는 참고용으로만 노출한다. *@
        <div class="text-muted small">대상: @Svc.Settings.IpAddress:@Svc.Settings.Port</div>

        @if (!string.IsNullOrEmpty(Svc.LastError))
        {
            <div class="alert alert-warning mt-3 mb-0 py-2">
                마지막 연결 오류: @Svc.LastError
            </div>
        }
    </div>
</div>

<div class="card card-surface" style="max-width: 720px;">
    <div class="card-body">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h5 class="card-title mb-0">측정값 (거리)</h5>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-outline-primary" @onclick="ZeroSetAll"
                        disabled="@(!Svc.IsConnected)">전체 영점 설정</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="ZeroResetAll"
                        disabled="@(!Svc.IsConnected)">전체 해제</button>
            </div>
        </div>

        @if (!Svc.IsConnected)
        {
            <div class="text-muted">연결되면 채널별 거리가 실시간으로 표시됩니다.</div>
        }
        else
        {
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 70px;">채널</th>
                        <th class="text-end">거리</th>
                        <th>상태</th>
                        <th style="width: 190px;">영점</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in _readings)
                    {
                        <tr>
                            <td><strong>CH@(r.Channel)</strong></td>
                            <td class="text-end">
                                @* 거리 숫자는 Enabled 여부와 무관하게 항상 표시(범위밖이면 흐리게).
                                   유효성은 옆의 "상태" 배지로 구분한다. *@
                                <span class="fs-5 fw-semibold @(r.Enabled ? "" : "text-muted")">@r.Value.ToString("F3")</span>
                                <span class="text-muted ms-1">@Svc.Settings.MeasurementUnit</span>
                            </td>
                            <td>
                                <span class="badge @(r.Enabled ? "bg-success" : "bg-secondary") me-1">
                                    @(r.Enabled ? "측정중" : "범위밖")
                                </span>
                                @if (r.Error)
                                {
                                    <span class="badge bg-danger me-1">에러</span>
                                }
                                @if (r.Warning)
                                {
                                    <span class="badge bg-warning text-dark me-1">경고</span>
                                }
                                @if (r.High)
                                {
                                    <span class="badge bg-info text-dark me-1">HIGH</span>
                                }
                                @if (r.Low)
                                {
                                    <span class="badge bg-info text-dark me-1">LOW</span>
                                }
                                @if (r.Pass)
                                {
                                    <span class="badge bg-primary me-1">PASS</span>
                                }
                                @if (r.Zeroed)
                                {
                                    <span class="badge bg-dark me-1">영점</span>
                                }
                            </td>
                            <td>
                                <button class="btn btn-sm btn-primary me-1" @onclick="() => ZeroSet(r.Channel)">설정</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => ZeroReset(r.Channel)">해제</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @* 삼각형 평면 중심 pose (툴 좌표계). 헤드가 툴에 고정되어 로봇 자세 없이 계산.
               x,y=헤드 XY 평균, z=standoff+거리평균, rx/ry/rz=평면 기울기(Rz=0, 툴축 기준). *@
            <div class="mt-3 pt-3 border-top">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <h6 class="mb-0">삼각형 평면 중심 (툴 좌표계)</h6>
                    <span class="badge @(_pose.Valid ? "bg-success" : "bg-secondary")">
                        @(_pose.Valid ? "계산됨" : "대기")
                    </span>
                </div>

                @if (_pose.Valid)
                {
                    <div class="row g-2 text-center">
                        <div class="col"><div class="small text-muted">X</div><div class="fw-semibold">@_pose.X.ToString("F3")</div></div>
                        <div class="col"><div class="small text-muted">Y</div><div class="fw-semibold">@_pose.Y.ToString("F3")</div></div>
                        <div class="col"><div class="small text-muted">Z</div><div class="fw-semibold">@_pose.Z.ToString("F3")</div></div>
                        <div class="col"><div class="small text-muted">Rx</div><div class="fw-semibold">@_pose.Rx.ToString("F3")<span class="small text-muted">°</span></div></div>
                        <div class="col"><div class="small text-muted">Ry</div><div class="fw-semibold">@_pose.Ry.ToString("F3")<span class="small text-muted">°</span></div></div>
                    </div>
                    <div class="small text-muted mt-2">
                        위치 mm · 회전 도(ZYX) · 법선(툴): (@_pose.Normal[0].ToString("F4"), @_pose.Normal[1].ToString("F4"), @_pose.Normal[2].ToString("F4"))
                    </div>
                    @if (Svc.TiltRef is { } tr && _rawPose.Valid)
                    {
                        <div class="small text-muted">
                            원시(보정 전): Rx=@_rawPose.Rx.ToString("F3")° Ry=@_rawPose.Ry.ToString("F3")°
                            · 기준 Rx=@tr.RxDeg.ToString("F3")° Ry=@tr.RyDeg.ToString("F3")°
                            (@tr.CapturedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm"))
                        </div>
                    }
                }
                else
                {
                    <div class="text-muted small">@_pose.Note</div>
                }
            </div>

            @* 평행 기준: 센서가 툴에 완전 평면으로 장착되지 않은 오차(장착 틸트)를 보정한다.
               툴을 물리적으로 평행하게 맞춘 자세에서 원시 Rx/Ry 를 캡처해 바이어스로 저장하면
               이후 pose·시퀀스 레벨링이 모두 이 기준 대비로 동작한다. Z(절대 거리)는 불변. *@
            <div class="mt-3 pt-3 border-top">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <h6 class="mb-0">평행 기준 (센서 장착 틸트 보정)</h6>
                    <span class="badge @(Svc.TiltRef is not null ? "bg-success" : "bg-secondary")">
                        @(Svc.TiltRef is not null ? "기준 적용중" : "미설정")
                    </span>
                </div>

                <div class="small text-muted mb-2">
                    툴을 대상면과 <strong>물리적으로 평행</strong>하게 맞춘 뒤 저장하세요.
                    이후 모든 틸트(Rx/Ry)는 이 기준 대비로 표시·보정됩니다.
                    헤드 위치 캘리브레이션을 다시 하면 기준도 재저장해야 합니다.
                </div>

                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-primary" @onclick="CaptureReferenceAsync"
                            disabled="@(!Svc.IsConnected || !_rawPose.Valid || _capturingRef || _applying || _calibrating)">
                        @if (_capturingRef)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            <span>샘플링 중…</span>
                        }
                        else
                        {
                            <span>현재 자세를 평행 기준으로 저장</span>
                        }
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ClearReferenceAsync"
                            disabled="@(Svc.TiltRef is null || _capturingRef)">
                        기준 해제
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(_refMsg))
                {
                    <div class="alert @(_refOk ? "alert-success" : "alert-warning") mt-2 mb-0 py-2 small">
                        @_refMsg
                        @if (!string.IsNullOrEmpty(_refWarn))
                        {
                            <br /><span>⚠ @_refWarn</span>
                        }
                    </div>
                }
            </div>

            @* 툴 자세 보정: 측정 평면 기울기(Rx, Ry)를 tool=1 프레임 회전 오프셋으로 실제 로봇에 적용한다.
               위치는 고정, Rz 는 적용하지 않는다(3점 거리로 yaw 미결정). 로봇을 물리적으로 움직이므로
               서보 ON + 연결 상태에서만 활성화하고 저속으로 적용한다. *@
            <div class="mt-3 pt-3 border-top">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <h6 class="mb-0">툴 자세 보정 (Rx, Ry)</h6>
                    <span class="badge @(Cobot.IsConnected ? "bg-success" : "bg-secondary")">
                        @(Cobot.IsConnected ? "로봇 연결됨" : "로봇 끊김")
                    </span>
                </div>

                @if (_pose.Valid)
                {
                    <div class="row g-2 text-center mb-2" style="max-width: 300px;">
                        <div class="col-6">
                            <div class="small text-muted">적용 Rx</div>
                            <div class="fs-5 fw-semibold">@AppliedRx.ToString("F3")<span class="small text-muted">°</span></div>
                        </div>
                        <div class="col-6">
                            <div class="small text-muted">적용 Ry</div>
                            <div class="fs-5 fw-semibold">@AppliedRy.ToString("F3")<span class="small text-muted">°</span></div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-muted small mb-2">평면이 계산되면 적용할 Rx, Ry 가 표시됩니다.</div>
                }

                <div class="d-flex align-items-center gap-2">
                    <label class="small text-muted mb-0">속도(%)</label>
                    <input type="number" class="form-control form-control-sm" style="width: 90px;"
                           min="1" max="30" step="1" @bind="_velPct" />
                    <button class="btn btn-sm btn-warning" @onclick="ApplyCorrectionAsync"
                            disabled="@(!Cobot.IsConnected || !Cobot.IsServoEnabled || !_pose.Valid || _applying || _calibrating)">
                        @if (_applying)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            <span>적용 중…</span>
                        }
                        else
                        {
                            <span>보정 적용</span>
                        }
                    </button>
                    @if (!Cobot.IsServoEnabled)
                    {
                        <span class="small text-muted">서보 ON 필요</span>
                    }
                </div>

                @if (!string.IsNullOrEmpty(_cobotMsg))
                {
                    <div class="alert @(_cobotMsg!.Contains("완료") ? "alert-success" : "alert-warning") mt-2 mb-0 py-2 small">
                        @_cobotMsg
                    </div>
                }
            </div>

            @* 헤드 위치 캘리브레이션(틸트 응답): 로봇이 수평면 위에서 툴프레임 ±θ 회전을 자동 수행,
               각 헤드의 거리 변화 기울기에서 헤드 XY(툴 좌표, appsettings 규약)를 부호 포함 역산한다.
               결과는 표시만 하며 설정 파일에 쓰지 않는다 — JSON 스니펫을 수동 반영 후 앱 재시작. *@
            <details class="mt-3 pt-3 border-top">
                <summary style="cursor: pointer;">
                    <strong>헤드 위치 캘리브레이션</strong>
                    <span class="text-muted small">(틸트 응답 자동측정 — 로봇이 움직입니다)</span>
                </summary>
                <div class="mt-2">
                    <div class="small text-muted mb-2">
                        평평한 면 위에서 실행하세요. '자동 수평'이 켜져 있으면 기울어진 상태에서 시작해도 됩니다 —
                        로봇이 측정값 기반으로 자세를 보정(최대 ±15°×3회)한 뒤 수평에서 최종 산출합니다.
                    </div>

                    <div class="d-flex align-items-center flex-wrap gap-2 mb-2">
                        <label class="small text-muted mb-0">틸트(°)</label>
                        <input type="number" class="form-control form-control-sm" style="width: 80px;"
                               min="0.5" max="5" step="0.5" @bind="_calTiltDeg" disabled="@_calibrating" />
                        <label class="small text-muted mb-0">샘플</label>
                        <input type="number" class="form-control form-control-sm" style="width: 70px;"
                               min="3" max="20" step="1" @bind="_calSamples" disabled="@_calibrating" />
                        <label class="small text-muted mb-0">속도(%)</label>
                        <input type="number" class="form-control form-control-sm" style="width: 80px;"
                               min="1" max="30" step="1" @bind="_calVelPct" disabled="@_calibrating" />
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" id="calSignCheck"
                                   @bind="_calSignCheck" disabled="@_calibrating" />
                            <label class="form-check-label small" for="calSignCheck">부호 검증(+Z 2mm)</label>
                        </div>
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" id="calAutoLevel"
                                   @bind="_calAutoLevel" disabled="@_calibrating" />
                            <label class="form-check-label small" for="calAutoLevel">자동 수평</label>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2 mb-2">
                        <button class="btn btn-sm btn-warning" @onclick="StartCalibrationAsync"
                                disabled="@(!Svc.IsConnected || !Cobot.IsConnected || !Cobot.IsServoEnabled || !_pose.Valid || _calibrating || _applying)">
                            @if (_calibrating)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                <span>캘리브레이션 중…</span>
                            }
                            else
                            {
                                <span>캘리브레이션 시작</span>
                            }
                        </button>
                        @if (_calibrating)
                        {
                            <button class="btn btn-sm btn-outline-danger" @onclick="AbortCalibration">중단</button>
                        }
                        @if (!Cobot.IsServoEnabled)
                        {
                            <span class="small text-muted">서보 ON 필요</span>
                        }
                    </div>

                    @if (_calLog.Count > 0)
                    {
                        <pre class="small bg-body-secondary p-2 rounded mb-2"
                             style="max-height: 180px; overflow-y: auto; white-space: pre-wrap;">@string.Join("\n", _calLog)</pre>
                    }

                    @if (_calResult is { } cr)
                    {
                        @if (!cr.ReturnedToAnchor)
                        {
                            <div class="alert alert-danger py-2 small mb-2">
                                로봇이 앵커 pose 로 복귀하지 못했습니다 — 위치를 수동 확인하세요.
                            </div>
                        }
                        @if (!cr.Success)
                        {
                            <div class="alert alert-warning py-2 small mb-0">캘리브레이션 실패: @cr.Error</div>
                        }
                        else
                        {
                            <table class="table table-sm align-middle mb-2">
                                <thead>
                                    <tr>
                                        <th>CH</th>
                                        <th class="text-end">현재 X</th>
                                        <th class="text-end">측정 X</th>
                                        <th class="text-end">ΔX</th>
                                        <th class="text-end">현재 Y</th>
                                        <th class="text-end">측정 Y</th>
                                        <th class="text-end">ΔY</th>
                                        <th>신뢰도</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var h in cr.Heads)
                                    {
                                        <tr>
                                            <td><strong>CH@(h.Channel)</strong></td>
                                            <td class="text-end">@h.CurrentX.ToString("F2")</td>
                                            <td class="text-end fw-semibold">@h.MeasuredX.ToString("F2")</td>
                                            <td class="text-end text-muted">@((h.MeasuredX - h.CurrentX).ToString("+0.00;-0.00"))</td>
                                            <td class="text-end">@h.CurrentY.ToString("F2")</td>
                                            <td class="text-end fw-semibold">@h.MeasuredY.ToString("F2")</td>
                                            <td class="text-end text-muted">@((h.MeasuredY - h.CurrentY).ToString("+0.00;-0.00"))</td>
                                            <td>
                                                <span class="badge @(h.Confidence == "양호" ? "bg-success" : h.Confidence == "주의" ? "bg-warning text-dark" : "bg-danger")">
                                                    @h.Confidence
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                            <div class="small text-muted mb-2">
                                단위 mm(툴 좌표) · 프로브 @(cr.LevelIterations)회 · 최종 잔여 기울기 @cr.FinalTiltDeg.ToString("F3")°
                                (Rx=@cr.BaselineRxDeg.ToString("F3")°, Ry=@cr.BaselineRyDeg.ToString("F3")°)
                                · 평균거리 @cr.MeanDistanceMm.ToString("F1")mm
                                · 삼각형 면적 @cr.TriangleAreaMm2.ToString("F0")mm²
                                @if (cr.SignCheckPassed)
                                {
                                    <span> · 부호 검증 통과</span>
                                }
                                @if (cr.XAxisFlipped || cr.YAxisFlipped)
                                {
                                    <span class="text-danger"> · 축 반전 발생(X:@cr.XAxisFlipped, Y:@cr.YAxisFlipped)</span>
                                }
                            </div>

                            @foreach (var w in cr.Warnings)
                            {
                                <div class="alert alert-warning py-1 px-2 small mb-2">@w</div>
                            }

                            <div class="small text-muted mb-1">
                                적용: 아래 6줄을 appsettings.json 의 LaserDisplacementSensor 섹션에 덮어쓰고 앱을 재시작하세요.
                            </div>
                            <textarea class="form-control form-control-sm font-monospace" rows="6" readonly
                                      style="font-size: 0.8rem;">@cr.AppSettingsJsonSnippet</textarea>
                        }
                    }
                </div>
            </details>

            @* 토치 팁 TCP 캘리브레이션(레이저 보조 터치): 오퍼레이터가 팁을 평판에 여러 자세로 접촉시키고
               매 접촉마다 레이저 평면 실측 → "팁은 평면 위" 제약(플랜지 좌표)으로 팁 위치 최소자승 산출.
               로봇 자동 모션 없음(수동 조그). 결과는 표시만 하며 명시적 버튼으로만 컨트롤러 공구에 쓴다. *@
            <details class="mt-3 pt-3 border-top">
                <summary style="cursor: pointer;">
                    <strong>로봇 TCP 캘리브레이션</strong>
                    <span class="text-muted small">(레이저 보조 터치 — 로봇은 수동 조그)</span>
                </summary>
                <div class="mt-2">
                    <div class="small text-muted mb-2">
                        평판에 공구 팁을 <strong>물리적으로 접촉</strong>시킨 상태에서 "터치 기록"을 누르세요.
                        서로 다른 기울기(±15~25°, Rx/Ry <strong>양쪽 부호</strong> 혼합)로 최소 3회, 권장 4~6회.
                        팁 Z와 출사면 높이 h는 동시에 관측 불가(빔이 툴 Z와 평행) — 아래 모드로 하나를 고정합니다.
                        정밀도는 접촉 정밀도가 지배합니다(±0.5~1.5mm).
                    </div>
                    <div class="d-flex align-items-center flex-wrap gap-2 mb-2">
                        <select class="form-select form-select-sm" style="width: 300px;"
                                @bind="_tcpMode" @bind:after="ResolveTcp" disabled="@_tcpRecording">
                            <option value="refz">기준 Z 고정 — 팁 X/Y 산출 + h 추정 (기본)</option>
                            <option value="fixh">출사면 h 고정 — 팁 X/Y/Z 전부 산출</option>
                        </select>
                        @if (!_tcpFixH)
                        {
                            <label class="small text-muted mb-0">기준 Z(mm, 플랜지)</label>
                            <input type="number" class="form-control form-control-sm" style="width: 110px;"
                                   step="0.1" @bind="_tcpRefZ" @bind:after="ResolveTcp" disabled="@_tcpRecording" />
                            <span class="small text-muted">미입력 시 첫 기록 때 tool-1 Z로 자동 설정</span>
                        }
                        else
                        {
                            <label class="small text-muted mb-0">출사면 h(mm)</label>
                            <input type="number" class="form-control form-control-sm" style="width: 110px;"
                                   step="0.1" @bind="_tcpFixedH" @bind:after="ResolveTcp" disabled="@_tcpRecording" />
                        }
                    </div>
                    @if (_tcpFixH)
                    {
                        <div class="d-flex align-items-center flex-wrap gap-2 mb-2">
                            <button class="btn btn-sm btn-outline-primary" @onclick="CaptureHeadPlaneAsync"
                                    disabled="@(!Svc.IsConnected || !_pose.Valid || _tcpRecording || _tcpCapturingH)">
                                @if (_tcpCapturingH)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                    <span>캡처 중…</span>
                                }
                                else
                                {
                                    <span>현재 측정거리를 h로 저장</span>
                                }
                            </button>
                            <span class="small text-muted">
                                평면 보정으로 수평(Rx/Ry≈0)을 맞추고 <strong>팁을 평면에 접촉</strong>시킨 상태에서 누르세요.
                            </span>
                        </div>
                        <div class="small text-muted mb-2">
                            h는 위 캡처 또는 "기준 Z 고정" 모드로 1회 산출·저장한 추정치 사용을 권장합니다
                            (센서 브래킷 불변 — 토치 교체 후 재캘리브레이션에 유용). h 오차는 팁 Z에 그대로 전파됩니다.
                        </div>
                    }
                    @if (Svc.TiltRef is null)
                    {
                        <div class="alert alert-warning py-1 px-2 small mb-2">
                            평행 기준 미설정 — 먼저 평행 기준을 저장하면 정확도가 향상됩니다(법선 오차가 레버암으로 증폭).
                        </div>
                    }

                    <div class="d-flex align-items-center gap-2 mb-2">
                        <button class="btn btn-sm btn-primary" @onclick="RecordTouchAsync"
                                disabled="@(!Svc.IsConnected || !Cobot.IsConnected || !_pose.Valid || _tcpRecording || _applying || _calibrating)">
                            @if (_tcpRecording)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                <span>샘플링 중…</span>
                            }
                            else
                            {
                                <span>터치 기록</span>
                            }
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="ClearTouches"
                                disabled="@(_tcpCal.Touches.Count == 0 || _tcpRecording)">전체 삭제</button>
                        @* 네이티브 onclick(Blazor @onclick 아님) — 사용자 제스처 직접 전달로 팝업 차단 회피,
                           창 이름 공유(cobotJog)로 다른 페이지에서 연 조그 창을 재사용/포커스한다. *@
                        <button class="btn btn-sm btn-outline-primary" type="button"
                                onclick="window.open('/jog','cobotJog','width=1040,height=820,menubar=no,toolbar=no,location=no,resizable=yes')">
                            조그 팝업
                        </button>
                        <span class="small text-muted">기록 @(_tcpCal.Touches.Count)개</span>
                    </div>

                    @if (_tcpCal.Touches.Count > 0)
                    {
                        <table class="table table-sm align-middle mb-2" style="max-width: 560px;">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th class="text-end">Rx(°)</th>
                                    <th class="text-end">Ry(°)</th>
                                    <th class="text-end">거리(mm)</th>
                                    <th class="text-end">잔차(mm)</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < _tcpCal.Touches.Count; i++)
                                {
                                    var idx = i;
                                    var t = _tcpCal.Touches[i];
                                    double? res = _tcpResult is { Success: true } rr && i < rr.ResidualsMm.Count
                                        ? rr.ResidualsMm[i] : null;
                                    <tr>
                                        <td>@(i + 1)</td>
                                        <td class="text-end">@t.RxDeg.ToString("F2")</td>
                                        <td class="text-end">@t.RyDeg.ToString("F2")</td>
                                        <td class="text-end">@t.MeanDistanceMm.ToString("F1")</td>
                                        <td class="text-end">
                                            @if (res is { } rv)
                                            {
                                                <span class="@(Math.Abs(rv) > 1.0 ? "badge bg-danger" : "")">@rv.ToString("+0.00;-0.00")</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-secondary py-0" @onclick="() => RemoveTouch(idx)"
                                                    disabled="@_tcpRecording">삭제</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }

                    @if (_tcpResult is { } tr2)
                    {
                        @if (!tr2.Success)
                        {
                            <div class="alert alert-warning py-2 small mb-2">산출 실패: @tr2.Error</div>
                        }
                        else
                        {
                            <div class="row g-2 text-center mb-2" style="max-width: 480px;">
                                <div class="col"><div class="small text-muted">Tip X (산출)</div><div class="fw-semibold">@tr2.TipX.ToString("F2")</div></div>
                                <div class="col"><div class="small text-muted">Tip Y (산출)</div><div class="fw-semibold">@tr2.TipY.ToString("F2")</div></div>
                                <div class="col"><div class="small text-muted">Tip Z (@(_tcpFixH ? "산출" : "기준값"))</div><div class="fw-semibold">@tr2.TipZ.ToString("F2")</div></div>
                                <div class="col"><div class="small text-muted">h (@(_tcpFixH ? "고정값" : "추정"))</div><div class="fw-semibold">@tr2.HeadPlaneZmm.ToString("F1")</div></div>
                            </div>
                            <div class="small text-muted mb-2">
                                플랜지 좌표 mm · 잔차 RMS @tr2.RmsMm.ToString("F3")mm (최대 @tr2.MaxAbsMm.ToString("F3")mm)
                                · 컨디셔닝 @tr2.SpreadDeg.ToString("F1")°
                                · h는 터치 평균거리(~@(_tcpCal.Touches.Count > 0 ? _tcpCal.Touches.Average(t => t.MeanDistanceMm).ToString("F0") : "—")mm)와 비슷해야 정상
                                @if (!_tcpFixH)
                                {
                                    <button class="btn btn-sm btn-outline-primary py-0 ms-1" @onclick="() => SaveHeadPlaneAsync(tr2.HeadPlaneZmm)">
                                        h 저장
                                    </button>
                                }
                                @if (tr2.DeltaFromTool1 is { } d)
                                {
                                    <span>
                                        · tool-1 대비 Δ=(@d[0].ToString("F1"), @d[1].ToString("F1"), @d[2].ToString("F1"))
                                        |Δ|=@Math.Sqrt(d[0] * d[0] + d[1] * d[1] + d[2] * d[2]).ToString("F1")mm
                                    </span>
                                }
                            </div>
                            @foreach (var w in tr2.Warnings)
                            {
                                <div class="alert alert-warning py-1 px-2 small mb-2">@w</div>
                            }

                            <div class="d-flex align-items-center flex-wrap gap-2 mb-2">
                                <label class="small text-muted mb-0">공구 번호</label>
                                <input type="number" class="form-control form-control-sm" style="width: 70px;"
                                       min="1" max="14" step="1" @bind="_tcpWriteId" disabled="@_tcpWriting" />
                                <div class="form-check mb-0">
                                    <input class="form-check-input" type="checkbox" id="tcpConfirm" @bind="_tcpConfirm" />
                                    <label class="form-check-label small" for="tcpConfirm">결과를 확인했습니다</label>
                                </div>
                                <button class="btn btn-sm btn-warning" @onclick="WriteTcpToolAsync"
                                        disabled="@(!Cobot.IsConnected || !_tcpConfirm || _tcpWriting || (_tcpWriteId == 1 && !_tcpAllowTool1))">
                                    @if (_tcpWriting)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                        <span>쓰는 중…</span>
                                    }
                                    else
                                    {
                                        <span>tool @(_tcpWriteId)에 쓰기</span>
                                    }
                                </button>
                            </div>
                            @if (_tcpWriteId == 1)
                            {
                                <div class="alert alert-danger py-2 small mb-2">
                                    tool 1은 레이저 센서 프레임입니다 — 덮어쓰면 헤드 기하·평행 기준 등 센서 기하 전체가 무효화됩니다.
                                    <div class="form-check mt-1 mb-0">
                                        <input class="form-check-input" type="checkbox" id="tcpAllowTool1" @bind="_tcpAllowTool1" />
                                        <label class="form-check-label" for="tcpAllowTool1">위험을 이해하고 tool 1을 덮어씁니다</label>
                                    </div>
                                </div>
                            }
                            <div class="small text-muted mb-2">
                                회전은 tool-1 정의를 복사하고 위치만 산출값으로 설정합니다.
                                쓰기 후 팁을 기준점에 대고 새 공구 기준 ±10° 회전으로 팁 고정 여부를 검증하세요.
                            </div>
                        }
                    }

                    @if (!string.IsNullOrEmpty(_tcpMsg))
                    {
                        <div class="alert @(_tcpMsgOk ? "alert-success" : "alert-warning") py-2 small mb-0">@_tcpMsg</div>
                    }
                </div>
            </details>

            @* 진단: 실장비에서 상태 비트 오프셋 확정용. 측정 중일 때 아래 각 상태 byte 의 실제 값을 보고
               어느 byte 의 CH비트가 ON 되는지 확인해 appsettings 의 *ByteOffset 을 확정한다. *@
            <details class="mt-3">
                <summary class="text-muted" style="cursor: pointer;">진단 (상태 오프셋 / Input Assembly 원본)</summary>
                <div class="mt-2">
                    <div class="mb-2 small">
                        <span class="text-muted">측정:</span> byte @Svc.Settings.MeasurementByteOffset
                        (stride @Svc.Settings.MeasurementStride) · ×@Svc.Settings.MeasurementScale
                    </div>
                    <table class="table table-sm mb-2" style="max-width: 360px;">
                        <thead>
                            <tr><th>상태</th><th class="text-end">오프셋</th><th class="text-end">현재 byte 값</th></tr>
                        </thead>
                        <tbody>
                            <tr><td>Enable</td><td class="text-end">byte @Svc.Settings.SensorEnableByteOffset</td><td class="text-end font-monospace">@ByteHex(Svc.Settings.SensorEnableByteOffset)</td></tr>
                            <tr><td>Error</td><td class="text-end">byte @Svc.Settings.SensorErrorByteOffset</td><td class="text-end font-monospace">@ByteHex(Svc.Settings.SensorErrorByteOffset)</td></tr>
                            <tr><td>Warning</td><td class="text-end">byte @Svc.Settings.SensorWarningByteOffset</td><td class="text-end font-monospace">@ByteHex(Svc.Settings.SensorWarningByteOffset)</td></tr>
                            <tr><td>HIGH</td><td class="text-end">byte @Svc.Settings.OutputHighByteOffset</td><td class="text-end font-monospace">@ByteHex(Svc.Settings.OutputHighByteOffset)</td></tr>
                            <tr><td>LOW</td><td class="text-end">byte @Svc.Settings.OutputLowByteOffset</td><td class="text-end font-monospace">@ByteHex(Svc.Settings.OutputLowByteOffset)</td></tr>
                            <tr><td>PASS</td><td class="text-end">byte @Svc.Settings.OutputPassByteOffset</td><td class="text-end font-monospace">@ByteHex(Svc.Settings.OutputPassByteOffset)</td></tr>
                        </tbody>
                    </table>
                    <div class="small text-muted mb-1">Input Assembly (@(_dumpBytes?.Length ?? 0) bytes, hex):</div>
                    <pre class="small bg-body-secondary p-2 rounded" style="white-space: pre-wrap; word-break: break-all;">@_hexDump</pre>
                </div>
            </details>
        }
    </div>
</div>

@code {
    private IReadOnlyList<LaserChannelReading> _readings = Array.Empty<LaserChannelReading>();

    // 삼각형 평면 중심 pose(툴 좌표계 x,y,z,rx,ry,rz). 매 폴링마다 갱신. 평행 기준이 있으면 보정된 값.
    private PlanePose _pose = PlanePose.Invalid("연결 대기 중.");

    // 보정 전 원시 pose — 평행 기준 캡처·진단 표시용.
    private PlanePose _rawPose = PlanePose.Invalid("연결 대기 중.");

    // 평행 기준(장착 틸트 바이어스) 캡처 상태.
    private bool _capturingRef;
    private bool _refOk;
    private string? _refMsg;
    private string? _refWarn;

    // 툴 자세 보정: 측정 평면 기울기(Rx, Ry)를 툴프레임 회전 오프셋으로 적용.
    private double _velPct = 5;        // 보정 이동 속도(%) — 안전 기본 저속.
    private bool _applying;
    private string? _cobotMsg;

    // 실장비 검증 부호: 툴을 +Rx 회전 → 측정 Rx 가 −로 수렴(gain≈−1)이므로 offset=+Rx.
    // 툴을 +Ry 회전 → 측정 Ry 가 +로 발산(gain≈+1)이므로 offset=−Ry(반전).
    private double AppliedRx => _pose.Rx;
    private double AppliedRy => -_pose.Ry;

    // 토치 팁 TCP 캘리브레이션(레이저 보조 터치) 상태 — 서킷당 수집기 1개, 저장 없음.
    private readonly TcpTouchCalibrator _tcpCal = new();
    private bool _tcpRecording;
    private bool _tcpWriting;
    private TcpTouchCalibrationResult? _tcpResult;
    private string? _tcpMsg;
    private bool _tcpMsgOk;
    private int _tcpWriteId = 3;
    private bool _tcpConfirm;
    private bool _tcpAllowTool1;

    // 기준 Z(플랜지 mm) — 팁 Z는 레이저로 관측 불가 DOF 라서 외부 기준(펜던트/도면)으로 고정.
    // null 이면 첫 기록 시 tool-1 Z 로 자동 설정.
    private double? _tcpRefZ;

    // 모드: "refz"=기준 Z 고정(팁 X/Y 산출 + h 추정), "fixh"=출사면 h 고정(팁 X/Y/Z 산출).
    // select 바인딩은 bool 대신 문자열 사용 — bool 은 "True/False"(대문자)로 렌더되어
    // 소문자 option value 와 불일치 → 선택 표시가 비는 함정 회피.
    private string _tcpMode = "refz";
    private bool _tcpFixH => _tcpMode == "fixh";
    private double? _tcpFixedH;
    private bool _tcpCapturingH;
    private const string HeadPlaneParamKey = "Laser.TouchTcp.HeadPlaneZmm";

    // 헤드 위치 캘리브레이션(틸트 응답) 상태.
    private double _calTiltDeg = 2.0;
    private int _calSamples = 5;
    private double _calVelPct = 5;
    private bool _calSignCheck = true;
    private bool _calAutoLevel = true;
    private bool _calibrating;
    private CancellationTokenSource? _calCts;
    private readonly List<string> _calLog = new();
    private LaserHeadCalibrationResult? _calResult;

    // 진단(Input Assembly 원본 hex) 상태.
    private byte[]? _dumpBytes;
    private string _hexDump = "(프레임 없음)";

    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync()
    {
        _cts = new CancellationTokenSource();
        _ = RefreshLoopAsync(_cts.Token);

        // 저장된 출사면 h(경험적 앵커) 로드 — 없거나 DB 미준비면 미입력 상태 유지.
        try
        {
            _tcpFixedH = await Params.GetDoubleAsync(HeadPlaneParamKey);
        }
        catch
        {
            // 페이지 표시를 막지 않는다 — h 고정 모드 사용 시 직접 입력하면 된다.
        }
    }

    // 연결 상태일 때 UiRefreshMs 주기로 측정 스냅샷을 갱신한다.
    private async Task RefreshLoopAsync(CancellationToken ct)
    {
        var period = TimeSpan.FromMilliseconds(Math.Max(50, Svc.Settings.UiRefreshMs));
        _timer = new PeriodicTimer(period);
        try
        {
            while (await _timer.WaitForNextTickAsync(ct))
            {
                if (Svc.IsConnected)
                {
                    _readings = Svc.GetReadings();
                    _pose = Svc.GetPlanePose();
                    _rawPose = Svc.GetRawPlanePose();
                    _dumpBytes = Svc.SnapshotInputAssembly();
                    _hexDump = FormatHex(_dumpBytes);
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException)
        {
            // 페이지 폐기 — 정상 종료.
        }
    }

    // 진단: 주어진 오프셋의 최신 프레임 byte 값을 "0xNN (2진수)" 로. 비트가 어느 채널인지 대조용.
    private string ByteHex(int offset)
    {
        var d = _dumpBytes;
        if (d is null || (uint)offset >= (uint)d.Length) return "—";
        return $"0x{d[offset]:X2} ({Convert.ToString(d[offset], 2).PadLeft(8, '0')})";
    }

    // 바이트 오프셋을 쉽게 대조하도록 16바이트마다 "오프셋: 바이트열" 형식으로 hex 덤프.
    private static string FormatHex(byte[]? data)
    {
        if (data is null || data.Length == 0) return "(프레임 없음)";
        var sb = new System.Text.StringBuilder(data.Length * 3 + data.Length / 16 * 8);
        for (int i = 0; i < data.Length; i += 16)
        {
            sb.Append(i.ToString("D3")).Append(": ");
            for (int j = i; j < i + 16 && j < data.Length; j++)
                sb.Append(data[j].ToString("X2")).Append(' ');
            sb.Append('\n');
        }
        return sb.ToString();
    }

    private void ZeroSet(int ch)
    {
        Svc.ZeroSet(ch);
        _readings = Svc.GetReadings();
    }

    private void ZeroReset(int ch)
    {
        Svc.ZeroReset(ch);
        _readings = Svc.GetReadings();
    }

    private void ZeroSetAll()
    {
        Svc.ZeroSetAll();
        _readings = Svc.GetReadings();
    }

    private void ZeroResetAll()
    {
        Svc.ZeroResetAll();
        _readings = Svc.GetReadings();
    }

    // 현재(물리적으로 평행하게 맞춘) 자세의 원시 틸트를 평행 기준으로 저장.
    private async Task CaptureReferenceAsync()
    {
        if (_capturingRef) return;

        _capturingRef = true;
        _refMsg = null;
        _refWarn = null;
        try
        {
            var (ok, msg, warn) = await Svc.CaptureTiltReferenceAsync();
            _refOk = ok;
            _refMsg = msg;
            _refWarn = warn;
        }
        catch (Exception ex)
        {
            _refOk = false;
            _refMsg = $"기준 저장 오류: {ex.Message}";
        }
        finally
        {
            _capturingRef = false;
        }
    }

    // 평행 기준 해제(보정 없는 원시 틸트로 복귀).
    private async Task ClearReferenceAsync()
    {
        try
        {
            await Svc.ClearTiltReferenceAsync();
            _refOk = true;
            _refMsg = "평행 기준을 해제했습니다.";
            _refWarn = null;
        }
        catch (Exception ex)
        {
            _refOk = false;
            _refMsg = $"기준 해제 오류: {ex.Message}";
        }
    }

    // 측정 평면 기울기(Rx, Ry)를 tool=1 프레임의 회전 오프셋으로 실제 로봇에 적용(자세 보정 이동).
    // 위치는 고정, Rz=0(3점 거리로 yaw 미결정). anchor 는 모션 없이 조회한 베이스 기준 TCP pose.
    private async Task ApplyCorrectionAsync()
    {
        if (_applying) return;
        if (!_pose.Valid)
        {
            _cobotMsg = "평면 계산이 필요합니다.";
            return;
        }

        _applying = true;
        _cobotMsg = null;
        try
        {
            var offset = new[] { 0.0, 0.0, 0.0, AppliedRx, AppliedRy, 0.0 };
            var anchor = await Cobot.Rpc.GetTcpPoseInBaseAsync(1);
            var rc = await Cobot.Rpc.MoveByToolOffsetAsync(anchor, user: 0, offset,
                tool: 1, vel: Math.Clamp(_velPct, 1, 30));

            _cobotMsg = rc == 0
                ? $"보정 적용 완료 (Rx={AppliedRx:0.###}°, Ry={AppliedRy:0.###}°)."
                : $"보정 이동 실패 (rc={rc}){FairinoErrorCodes.Suffix(rc)}.";
        }
        catch (Exception ex)
        {
            _cobotMsg = $"보정 적용 오류: {ex.Message}";
        }
        finally
        {
            _applying = false;
        }
    }

    // 터치 기록: 팁이 평판에 접촉한 상태에서 보정 pose 5샘플 평균 + 기록 시점 tool-1 정의로
    // 플랜지 좌표 평면 제약 1건 생성. 3개 이상이면 자동 산출.
    private async Task RecordTouchAsync()
    {
        if (_tcpRecording) return;

        _tcpRecording = true;
        _tcpMsg = null;
        try
        {
            double sx = 0, sy = 0, sz = 0, srx = 0, sry = 0;
            int valid = 0;
            string? note = null;
            for (int i = 0; i < 5; i++)
            {
                if (i > 0) await Task.Delay(100);
                var p = Svc.GetPlanePose();
                if (p.Valid) { sx += p.X; sy += p.Y; sz += p.Z; srx += p.Rx; sry += p.Ry; valid++; }
                else note = p.Note;
            }
            if (valid < 3)
            {
                _tcpMsgOk = false;
                _tcpMsg = $"유효 샘플 부족({valid}/5) — {note ?? "센서 상태를 확인하세요."}";
                return;
            }

            // 기록마다 tool-1 정의 조회 — 기록 사이 변경되면 Solve 가 경고한다.
            var t1 = await Cobot.Rpc.GetToolCoordAsync(1);
            _tcpRefZ ??= t1[2];   // 기준 Z 미입력이면 기존 tool-1 Z 를 기본값으로.
            var rec = TcpTouchCalibrator.BuildRecord(
                sx / valid, sy / valid, sz / valid, srx / valid, sry / valid, t1, DateTime.UtcNow);
            _tcpCal.Add(rec);
            ResolveTcp();
            _tcpMsgOk = true;
            _tcpMsg = $"터치 #{_tcpCal.Touches.Count} 기록됨 (Rx={rec.RxDeg:F2}°, Ry={rec.RyDeg:F2}°, 거리 {rec.MeanDistanceMm:F1}mm)";
        }
        catch (Exception ex)
        {
            _tcpMsgOk = false;
            _tcpMsg = $"터치 기록 오류: {ex.Message}";
        }
        finally
        {
            _tcpRecording = false;
        }
    }

    private void RemoveTouch(int index)
    {
        _tcpCal.RemoveAt(index);
        ResolveTcp();
    }

    // 모드/기준값 변경·기록 추가·삭제 시 재산출. 기록 3개 미만이거나 고정값 미입력이면 결과 제거.
    private void ResolveTcp()
    {
        var t1 = _tcpCal.Touches.Count > 0 ? _tcpCal.Touches[0].ToolCoord1 : null;
        _tcpResult = (_tcpCal.Touches.Count, _tcpFixH, _tcpRefZ, _tcpFixedH) switch
        {
            ( >= 3, false, { } refZ, _) => _tcpCal.Solve(refZ, t1),
            ( >= 3, true, _, { } fixH) => _tcpCal.SolveWithFixedHeadPlane(fixH, t1),
            _ => null,
        };
        _tcpConfirm = false;
    }

    // 수평(빔⊥평면) + 팁 접촉 상태에서는 측정거리 = h 가 성립 — 그 순간의 평균 측정거리를
    // h 앵커로 캡처한다. 잔여 틸트 ε는 헤드중심↔팁 레버암(~138mm)으로 h 오차 ≈ 138·tanε 를
    // 만들므로 0.5° 이상이면 경고(저장은 진행).
    private async Task CaptureHeadPlaneAsync()
    {
        if (_tcpCapturingH) return;

        _tcpCapturingH = true;
        _tcpMsg = null;
        try
        {
            double sz = 0, srx = 0, sry = 0;
            int valid = 0;
            string? note = null;
            for (int i = 0; i < 5; i++)
            {
                if (i > 0) await Task.Delay(100);
                var p = Svc.GetPlanePose();
                if (p.Valid) { sz += p.Z; srx += p.Rx; sry += p.Ry; valid++; }
                else note = p.Note;
            }
            if (valid < 3)
            {
                _tcpMsgOk = false;
                _tcpMsg = $"유효 샘플 부족({valid}/5) — {note ?? "센서 상태를 확인하세요."}";
                return;
            }

            double h = sz / valid;
            double maxTilt = Math.Max(Math.Abs(srx / valid), Math.Abs(sry / valid));

            await Params.SetDoubleAsync(HeadPlaneParamKey, h, "터치 TCP — 출사면 높이 h(수평+팁 접촉 캡처)");
            _tcpFixedH = h;
            ResolveTcp();
            _tcpMsgOk = maxTilt < 0.5;
            _tcpMsg = $"출사면 h={h:F1}mm 저장됨 (잔여 틸트 {maxTilt:F2}°).";
            if (maxTilt >= 0.5)
            {
                double errMm = 138.0 * Math.Tan(maxTilt * Math.PI / 180.0);
                _tcpMsg += $" ⚠ 잔여 틸트가 큽니다 — h 오차 ≈ {errMm:F1}mm 가능, '보정 적용'으로 수평을 맞춘 뒤 재캡처를 권장합니다.";
            }
        }
        catch (Exception ex)
        {
            _tcpMsgOk = false;
            _tcpMsg = $"h 캡처 오류: {ex.Message}";
        }
        finally
        {
            _tcpCapturingH = false;
        }
    }

    // 모드 1 산출 h 를 DB에 저장 — 이후 h 고정 모드(토치 교체 재캘리브레이션)의 앵커로 사용.
    private async Task SaveHeadPlaneAsync(double h)
    {
        try
        {
            await Params.SetDoubleAsync(HeadPlaneParamKey, h, "터치 TCP — 출사면 높이 h(경험적 앵커, 기준 Z 모드 산출)");
            _tcpFixedH = h;
            _tcpMsgOk = true;
            _tcpMsg = $"출사면 h={h:F1}mm 저장됨 — 'h 고정' 모드에서 자동 사용됩니다.";
        }
        catch (Exception ex)
        {
            _tcpMsgOk = false;
            _tcpMsg = $"h 저장 실패: {ex.Message}";
        }
    }

    private void ClearTouches()
    {
        _tcpCal.Clear();
        _tcpResult = null;
        _tcpMsg = null;
        _tcpConfirm = false;
    }

    // 산출된 팁 위치를 컨트롤러 공구 좌표계에 쓴다 — 위치만 산출값, 회전은 tool-1 정의 복사.
    private async Task WriteTcpToolAsync()
    {
        if (_tcpWriting || _tcpResult is not { Success: true } r) return;

        _tcpWriting = true;
        _tcpMsg = null;
        try
        {
            var t1 = await Cobot.Rpc.GetToolCoordAsync(1);
            var coord = new[] { r.TipX, r.TipY, r.TipZ, t1[3], t1[4], t1[5] };
            var rc = await Cobot.Rpc.SetToolCoordAsync(_tcpWriteId, coord);
            _tcpMsgOk = rc == 0;
            _tcpMsg = rc == 0
                ? $"tool {_tcpWriteId} 설정 완료: ({r.TipX:F2}, {r.TipY:F2}, {r.TipZ:F2}) + tool-1 회전."
                : $"tool {_tcpWriteId} 설정 실패 (rc={rc}){FairinoErrorCodes.Suffix(rc)}.";
        }
        catch (Exception ex)
        {
            _tcpMsgOk = false;
            _tcpMsg = $"공구 설정 오류: {ex.Message}";
        }
        finally
        {
            _tcpWriting = false;
        }
    }

    // 헤드 위치 캘리브레이션 실행. 루틴이 예외 대신 결과 객체를 반환하므로 여기 catch 는 안전망.
    private async Task StartCalibrationAsync()
    {
        if (_calibrating) return;

        _calibrating = true;
        _calResult = null;
        _calLog.Clear();
        _calCts = new CancellationTokenSource();
        try
        {
            var opts = new LaserHeadCalibrationOptions
            {
                TiltDeg = _calTiltDeg,
                SamplesPerPoint = _calSamples,
                VelPct = _calVelPct,
                VerifyReadingSign = _calSignCheck,
                AutoLevel = _calAutoLevel,
            };
            _calResult = await Routine.RunAsync(opts,
                msg => { _calLog.Add(msg); _ = InvokeAsync(StateHasChanged); },
                _calCts.Token);
        }
        catch (Exception ex)
        {
            _calResult = LaserHeadCalibrationResult.Fail($"예기치 못한 오류: {ex.Message}");
        }
        finally
        {
            _calibrating = false;
            _calCts.Dispose();
            _calCts = null;
        }
    }

    private void AbortCalibration() => _calCts?.Cancel();

    public void Dispose()
    {
        _calCts?.Cancel();
        _cts?.Cancel();
        _timer?.Dispose();
        _cts?.Dispose();
    }
}
