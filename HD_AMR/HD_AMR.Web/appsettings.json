{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=hd_amr.db"
  },
  "DwgConversion": {
    "OdaFileConverterPath": "/Applications/ODAFileConverter.app/Contents/MacOS/ODAFileConverter",
    "OutputVersion": "ACAD2018",
    "TimeoutSeconds": 60
  },
  "Amr": {
    "Name": "AMR",
    "IpAddress": "10.10.100.200",
    "Port": 502,
    "SlaveId": 1,
    "ReadTimeoutMs": 3000,
    "WriteTimeoutMs": 3000
  },
  "Cobot": {
    "Name": "Cobot",
    "IpAddress": "10.10.100.11",
    "CommandPort": 20003,
    "RpcPath": "/RPC2",
    "StatePort": 20004,
    "DefaultToolId": 1,
    "DefaultUserId": 0,
    "DefaultVelPct": 20,
    "TimeoutMs": 5000,
    "CommandTimeoutMs": 600000
  },
  "Camera": {
    "Name": "D435",
    "DeviceSerial": null,
    "ColorWidth": 1280,
    "ColorHeight": 720,
    "ColorFps": 15,
    "EnableColor": true,
    "DepthWidth": 848,
    "DepthHeight": 480,
    "DepthFps": 15,
    "EnableDepth": true,
    "IrWidth": 848,
    "IrHeight": 480,
    "IrFps": 15,
    "EnableIr": true,
    "DepthMinMm": 280,
    "DepthMaxMm": 4000,
    "JpegQuality": 75,
    "ReconnectDelayMs": 5000,
    "MjpegFps": 15,
    "FrameWaitTimeoutMs": 2000,
    "FrameStarvationReconnectMs": 4000,
    "EnableEmitter": true,
    "VisualPreset": "HighAccuracy",
    "LaserPower": -1,
    "IrAutoExposure": true,
    "IrExposureUs": -1,
    "IrGain": -1,
    "DepthFilters": {
      "Enabled": true,
      "UseDecimation": false,
      "DecimationMagnitude": 2,
      "UseThreshold": true,
      "ThresholdMinMm": 150,
      "ThresholdMaxMm": 1500,
      "UseDisparityDomain": true,
      "UseSpatial": true,
      "SpatialMagnitude": 2,
      "SpatialSmoothAlpha": 0.5,
      "SpatialSmoothDelta": 20,
      "SpatialHolesFill": 2,
      "UseTemporal": true,
      "TemporalSmoothAlpha": 0.4,
      "TemporalSmoothDelta": 20,
      "TemporalPersistence": 3,
      "UseHoleFilling": false,
      "HoleFillingMode": 2
    }
  },
  "Vision": {
    "Name": "Vision",
    "ServerHost": "10.10.100.201",
    "Port": 8000,
    "HeartbeatPeriodMs": 5000,
    "ReconnectDelayMs": 3000,
    "MaxReconnectAttempts": 10
  },
  "LaserDisplacementSensor": {
    "Name": "LaserDisplacementSensor",
    "IpAddress": "192.168.0.1",
    "Port": 44818,
    "ConnectTimeoutMs": 3000,
    "ReconnectDelayMs": 5000,
    "RpiMs": 50,
    "ChannelCount": 3,
    "ConfigAssemblyInstanceId": 1,
    "MeasurementByteOffset": 48,
    "MeasurementStride": 4,
    "MeasurementScale": -0.00001,
    "MeasurementOffsetMm": 300.0,
    "MeasurementUnit": "mm",
    "SensorErrorByteOffset": 2,
    "SensorWarningByteOffset": 4,
    "SensorEnableByteOffset": 10,
    "OutputHighByteOffset": 18,
    "OutputLowByteOffset": 20,
    "OutputPassByteOffset": 22,
    "UiRefreshMs": 200,
    "Head1OffsetXmm": 22.62,
    "Head1OffsetYmm": -152.79,
    "Head2OffsetXmm": 4.99,
    "Head2OffsetYmm": -119.05,
    "Head3OffsetXmm": -14.91,
    "Head3OffsetYmm": -151.02,
    "TiltReadingSignForUp": true,
    "BeamAlongPlusZ": false,
    "TiltStandoffMm": 0.0
  },
  "LidarVision": {
    "Name": "LidarVision",
    "//BaseUrl": "Jetson Orin Nano 의 LiDAR 서비스. Kestrel 이 0.0.0.0:8080 에서 듣는다.",
    "BaseUrl": "http://192.168.0.30:8080",
    "RequestTimeoutMs": 3000,
    "//MeasureFrames": "10프레임에서 단일 프레임 σ 8~12mm 가 4~7mm 로 떨어진다. 그 이상은 이득이 거의 없다.",
    "MeasureFrames": 10,
    "MeasureTimeoutMs": 3000,
    "//MeasureTimeoutMarginMs": "HTTP 타임아웃이 서버측보다 짧으면 실패 사유가 담긴 응답을 받기 전에 끊어버린다.",
    "MeasureTimeoutMarginMs": 2000,
    "RetryCount": 2,
    "RetryDelayMs": 300,
    "//HandEyeCalibrated": "false 인 동안 좌표 변환은 실패를 반환한다. 캘리브레이션 전에 그럴듯한 좌표가 나오면 그대로 코봇이 움직인다.",
    "HandEyeCalibrated": false,
    "//Mount": "센서 좌표계를 툴 좌표계로 옮기는 변환. 센서는 이미저가 90° 회전 장착이라 열 증가=+X, 행 증가=+Y 다 — 이 회전까지 포함해야 한다.",
    "MountOffsetXmm": 0.0,
    "MountOffsetYmm": 0.0,
    "MountOffsetZmm": 0.0,
    "MountRxDeg": 0.0,
    "MountRyDeg": 0.0,
    "MountRzDeg": 0.0
  },
  "IoModule": {
    "Name": "IoModule",
    "IpAddress": "10.10.100.202",
    "Port": 502,
    "SlaveId": 20,
    "ReadTimeoutMs": 3000,
    "WriteTimeoutMs": 3000
  },
  "WeldTracking": {
    "ProfileDirectory": "RoiProfiles",
    "AutoLoadProfile": "default",
    "PitchCorrectionEnabled": true,
    "PitchCorrectionSign": -1,
    "IrHFovDeg": 90.0,
    "ColorHFovDeg": 69.0,
    "DefaultWorkDistanceMm": 500.0
  }
}
