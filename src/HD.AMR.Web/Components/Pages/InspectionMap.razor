@page "/inspection-map"
@rendermode InteractiveServer
@using HD.AMR.App.Data.Entities
@using HD.AMR.App.Service
@using HD.AMR.App.Service.Inspection
@using HD.AMR.App.Models
@inject InspectionRecipeService Service
@inject ILogger<InspectionMap> Logger

<PageTitle>검사 매핑 요약</PageTitle>

<h1>검사 매핑 요약</h1>
<p class="text-muted" style="max-width:1150px">
    ACS <code>startWeldInspection</code> 한 건이 실제로 실행되기까지 <b>두 축</b>이 합쳐집니다 —
    <b>어떻게(레시피)</b> 와 <b>어디를(경유점)</b>. 이 화면은 두 축의 연결 상태를 한눈에 보여줍니다.
    편집은 <a href="recipes">검사 레시피</a>(레시피)·티칭 화면(경유점)에서 합니다.
</p>

<div class="card mb-3" style="max-width:1150px">
    <div class="card-body py-2" style="font-size:.85rem">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <span class="badge bg-primary">액션</span>
            <span class="text-muted">→</span>
            <span class="badge bg-light text-dark border">① (seamType, wall_code)</span>
            <span class="text-muted">→ 레시피 선택(어떻게)</span>
            <span class="mx-2">＋</span>
            <span class="badge bg-light text-dark border">② 레시피에 지정된 티칭 프로필</span>
            <span class="text-muted">→ 경유점(어디를)</span>
            <span class="text-muted">→</span>
            <span class="badge bg-success">검사 실행</span>
        </div>
        <div class="mt-2 text-muted">
            레시피는 <b>17종</b>(seamType × 면 자세)이고, 경유점은 검사 포인트(X-Y)에서 저장한 프로필을 <b>레시피마다 지정</b>합니다(도면 무관).
            둘 중 하나라도 없으면(레시피 Disabled / 프로필 미지정) 액션은 <code>FAILED</code> 로 보고됩니다.
            <b>CORNER3</b> 는 도면 프로필 대신 고정 티칭 슬롯(<code>corner3.*</code>)을 순회하므로 도면 티칭이 필요 없습니다.
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <div class="alert alert-danger py-2" style="max-width:1150px">@_msg</div>
}

<div class="mb-2">
    <button class="btn btn-sm btn-outline-secondary" @onclick="Reload" disabled="@_busy">새로고침</button>
</div>

<!-- ① wall_code → 레시피 매핑 레퍼런스 -->
<h4 class="mt-3">① wall_code × seamType → 레시피 (§8.5.1)</h4>
<div class="table-responsive" style="max-width:1150px">
    <table class="table table-sm table-bordered align-middle" style="font-size:.82rem">
        <thead class="table-light">
            <tr>
                <th style="width:90px">wall_code</th>
                <th style="min-width:150px">면</th>
                <th>LINE</th>
                <th>CROSS3</th>
                <th>CROSS4</th>
                <th>CORNER2</th>
                <th>CORNER3</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var w in WallCodes.All)
            {
                <tr>
                    <td><code>@w.Code</code></td>
                    <td>@w.DisplayName</td>
                    <td>@RecipeCell(SeamTypeKind.Line, w.Code)</td>
                    <td>@RecipeCell(SeamTypeKind.Cross3, w.Code)</td>
                    <td>@RecipeCell(SeamTypeKind.Cross, w.Code)</td>
                    <td>@RecipeCell(SeamTypeKind.Corner2, w.Code)</td>
                    <td>@RecipeCell(SeamTypeKind.Corner, w.Code)</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<p class="text-muted" style="font-size:.8rem;max-width:1150px">
    <span class="badge bg-success">초록</span> 실행 활성(Enabled) ·
    <span class="badge bg-secondary">회색</span> 매핑되나 Disabled(→ FAILED+inspectionFailed) ·
    CORNER 의 L/R 은 옆면(P*=좌현/S*=우현) 기준 거울 판별.
</p>

<!-- ② 레시피 카탈로그 상태 -->
<h4 class="mt-4">② 레시피 카탈로그 상태 (17종)</h4>
<div class="table-responsive" style="max-width:1150px">
    <table class="table table-sm align-middle" style="font-size:.82rem">
        <thead class="table-light">
            <tr>
                <th style="min-width:130px">레시피 ID</th>
                <th>seamType</th>
                <th>면자세</th>
                <th class="text-center" style="width:90px">실행</th>
                <th>경유점 소스</th>
                <th>지정 티칭 프로필</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in _recipes)
            {
                <tr>
                    <td><code>@r.Id</code></td>
                    <td>@r.SeamType</td>
                    <td>@r.Orientation</td>
                    <td class="text-center">
                        @if (r.Enabled)
                        {
                            <span class="badge bg-success">Enabled</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Disabled</span>
                        }
                    </td>
                    <td class="text-muted">
                        @(r.SeamType switch
                        {
                            SeamTypeKind.Corner => "고정 티칭 슬롯 corner3.* (도면 무관)",
                            SeamTypeKind.Corner2 => "실행 스텝 미구현 (게이트 OFF) — corner2 슬롯/캡처 후속",
                            _ => "레시피 지정 X-Y 티칭 프로필 (/recipes 에서 지정)"
                        })
                    </td>
                    <td>
                        @if (r.SeamType == SeamTypeKind.Corner)
                        {
                            <span class="text-muted">—</span>
                        }
                        else if (r.InspectionProfileId is null)
                        {
                            <span class="badge bg-secondary">미지정</span>
                        }
                        else if (_teaching.FirstOrDefault(t => t.ProfileId == r.InspectionProfileId) is { } t)
                        {
                            <span class="badge @(t.WaypointCount >= 2 ? "bg-success" : "bg-warning text-dark")">@t.ProfileName (@(t.WaypointCount)점)</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">프로필 없음(id=@r.InspectionProfileId)</span>
                        }
                    </td>
                </tr>
            }
            @if (_recipes.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-muted py-3">레시피가 없습니다 — 앱 재기동 시 자동 시드됩니다.</td></tr>
            }
        </tbody>
    </table>
</div>

<!-- ③ 도면 티칭 현황 -->
<h4 class="mt-4">③ 티칭 프로필(경유점) 현황</h4>
<p class="text-muted" style="font-size:.8rem;max-width:1150px">
    검사 포인트(X-Y)에서 저장한 프로필 목록입니다. ACS 는 <a href="recipes">검사 레시피</a> 에 지정된 프로필만 사용합니다(<b>지정 레시피</b> 열).
    지정 레시피가 없는 프로필은 ACS 에서 쓰이지 않으며, 경유점 2점 미만이면 실행 시 <code>FAILED+inspectionFailed</code> 입니다.
</p>
<div class="table-responsive" style="max-width:1150px">
    <table class="table table-sm align-middle" style="font-size:.82rem">
        <thead class="table-light">
            <tr>
                <th style="min-width:150px">프로필</th>
                <th style="min-width:150px">지정 레시피</th>
                <th class="text-center" style="width:80px">타입</th>
                <th class="text-center" style="width:90px">경유점 수</th>
                <th style="width:160px">티칭 시각(UTC)</th>
                <th class="text-center" style="width:110px">상태</th>
                <th style="min-width:120px">연결 도면(구)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in _teaching)
            {
                <tr>
                    <td>@(d.ProfileName ?? "—")</td>
                    <td>@(UsedBy(d.ProfileId) is { Count: > 0 } used ? string.Join(", ", used) : "—")</td>
                    <td class="text-center">@(d.HasProfile ? (string.IsNullOrWhiteSpace(d.SeamType) ? "LINE" : d.SeamType) : "—")</td>
                    <td class="text-center">@d.WaypointCount</td>
                    <td class="text-muted">@(d.TaughtAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                    <td class="text-center">
                        @if (UsedBy(d.ProfileId).Count == 0)
                        {
                            <span class="badge bg-secondary">ACS 미사용</span>
                        }
                        else if (d.WaypointCount >= 2)
                        {
                            <span class="badge bg-success">사용 중</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">경유점 부족</span>
                        }
                    </td>
                    <td class="text-muted">@d.DrawingName</td>
                </tr>
            }
            @if (_teaching.Count == 0)
            {
                <tr><td colspan="7" class="text-center text-muted py-3">저장된 티칭 프로필이 없습니다 — 검사 포인트(X-Y) 페이지에서 교시 후 표시됩니다.</td></tr>
            }
        </tbody>
    </table>
</div>

@code {
    private List<InspectionRecipe> _recipes = new();
    private Dictionary<string, bool> _enabledById = new();
    private List<DrawingTeachingSummary> _teaching = new();
    private bool _busy;
    private string? _msg;

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
    {
        if (_busy) return;
        _busy = true;
        _msg = null;
        try
        {
            _recipes = await Service.ListAsync();
            _enabledById = _recipes.ToDictionary(r => r.Id, r => r.Enabled);
            _teaching = await Service.ListTeachingSummaryAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "검사 매핑 요약 로드 실패");
            _msg = $"로드 실패: {ex.Message}";
        }
        finally
        {
            _busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>이 프로필을 지정한 레시피 id 목록.</summary>
    private List<string> UsedBy(int profileId) =>
        _recipes.Where(r => r.InspectionProfileId == profileId).Select(r => r.Id).ToList();

    /// <summary>매핑 레퍼런스 셀 — 레시피 id + Enabled 배지. CORNER 는 거울 side 접미사 표기.</summary>
    private RenderFragment RecipeCell(SeamTypeKind seam, string wallCode) => builder =>
    {
        var recipeId = InspectionRecipeResolver.ResolveRecipeId(seam, wallCode);
        var enabled = recipeId is not null && _enabledById.TryGetValue(recipeId, out var e) && e;
        var label = recipeId ?? "—";
        if (seam is SeamTypeKind.Corner or SeamTypeKind.Corner2 && recipeId is not null)
            label += $" ({InspectionRecipeResolver.ResolveCornerSide(wallCode, out _)})";

        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"badge {(enabled ? "bg-success" : "bg-secondary")}");
        builder.AddContent(2, label);
        builder.CloseElement();
    };
}
