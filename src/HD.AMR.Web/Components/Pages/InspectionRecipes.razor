@page "/recipes"
@rendermode InteractiveServer
@using System.Text.Json
@using HD.AMR.App.Data.Entities
@using HD.AMR.App.Service
@using HD.AMR.App.Service.Inspection
@inject InspectionRecipeService Service
@inject ILogger<InspectionRecipes> Logger

<PageTitle>검사 레시피</PageTitle>

<h1>검사 레시피 관리</h1>
<p class="text-muted" style="max-width:1100px">
    ACS <code>startWeldInspection</code> 의 <code>(seamType, wall_code)</code> 조합으로 선택되는 검사 타입 11종
    (사양 §8.5.1, INSPECTION_TYPES.md §5)의 실행 구성입니다.
    <b>Enabled</b> 가 꺼진 레시피로 매핑된 액션은 FAILED + inspectionFailed 로 보고됩니다 —
    실기 E2E 검증 후에만 켜세요. 경유점(어디를)은 여기 없습니다 — 도면별 티칭(<code>InspectionProfile</code>) 소관이며,
    <a href="inspection-map">검사 매핑 요약</a> 에서 레시피↔티칭 연결을 확인하세요.
    행의 <b>고급</b> 을 펼치면 접근 자세 키·standoff·Surface 강제 등 세부 실행값을 편집할 수 있습니다.
</p>

@if (!string.IsNullOrEmpty(_msg))
{
    <div class="alert @(_isErr ? "alert-danger" : "alert-info") py-2" style="max-width:1300px">@_msg</div>
}

<div class="mb-2 d-flex gap-2 align-items-center" style="max-width:1300px">
    <button class="btn btn-sm btn-outline-secondary" @onclick="Reload" disabled="@_busy">새로고침</button>
    <span class="text-muted ms-auto">총 @_rows.Count 종</span>
</div>

<div class="table-responsive" style="max-width:1300px">
    <table class="table table-sm align-middle">
        <thead>
            <tr>
                <th style="width:34px"></th>
                <th style="min-width:130px">레시피 ID</th>
                <th style="min-width:180px">표시명</th>
                <th style="width:70px" class="text-center">Enabled</th>
                <th style="min-width:200px">StepKeysJson</th>
                <th style="min-width:200px">PatternJson</th>
                <th style="width:110px">비전 실패율 상한</th>
                <th style="width:190px"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in _rows)
            {
                <tr @key="row.Id">
                    <td class="text-center">
                        <button class="btn btn-sm btn-link p-0 text-decoration-none" title="고급 설정 펼치기/접기"
                                @onclick="() => ToggleExpand(row.Id)">
                            @(IsExpanded(row.Id) ? "▾" : "▸")
                        </button>
                    </td>
                    <td><code>@row.Id</code></td>
                    <td style="font-size:.85rem">@row.DisplayName</td>
                    <td class="text-center">
                        <input type="checkbox" class="form-check-input" @bind="row.Enabled" />
                    </td>
                    <td><input class="form-control form-control-sm font-monospace" style="font-size:.75rem"
                               placeholder="(null = 풀시퀀스)" @bind="row.StepKeysJson" /></td>
                    <td><input class="form-control form-control-sm font-monospace" style="font-size:.75rem"
                               placeholder="(CROSS4 만 사용)" @bind="row.PatternJson" /></td>
                    <td><input type="number" step="0.05" min="0" max="1"
                               class="form-control form-control-sm" @bind="row.VisionFailRatioMax" /></td>
                    <td style="white-space:nowrap">
                        <button class="btn btn-sm btn-primary" @onclick="() => Save(row)" disabled="@_busy">저장</button>
                        <button class="btn btn-sm btn-outline-warning" @onclick="() => ResetToDefault(row)"
                                disabled="@_busy" title="코드 기본값(시드)으로 되돌림 — 현장 조정값을 덮어씁니다">
                            기본값
                        </button>
                    </td>
                </tr>
                @if (IsExpanded(row.Id))
                {
                    <tr @key="@(row.Id + "-adv")" class="table-light">
                        <td></td>
                        <td colspan="7">
                            <div class="row g-3 py-2" style="font-size:.8rem">
                                <div class="col-auto">
                                    <label class="form-label mb-1 text-muted">접근 자세 티칭 키</label>
                                    <input class="form-control form-control-sm font-monospace" style="width:200px"
                                           placeholder="(빈 값 = 스텝 기본)" @bind="row.ApproachTeachingKey" />
                                    <div class="form-text">면 접근 코봇 자세(<code>TeachingPosition.Key</code>) 참조</div>
                                </div>
                                <div class="col-auto">
                                    <label class="form-label mb-1 text-muted">Standoff 폴백 [mm]</label>
                                    <input type="number" step="10" min="0" style="width:130px"
                                           class="form-control form-control-sm" @bind="row.DefaultStandoffMm" />
                                    <div class="form-text">action.standoffMm 부재/0 시</div>
                                </div>
                                <div class="col-auto">
                                    <label class="form-label mb-1 text-muted">카메라 목표거리 [mm]</label>
                                    <input type="number" step="10" min="0" style="width:150px"
                                           class="form-control form-control-sm" placeholder="(빈 값 = 전역 400)"
                                           @bind="row.CameraTargetDistanceMm" />
                                    <div class="form-text">action.workingDistanceMm 부재 시</div>
                                </div>
                                <div class="col-auto">
                                    <label class="form-label mb-1 text-muted">Surface 강제</label>
                                    <select class="form-select form-select-sm" style="width:160px"
                                            value="@SurfaceValue(row)"
                                            @onchange="e => SetSurface(row, e.Value?.ToString())">
                                        <option value="">자동(|θ| 판정)</option>
                                        <option value="0">0 · Flat</option>
                                        <option value="1">1 · Corner</option>
                                        <option value="2">2 · Corrugation</option>
                                    </select>
                                    <div class="form-text">경유점 촬영/조명 키 (부록 D.3)</div>
                                </div>
                                <div class="col-auto">
                                    <label class="form-label mb-1 text-muted">정렬 재시도</label>
                                    <input type="number" step="1" min="0" style="width:110px"
                                           class="form-control form-control-sm" @bind="row.AlignRetryCount" />
                                    <div class="form-text">정렬 스텝 실패 시 (0=없음)</div>
                                </div>
                                <div class="col-12 text-muted">
                                    seamType=<b>@row.SeamType</b>, 면자세=<b>@row.Orientation</b> ·
                                    세부값 편집 후 위 행의 <b>저장</b> 을 누르세요(같은 레시피).
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            }
            @if (_rows.Count == 0)
            {
                <tr><td colspan="8" class="text-center text-muted py-3">레시피가 없습니다 — 앱 재기동 시 자동 시드됩니다.</td></tr>
            }
        </tbody>
    </table>
</div>

@code {
    private List<InspectionRecipe> _rows = new();
    private readonly HashSet<string> _expanded = new();
    private bool _busy;
    private string? _msg;
    private bool _isErr;

    protected override async Task OnInitializedAsync() => await Reload();

    private bool IsExpanded(string id) => _expanded.Contains(id);

    private void ToggleExpand(string id)
    {
        if (!_expanded.Remove(id)) _expanded.Add(id);
    }

    private static string SurfaceValue(InspectionRecipe row) =>
        row.SurfaceOverride?.ToString() ?? "";

    /// <summary>Surface 강제 select → byte?(빈 값=자동). 0/1/2 외 값은 자동으로 정규화.</summary>
    private static void SetSurface(InspectionRecipe row, string? raw) =>
        row.SurfaceOverride = byte.TryParse(raw, out var b) && b <= 2 ? b : null;

    private async Task Reload()
    {
        try
        {
            _rows = await Service.ListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "레시피 목록 로드 실패");
            Notify($"목록 로드 실패: {ex.Message}", true);
        }
    }

    /// <summary>저장 전 JSON·수치 필드 형식 검증 — 잘못된 값이 DB 에 들어가 실행 시점(액션 FAILED)에야
    /// 드러나는 것을 막는다. 빈 문자열은 null 로 정규화.</summary>
    private static string? ValidateRow(InspectionRecipe row)
    {
        row.StepKeysJson = string.IsNullOrWhiteSpace(row.StepKeysJson) ? null : row.StepKeysJson.Trim();
        row.PatternJson = string.IsNullOrWhiteSpace(row.PatternJson) ? null : row.PatternJson.Trim();
        row.ApproachTeachingKey = row.ApproachTeachingKey?.Trim() ?? "";

        if (row.StepKeysJson is not null)
        {
            try
            {
                if (JsonSerializer.Deserialize<string[]>(row.StepKeysJson) is not { Length: > 0 })
                    return "StepKeysJson 은 비어 있지 않은 문자열 배열이어야 합니다.";
            }
            catch (JsonException ex) { return $"StepKeysJson 파싱 실패: {ex.Message}"; }
        }
        if (row.PatternJson is not null)
        {
            try
            {
                var p = JsonSerializer.Deserialize<CrossPatternParams>(row.PatternJson);
                if (p is null) return "PatternJson 이 null 로 역직렬화됩니다.";
                if (!CrossPatternGenerator.TryGenerate(p, out _, out var err)) return err;
            }
            catch (JsonException ex) { return $"PatternJson 파싱 실패: {ex.Message}"; }
        }
        if (row.VisionFailRatioMax is < 0 or > 1)
            return "비전 실패율 상한은 0~1 범위여야 합니다.";
        if (row.DefaultStandoffMm < 0)
            return "Standoff 폴백은 0 이상이어야 합니다.";
        if (row.CameraTargetDistanceMm is <= 0)
            return "카메라 목표거리는 0 보다 커야 합니다(빈 값 = 전역 기본).";
        if (row.SurfaceOverride is > 2)
            return "Surface 강제값은 0(Flat)/1(Corner)/2(Corrugation) 또는 자동(빈 값)만 허용합니다.";
        if (row.AlignRetryCount < 0)
            return "정렬 재시도 횟수는 0 이상이어야 합니다.";
        return null;
    }

    private async Task Save(InspectionRecipe row)
    {
        if (_busy) return;
        if (ValidateRow(row) is { } error)
        {
            Notify($"'{row.Id}' 저장 거부 — {error}", true);
            return;
        }
        _busy = true;
        try
        {
            await Service.SaveAsync(row);
            await Reload();
            Notify($"'{row.Id}' 저장 완료", false);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "레시피 저장 실패 (id={Id})", row.Id);
            Notify($"저장 실패: {ex.Message}", true);
        }
        finally
        {
            _busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ResetToDefault(InspectionRecipe row)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var ok = await Service.ResetToDefaultAsync(row.Id);
            await Reload();
            Notify(ok ? $"'{row.Id}' 기본값 재적용 완료 (Enabled 포함 시드값으로 복원)" : $"'{row.Id}' 는 카탈로그에 없는 레시피입니다.", !ok);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "레시피 기본값 재적용 실패 (id={Id})", row.Id);
            Notify($"기본값 재적용 실패: {ex.Message}", true);
        }
        finally
        {
            _busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void Notify(string msg, bool error)
    {
        _msg = msg;
        _isErr = error;
    }
}
