@page "/io"
@rendermode InteractiveServer
@using HD.AMR.App.Communication
@using HD.AMR.App.Service
@implements IDisposable
@inject IoModuleService Svc
@inject ILogger<IoModule> Logger

<PageTitle>IO Module</PageTitle>

<h1 class="page-title">IO Module</h1>
<p class="page-subtitle">LS산전 IO Module — 접점 모니터링 / 출력 제어</p>

<div class="card card-surface mb-3" style="max-width: 820px;">
    <div class="card-body">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <h5 class="card-title mb-0">통신 연결 (ModbusTCP)</h5>
            <span class="badge @(Svc.IsConnected ? "bg-success" : "bg-secondary")">
                @(Svc.IsConnected ? "연결됨" : "끊김")
            </span>
        </div>
        <div class="text-muted small">
            @Svc.Settings.Name — @Svc.Settings.IpAddress:@Svc.Settings.Port, SlaveId @Svc.Settings.SlaveId
            <span class="ms-1">(자동 연결 — 실패 시 5초마다 재시도)</span>
            <span class="ms-1">@($"· 입력 FC02@0x{Svc.Settings.InputStart:X4}, 출력 Holding@0x{Svc.Settings.OutputWriteAddress:X4}(FC16 쓰기/FC03 되읽기)")</span>
        </div>
        @if (!string.IsNullOrEmpty(Svc.AdapterLedSummary))
        {
            <div class="text-muted small mt-1">
                어댑터 LED: @Svc.AdapterLedSummary
                @if (Svc.AdapterLedSummary.Contains("RNS 적") || Svc.AdapterLedSummary.Contains("RMS 적"))
                {
                    <span class="badge bg-warning text-dark ms-1"
                          title="어댑터가 RAPIEnet 마스터 대기 상태 — Modbus 출력 쓰기가 무시됩니다. XG5000으로 접속해 드라이버 'RAPIEnet v2'를 Disable로 변경하세요(간편 사용설명서 §3 Step.3).">
                        RAPIEnet 대기 — 출력 잠김(Step.3 Disable 필요)
                    </span>
                }
            </div>
        }
        @if (_state is { } st)
        {
            <div class="text-muted small mt-1">마지막 상태 갱신: @AgeText(st.UpdatedUtc)</div>
        }
        @* 폴링 오류는 TCP 연결 여부와 무관하게 항상 표시 — "연결됨인데 값이 안 변함"을 침묵시키지 않는다. *@
        @if (!string.IsNullOrEmpty(Svc.LastError))
        {
            <div class="alert alert-warning mt-2 mb-0 py-2">
                통신 오류: @Svc.LastError
                @if (Svc.LastInputsOkUtc is { } inOk)
                {
                    <span class="ms-1 text-muted">(입력 마지막 성공 @AgeText(inOk))</span>
                }
            </div>
        }
    </div>
</div>

<div class="card card-surface mb-3" style="max-width: 820px;">
    <div class="card-body">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h5 class="card-title mb-0">입력 접점</h5>
            @if (Svc.InputChangesLastMinute > 0)
            {
                <span class="badge @(Svc.InputChangesLastMinute >= 5 ? "bg-warning text-dark" : "bg-light text-muted")"
                      title="정지 상태(입력 미조작)인데 이 값이 계속 올라가면 어댑터↔모듈 데이터 교환 불량(비트 시프트) — H/W 점검 대상">
                    입력 변화 @Svc.InputChangesLastMinute 회/분
                </span>
            }
        </div>
        @if (_state is not null)
        {
            <div class="d-flex flex-wrap gap-2">
                @for (var i = 0; i < _state.Inputs.Length; i++)
                {
                    var on = _state.Inputs[i];
                    var point = IoPointMap.Input(i);
                    <span class="badge @(on ? "bg-success" : point is null ? "bg-light text-muted" : "bg-secondary")"
                          style="min-width: 128px; padding: 0.5rem 0.4rem;"
                          title="@(point is null ? "미배선 접점" : point.Code)">
                        IN @i.ToString("00") · @IoPointMap.InputLabel(i)
                        <span class="d-block fw-normal">@(on ? "ON" : "OFF")</span>
                    </span>
                }
            </div>
            <div class="text-muted small mt-2">접점 이름: @IoPointMap.SourceNote</div>
        }
        else
        {
            <div class="text-muted small">상태 수신 대기 중…</div>
        }
    </div>
</div>

<div class="card card-surface mb-3" style="max-width: 820px;">
    <div class="card-body">
        <h5 class="card-title mb-3">출력 제어</h5>
        @if (_state is not null)
        {
            <div class="d-flex flex-column gap-2">
                @for (var i = 0; i < _state.Outputs.Length; i++)
                {
                    var idx = i;
                    var on = _state.Outputs[idx];
                    var point = IoPointMap.Output(idx);
                    <div class="d-flex align-items-center gap-3">
                        <span style="min-width: 64px; font-weight: 600;">OUT @idx.ToString("00")</span>
                        <span class="@(point is null ? "text-muted" : "")" style="min-width: 150px;"
                              title="@(point is null ? "미배선 접점" : point.Code)">
                            @IoPointMap.OutputLabel(idx)
                        </span>
                        <span class="badge @(on ? "bg-success" : "bg-secondary")" style="min-width: 56px;">
                            @(on ? "ON" : "OFF")
                        </span>
                        <div class="btn-group btn-group-sm" role="group" aria-label="@($"OUT {idx:00} 출력 테스트")">
                            <button type="button"
                                    class="btn @(on ? "btn-success" : "btn-outline-success")"
                                    disabled="@(_busy || !Svc.IsConnected || on)"
                                    @onclick="() => SetOutput(idx, true)">
                                @if (_busyOutputIndex == idx && _busyOutputValue)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                                }
                                ON
                            </button>
                            <button type="button"
                                    class="btn @(!on ? "btn-secondary" : "btn-outline-secondary")"
                                    disabled="@(_busy || !Svc.IsConnected || !on)"
                                    @onclick="() => SetOutput(idx, false)">
                                @if (_busyOutputIndex == idx && !_busyOutputValue)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                                }
                                OFF
                            </button>
                        </div>
                    </div>
                }
            </div>
            <div class="text-muted small mt-2">접점 이름: @IoPointMap.SourceNote</div>
        }
        else
        {
            <div class="text-muted small">상태 수신 대기 중…</div>
        }

        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="alert @(_isError ? "alert-danger" : "alert-success") mt-3 mb-0 py-2">
                @_message
            </div>
        }
    </div>
</div>

<details class="card card-surface" style="max-width: 820px;">
    <summary class="card-body" style="cursor: pointer; font-weight: 600;">고급 / 디버그 — 범용 Modbus 읽기·쓰기</summary>
    <div class="card-body pt-0">
        <h6 class="mb-3">읽기</h6>
        <div class="row g-2 align-items-end">
            <div class="col-sm-5">
                <label class="form-label mb-1">객체 종류</label>
                <select class="form-select" @bind="_readType" disabled="@_busy">
                    <option value="@ModbusObject.Coil">Coil (출력, FC01)</option>
                    <option value="@ModbusObject.DiscreteInput">Discrete Input (입력, FC02)</option>
                    <option value="@ModbusObject.HoldingRegister">Holding Register (FC03)</option>
                    <option value="@ModbusObject.InputRegister">Input Register (FC04)</option>
                </select>
            </div>
            <div class="col-sm-3">
                <label class="form-label mb-1">시작 주소</label>
                <input type="number" class="form-control" min="0" max="65535" @bind="_readStart" disabled="@_busy" />
            </div>
            <div class="col-sm-2">
                <label class="form-label mb-1">개수</label>
                <input type="number" class="form-control" min="1" max="125" @bind="_readCount" disabled="@_busy" />
            </div>
            <div class="col-sm-2">
                <button class="btn btn-primary w-100" @onclick="Read"
                        disabled="@(_busy || !Svc.IsConnected)">읽기</button>
            </div>
        </div>

        @if (_bitResults is not null)
        {
            <div class="d-flex flex-wrap gap-2 mt-3">
                @for (var i = 0; i < _bitResults.Length; i++)
                {
                    var addr = _readStart + i;
                    var on = _bitResults[i];
                    <span class="badge @(on ? "bg-success" : "bg-secondary")" style="min-width: 74px;">
                        @addr : @(on ? "ON" : "OFF")
                    </span>
                }
            </div>
        }
        else if (_regResults is not null)
        {
            <table class="table table-sm align-middle mt-3 mb-0" style="max-width: 380px;">
                <thead>
                    <tr>
                        <th style="width: 110px;">주소</th>
                        <th class="text-end">값 (dec)</th>
                        <th class="text-end">값 (hex)</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < _regResults.Length; i++)
                    {
                        <tr>
                            <td>@(_readStart + i)</td>
                            <td class="text-end">@_regResults[i]</td>
                            <td class="text-end text-muted">0x@_regResults[i].ToString("X4")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <h6 class="mt-4 mb-3">쓰기</h6>
        <div class="row g-2 align-items-end">
            <div class="col-sm-4">
                <label class="form-label mb-1">Coil 주소 (FC05)</label>
                <input type="number" class="form-control" min="0" max="65535" @bind="_coilAddr" disabled="@_busy" />
            </div>
            <div class="col-sm-8">
                <button class="btn btn-success me-2" @onclick="() => WriteCoil(true)"
                        disabled="@(_busy || !Svc.IsConnected)">Coil ON</button>
                <button class="btn btn-outline-secondary" @onclick="() => WriteCoil(false)"
                        disabled="@(_busy || !Svc.IsConnected)">Coil OFF</button>
            </div>
        </div>

        <div class="row g-2 align-items-end mt-2">
            <div class="col-sm-4">
                <label class="form-label mb-1">Register 주소 (FC06)</label>
                <input type="number" class="form-control" min="0" max="65535" @bind="_regAddr" disabled="@_busy" />
            </div>
            <div class="col-sm-4">
                <label class="form-label mb-1">값 (0~65535)</label>
                <input type="number" class="form-control" min="0" max="65535" @bind="_regValue" disabled="@_busy" />
            </div>
            <div class="col-sm-4">
                <button class="btn btn-primary" @onclick="WriteRegister"
                        disabled="@(_busy || !Svc.IsConnected)">Register 쓰기</button>
            </div>
        </div>
    </div>
</details>

@code {
    private enum ModbusObject { Coil, DiscreteInput, HoldingRegister, InputRegister }

    private IoModuleState? _state;

    private ModbusObject _readType = ModbusObject.DiscreteInput;
    private int _readStart;
    private int _readCount = 16;

    private bool[]? _bitResults;
    private ushort[]? _regResults;

    private int _coilAddr;
    private int _regAddr;
    private int _regValue;

    private bool _busy;
    private int? _busyOutputIndex;
    private bool _busyOutputValue;
    private bool _isError;
    private string? _message;

    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;

    protected override void OnInitialized()
    {
        _state = Svc.GetState();
        _cts = new CancellationTokenSource();
        _ = RefreshLoopAsync(_cts.Token);
    }

    // 서비스가 캐싱한 입출력 스냅샷을 주기적으로 당겨 화면 갱신.
    private async Task RefreshLoopAsync(CancellationToken ct)
    {
        _timer = new PeriodicTimer(TimeSpan.FromMilliseconds(300));
        try
        {
            while (await _timer.WaitForNextTickAsync(ct))
            {
                _state = Svc.GetState();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // 페이지 폐기 — 정상 종료.
        }
    }

    // 상대 시각 표시("n초 전") — 상태 신선도를 사람이 바로 읽게.
    private static string AgeText(DateTime utc)
    {
        var age = DateTime.UtcNow - utc;
        return age.TotalSeconds < 2 ? "방금" :
               age.TotalSeconds < 60 ? $"{age.TotalSeconds:0}초 전" :
               age.TotalMinutes < 60 ? $"{age.TotalMinutes:0}분 전" : $"{age.TotalHours:0.#}시간 전";
    }

    private async Task SetOutput(int index, bool value)
    {
        if (_busy) return;
        _busy = true;
        _busyOutputIndex = index;
        _busyOutputValue = value;
        _message = null;
        var name = IoPointMap.OutputLabel(index);
        try
        {
            var confirmed = await Svc.WriteOutputAsync(index, value);
            _state = Svc.GetState();
            _isError = !confirmed;
            _message = confirmed
                ? $"OUT {index:00} {name} ← {(value ? "ON" : "OFF")} 설정 성공 (되읽기 반영 확인)."
                : $"OUT {index:00} {name} ← {(value ? "ON" : "OFF")} 쓰기는 수락됐지만 반영되지 않았습니다 — " +
                  "어댑터가 RAPIEnet 대기 상태로 추정: XG5000으로 접속해 드라이버 'RAPIEnet v2' → Disable 설정 필요(간편 사용설명서 §3 Step.3).";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "IO Module 출력 쓰기 실패 (OUT {Index})", index);
            _isError = true;
            _message = $"OUT {index:00} {name} 설정 실패: {ex.Message}";
        }
        finally
        {
            _busy = false;
            _busyOutputIndex = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task Read()
    {
        if (_busy) return;
        _busy = true;
        _message = null;
        _bitResults = null;
        _regResults = null;
        var start = (ushort)Math.Clamp(_readStart, 0, 65535);
        var count = (ushort)Math.Clamp(_readCount, 1, 125);
        try
        {
            switch (_readType)
            {
                case ModbusObject.Coil:
                    _bitResults = await Svc.ReadCoilsAsync(start, count);
                    break;
                case ModbusObject.DiscreteInput:
                    _bitResults = await Svc.ReadDiscreteInputsAsync(start, count);
                    break;
                case ModbusObject.HoldingRegister:
                    _regResults = await Svc.ReadHoldingRegistersAsync(start, count);
                    break;
                case ModbusObject.InputRegister:
                    _regResults = await Svc.ReadInputRegistersAsync(start, count);
                    break;
            }
            _isError = false;
            _message = $"{_readType} {start}~{start + count - 1} 읽기 성공.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "IO Module 읽기 실패");
            _isError = true;
            _message = $"읽기 실패: {ex.Message}";
        }
        finally
        {
            _busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task WriteCoil(bool value)
    {
        if (_busy) return;
        _busy = true;
        _message = null;
        var addr = (ushort)Math.Clamp(_coilAddr, 0, 65535);
        try
        {
            await Svc.WriteSingleCoilAsync(addr, value);
            _isError = false;
            _message = $"Coil {addr} ← {(value ? "ON" : "OFF")} 쓰기 성공.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "IO Module Coil 쓰기 실패");
            _isError = true;
            _message = $"Coil 쓰기 실패: {ex.Message}";
        }
        finally
        {
            _busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task WriteRegister()
    {
        if (_busy) return;
        _busy = true;
        _message = null;
        var addr = (ushort)Math.Clamp(_regAddr, 0, 65535);
        var val = (ushort)Math.Clamp(_regValue, 0, 65535);
        try
        {
            await Svc.WriteSingleRegisterAsync(addr, val);
            _isError = false;
            _message = $"Register {addr} ← {val} (0x{val:X4}) 쓰기 성공.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "IO Module Register 쓰기 실패");
            _isError = true;
            _message = $"Register 쓰기 실패: {ex.Message}";
        }
        finally
        {
            _busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _timer?.Dispose();
        _cts?.Dispose();
    }
}
