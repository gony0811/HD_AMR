@page "/teaching"
@rendermode InteractiveServer
@using HD.AMR.App.Communication
@using HD.AMR.App.Data.Entities
@using HD.AMR.App.Service
@inject TeachingService Service
@inject CobotService Cobot
@inject ILogger<Teaching> Logger
@implements IDisposable

<PageTitle>Teaching</PageTitle>

<h1 class="page-title">Teaching</h1>

<section class="capture-panel">
    <strong>티칭 위치 (BASE 좌표계 기준)</strong>
    @if (!Cobot.IsConnected)
    {
        <div class="hint">⚠ 코봇 RPC 미연결 — 현재 위치 저장/이동 불가.</div>
    }
    <div class="mt-1">
        @if (Cobot.State?.User is int activeUser and >= 0)
        {
            @if (activeUser == 0)
            {
                <span class="badge bg-success" title="상태 패킷(20004)에서 읽은 컨트롤러 현재 활성 작업물 좌표계">
                    활성 작업물: #0 (베이스)
                </span>
            }
            else
            {
                <span class="badge bg-warning text-dark" title="상태 패킷(20004)에서 읽은 컨트롤러 현재 활성 작업물 좌표계 — 베이스가 아니면 티칭 이동이 오작동할 수 있습니다">
                    활성 작업물: #@activeUser (베이스 아님)
                </span>
                <button class="btn btn-sm btn-outline-secondary ms-1" @onclick="ResetToBaseFrameAsync"
                        disabled="@(_isBusy || !Cobot.IsConnected)"
                        title="현재 관절 위치로 무변위 MoveJ를 보내 활성 좌표계를 베이스(user=0)로 전환합니다 (실제 이동 없음)">
                    베이스(0)로 전환
                </button>
            }
        }
        else
        {
            <span class="badge bg-secondary" title="상태 스트림(20004) 미수신 — 활성 작업물 좌표계를 알 수 없습니다">
                활성 작업물: 미상
            </span>
        }
    </div>
    <div class="row g-2 align-items-end mt-1">
        <div class="col-auto">
            <label class="form-label">공구(tool)</label>
            <input class="form-control" type="number" min="0" max="15" style="width:90px"
                   @bind="_runTool" disabled="@_isBusy" />
        </div>
        <div class="col-auto">
            <label class="form-label">작업물(user, 0=베이스)</label>
            <input class="form-control" type="number" min="0" max="14" style="width:150px"
                   @bind="_capUser" disabled="@_isBusy" />
        </div>
        <div class="col-auto">
            <label class="form-label">속도(%)</label>
            <input class="form-control" type="number" min="1" max="100" style="width:90px"
                   @bind="_vel" disabled="@_isBusy" />
        </div>
        <div class="col-auto">
            <button class="btn btn-danger @(_isBusy ? "btn-lg fw-bold" : "")"
                    @onclick="StopAsync" disabled="@(!_isBusy)">
                ■ 정지 (즉시 멈춤)
            </button>
        </div>
    </div>
    @if (!string.IsNullOrEmpty(_msg))
    {
        <div class="status-message @(_isErr ? "err" : "ok")">@_msg</div>
    }
</section>

<section class="list-section">
    @if (_positions is null)
    {
        <p><em>Loading...</em></p>
    }
    else if (_positions.Count == 0)
    {
        <p>등록된 티칭 위치가 없습니다.</p>
    }
    else
    {
        <table class="segment-table">
            <thead>
                <tr>
                    <th>이름</th>
                    <th title="0x00=홈/회피 등 디폴트, 0x01~0xFF=검사 위치(촬영 시 보고 id)">Wall ID</th>
                    <th>X</th>
                    <th>Y</th>
                    <th>Z</th>
                    <th>RX</th>
                    <th>RY</th>
                    <th>RZ</th>
                    <th>J1</th>
                    <th>J2</th>
                    <th>J3</th>
                    <th>J4</th>
                    <th>J5</th>
                    <th>J6</th>
                    <th>Operate</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in _positions)
                {
                    <tr class="@(p.Id == _busyId ? "selected" : "")">
                        <td>
                            @if (TeachingService.IsSeedSlot(p.Key))
                            {
                                @p.Name
                            }
                            else if (p.Id == _editId)
                            {
                                <input class="form-control form-control-sm d-inline-block" style="width:150px"
                                       @bind="_editName" disabled="@_isBusy" />
                            }
                            else
                            {
                                <input class="form-control form-control-sm d-inline-block bg-body-secondary"
                                       style="width:150px" value="@p.Name" readonly />
                            }
                            @if (p.UserFrame is int n && n > 0)
                            {
                                <span class="badge bg-info ms-1" title="작업물 좌표계 기준(추종)">작업물 #@n</span>
                            }
                        </td>
                        <td>
                            @if (TeachingService.IsSeedSlot(p.Key))
                            {
                                <span class="text-muted" title="디폴트 위치 — Wall ID 고정">0x00</span>
                            }
                            else if (p.Id == _editId)
                            {
                                <input class="form-control form-control-sm d-inline-block" style="width:70px"
                                       type="number" min="0" max="255" @bind="_editSurfaceId" disabled="@_isBusy" />
                                <span class="text-muted small ms-1">0x@(Math.Clamp(_editSurfaceId, 0, 255).ToString("X2"))</span>
                            }
                            else
                            {
                                <input class="form-control form-control-sm d-inline-block bg-body-secondary"
                                       style="width:70px" value="@p.SurfaceId" readonly />
                                <span class="text-muted small ms-1">0x@(p.SurfaceId.ToString("X2"))</span>
                            }
                        </td>
                        <td class="num">@Fmt(p.X)</td>
                        <td class="num">@Fmt(p.Y)</td>
                        <td class="num">@Fmt(p.Z)</td>
                        <td class="num">@Fmt(p.Rx)</td>
                        <td class="num">@Fmt(p.Ry)</td>
                        <td class="num">@Fmt(p.Rz)</td>
                        <td class="num">@Fmt(p.J1)</td>
                        <td class="num">@Fmt(p.J2)</td>
                        <td class="num">@Fmt(p.J3)</td>
                        <td class="num">@Fmt(p.J4)</td>
                        <td class="num">@Fmt(p.J5)</td>
                        <td class="num">@Fmt(p.J6)</td>
                        @* 동일 크기 아이콘 버튼(.icon-btn) — 설명은 title 호버 캡션으로 제공. *@
                        <td class="ops">
                            @if (!TeachingService.IsSeedSlot(p.Key))
                            {
                                @if (p.Id == _editId)
                                {
                                    <button class="btn btn-sm btn-primary icon-btn" title="변경 저장"
                                            @onclick="SaveEditAsync" disabled="@_isBusy">@Icon(IconCheck)</button>
                                    <button class="btn btn-sm btn-outline-secondary icon-btn" title="변경 취소"
                                            @onclick="CancelEdit" disabled="@_isBusy">@Icon(IconX)</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-secondary icon-btn" title="이름/Wall ID 수정"
                                            @onclick="() => BeginEdit(p)" disabled="@_isBusy">@Icon(IconPencil)</button>
                                }
                            }
                            <button class="btn btn-sm btn-outline-primary icon-btn" title="현재 로봇 위치를 이 항목에 저장"
                                    @onclick="() => CaptureAsync(p.Id)"
                                    disabled="@(!Cobot.IsConnected || _isBusy || p.Id == _editId)">@Icon(IconDownload)</button>
                            <button class="btn btn-sm btn-outline-success icon-btn" title="저장된 위치로 이동 (MoveL)"
                                    @onclick="() => MoveToAsync(p)"
                                    disabled="@(!Cobot.IsConnected || _isBusy || !p.IsTaught || p.Id == _editId)">@Icon(IconPlay)</button>
                            <button class="btn btn-sm btn-outline-danger icon-btn" title="저장된 좌표 초기화"
                                    @onclick="() => ClearAsync(p.Id)"
                                    disabled="@(_isBusy || !p.IsTaught || p.Id == _editId)">@Icon(IconReset)</button>
                            @if (!TeachingService.IsSeedSlot(p.Key))
                            {
                                <button class="btn btn-sm btn-danger icon-btn" title="이 항목을 목록에서 삭제(좌표 포함)"
                                        @onclick="() => DeleteAsync(p.Id)"
                                        disabled="@(_isBusy || p.Id == _editId)">@Icon(IconTrash)</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @* 사용자 정의 위치 추가 — Key 자동 생성, 좌표는 "현재 위치 저장"으로 채운다.
       Surface ID: 0x00=홈/회피 등 디폴트, 0x01~0xFF=검사 위치(시퀀스 ② 목표 + 촬영 보고 id). *@
    <div class="row g-2 align-items-end mt-2">
        <div class="col-auto">
            <label class="form-label">새 항목 이름</label>
            <input class="form-control" style="width:200px" @bind="_newName" disabled="@_isBusy" />
        </div>
        <div class="col-auto">
            <label class="form-label">Wall ID (0~255)</label>
            <input class="form-control" type="number" min="0" max="255" style="width:110px"
                   @bind="_newSurfaceId" disabled="@_isBusy" />
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="AddAsync" disabled="@_isBusy">항목 추가</button>
        </div>
        <div class="col-auto text-muted small align-self-center">
            0x00 = 홈/회피 등 디폴트 · 0x01~0xFF = 검사 위치(촬영 시 보고 Wall ID)
        </div>
    </div>
</section>

@code {
    private List<TeachingPosition>? _positions;
    private int _runTool = 1;
    private int _capUser;   // 캡처 시 작업물 좌표계 번호(0=베이스). N>0이면 그 프레임 기준 상대 pose로 저장.
    private int _vel = 20;
    private bool _isBusy;
    private int _busyId = -1;
    private string? _msg;
    private bool _isErr;
    private CancellationTokenSource? _moveCts;
    private readonly CancellationTokenSource _pollCts = new();

    protected override async Task OnInitializedAsync()
    {
        _positions = await Service.ListAsync();
        _ = PollLoop(_pollCts.Token);
    }

    // 활성 작업물 배지가 상태 스트림(20004) 값을 따라가도록 1초 주기로 리렌더.
    private async Task PollLoop(CancellationToken ct)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (await timer.WaitForNextTickAsync(ct))
                await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
    }

    // 아이콘 버튼용 인라인 SVG (Bootstrap Icons 경로, currentColor 상속 — 아이콘 폰트/CDN 미사용).
    private static MarkupString Icon(string paths) => new(
        $"<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" fill=\"currentColor\" viewBox=\"0 0 16 16\" aria-hidden=\"true\">{paths}</svg>");

    private const string IconPencil =   // pencil-square
        "<path d='M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z'/>" +
        "<path fill-rule='evenodd' d='M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z'/>";

    private const string IconCheck =    // check-lg
        "<path d='M12.736 3.97a.733.733 0 0 1 1.047 0c.286.289.29.756.01 1.05L7.88 12.01a.733.733 0 0 1-1.065.02L3.217 8.384a.757.757 0 0 1 0-1.06.733.733 0 0 1 1.047 0l3.052 3.093 5.4-6.425z'/>";

    private const string IconX =        // x-lg
        "<path d='M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8z'/>";

    private const string IconDownload = // download (현재 위치 캡처)
        "<path d='M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5'/>" +
        "<path d='M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708z'/>";

    private const string IconPlay =     // play-fill (이동)
        "<path d='m11.596 8.697-6.363 3.692c-.54.313-1.233-.066-1.233-.697V4.308c0-.63.692-1.01 1.233-.696l6.363 3.692a.802.802 0 0 1 0 1.393'/>";

    private const string IconReset =    // arrow-counterclockwise (초기화)
        "<path fill-rule='evenodd' d='M8 3a5 5 0 1 1-4.546 2.914.5.5 0 0 0-.908-.417A6 6 0 1 0 8 2z'/>" +
        "<path d='M8 4.466V.534a.25.25 0 0 0-.41-.192L5.23 2.308a.25.25 0 0 0 0 .384l2.36 1.966A.25.25 0 0 0 8 4.466'/>";

    private const string IconTrash =    // trash (행 삭제)
        "<path d='M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z'/>" +
        "<path d='M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z'/>";

    private static string Fmt(double? v) => v.HasValue ? v.Value.ToString("0.###") : "-";

    private async Task ReloadAsync() => _positions = await Service.ListAsync();

    private async Task CaptureAsync(int id)
    {
        if (!Cobot.IsConnected) return;
        _isBusy = true;
        _busyId = id;
        _msg = null;
        try
        {
            var pose = await Cobot.Rpc.GetTcpPoseInBaseAsync(_runTool);
            var joints = await Cobot.Rpc.GetActualJointPosAsync();

            if (_capUser > 0)
            {
                // 작업물 좌표계 N 기준으로 고정: 현재 프레임 T_N을 읽어 상대 pose로 변환해 저장.
                // 이후 프레임 N을 재등록하면 이동 목표가 따라간다.
                var tN = await Cobot.Rpc.GetWObjCoordAsync(_capUser);
                var relPose = FrameMath.ToFrame(pose, tN);
                await Service.SaveCaptureAsync(id, pose, joints, _runTool, _capUser, relPose);
                _msg = $"현재 위치를 작업물 #{_capUser} 좌표계 기준으로 저장했습니다.";
            }
            else
            {
                await Service.SaveCaptureAsync(id, pose, joints, _runTool);
                _msg = "현재 위치를 베이스 기준으로 저장했습니다.";
            }
            await ReloadAsync();
            _isErr = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Teaching capture failed (id={Id})", id);
            _isErr = true;
            _msg = $"저장 실패: {ex.Message}";
        }
        finally
        {
            _isBusy = false;
            _busyId = -1;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task MoveToAsync(TeachingPosition p)
    {
        if (!Cobot.IsConnected || !p.IsTaught) return;
        _isBusy = true;
        _busyId = p.Id;
        _msg = null;
        _moveCts = new CancellationTokenSource();
        try
        {
            double[] target;
            if (p.UserFrame is int n && n > 0 && p.RelX.HasValue)
            {
                // 작업물 추종: 현재(재등록된) 프레임 T_N에 상대 pose를 적용해 베이스 목표 계산.
                var tN = await Cobot.Rpc.GetWObjCoordAsync(n, _moveCts.Token);
                var rel = new[] { p.RelX!.Value, p.RelY!.Value, p.RelZ!.Value, p.RelRx!.Value, p.RelRy!.Value, p.RelRz!.Value };
                target = FrameMath.FromFrame(rel, tN);
            }
            else
            {
                target = new[] { p.X!.Value, p.Y!.Value, p.Z!.Value, p.Rx!.Value, p.Ry!.Value, p.Rz!.Value };
            }
            var rc = await Cobot.Rpc.MoveLAsync(target, tool: _runTool, user: 0, vel: _vel, ct: _moveCts.Token);
            _isErr = rc != 0;
            _msg = rc == 0 ? $"'{p.Name}' 위치로 이동 완료." : $"이동 실패 (rc={rc}).";
        }
        catch (OperationCanceledException)
        {
            _isErr = true;
            _msg = "사용자 정지";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Teaching move failed (id={Id})", p.Id);
            _isErr = true;
            _msg = $"이동 실패: {ex.Message}";
        }
        finally
        {
            _moveCts?.Dispose();
            _moveCts = null;
            _isBusy = false;
            _busyId = -1;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ResetToBaseFrameAsync()
    {
        if (!Cobot.IsConnected) return;
        _isBusy = true;
        _msg = null;
        try
        {
            var rc = await Cobot.Rpc.ResetActiveFrameAsync(_runTool, 0);
            _isErr = rc != 0;
            _msg = rc == 0 ? "활성 좌표계를 베이스(0)로 전환했습니다." : $"활성 좌표계 전환 실패 (rc={rc}).";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Teaching reset active frame failed");
            _isErr = true;
            _msg = $"활성 좌표계 전환 실패: {ex.Message}";
        }
        finally
        {
            _isBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task StopAsync()
    {
        _moveCts?.Cancel();
        try
        {
            await Cobot.StopMotionImmediateAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Teaching stop failed");
        }
    }

    private string _newName = "";
    private int _newSurfaceId;

    private async Task AddAsync()
    {
        if (_isBusy) return;
        try
        {
            var row = await Service.AddAsync(_newName, _newSurfaceId);
            _newName = "";
            _newSurfaceId = 0;
            await ReloadAsync();
            _isErr = false;
            _msg = $"'{row.Name}' 항목을 추가했습니다 (Wall 0x{row.SurfaceId:X2}). '현재 위치 저장'으로 좌표를 채우세요.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Teaching add failed");
            _isErr = true;
            _msg = $"항목 추가 실패: {ex.Message}";
        }
    }

    private async Task DeleteAsync(int id)
    {
        if (_isBusy) return;
        try
        {
            var ok = await Service.DeleteAsync(id);
            await ReloadAsync();
            _isErr = !ok;
            _msg = ok ? "항목을 삭제했습니다." : "기본 슬롯은 삭제할 수 없습니다.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Teaching delete failed (id={Id})", id);
            _isErr = true;
            _msg = $"삭제 실패: {ex.Message}";
        }
    }

    // 이름/Surface ID는 수정 버튼으로만 편집(실수 방지) — 수정 → 버퍼 편집 → 저장/취소.
    private int _editId = -1;
    private string _editName = "";
    private int _editSurfaceId;

    private void BeginEdit(TeachingPosition p)
    {
        _editId = p.Id;
        _editName = p.Name;
        _editSurfaceId = p.SurfaceId;
    }

    private void CancelEdit() => _editId = -1;

    private async Task SaveEditAsync()
    {
        if (_editId < 0) return;
        try
        {
            await Service.UpdateInfoAsync(_editId, _editName, _editSurfaceId);
            await ReloadAsync();
            _isErr = false;
            _msg = $"'{_editName}' 항목을 저장했습니다 (Wall 0x{Math.Clamp(_editSurfaceId, 0, 255):X2}).";
            _editId = -1;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Teaching update failed (id={Id})", _editId);
            _isErr = true;
            _msg = $"수정 실패: {ex.Message}";
        }
    }

    private async Task ClearAsync(int id)
    {
        if (_isBusy) return;
        try
        {
            await Service.ClearAsync(id);
            await ReloadAsync();
            _isErr = false;
            _msg = "저장된 좌표를 초기화했습니다.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Teaching clear failed (id={Id})", id);
            _isErr = true;
            _msg = $"초기화 실패: {ex.Message}";
        }
    }

    public void Dispose()
    {
        _pollCts.Cancel();
        _pollCts.Dispose();
        _moveCts?.Dispose();
    }
}
