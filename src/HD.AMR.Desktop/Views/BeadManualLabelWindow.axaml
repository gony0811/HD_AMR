<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:HD.AMR.Desktop.Views"
        x:Class="HD.AMR.Desktop.Views.BeadManualLabelWindow"
        Width="1100" Height="840" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Title="수동 비드 입력"
        Background="{DynamicResource AppWindowBrush}">
    <Window.Styles>
        <Style Selector="TextBlock.cap"><Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" /><Setter Property="FontSize" Value="12" /></Style>
    </Window.Styles>
    <DockPanel Margin="16">
        <!-- 머리말: 단계 · 사유 · 남은 시간 -->
        <Border DockPanel.Dock="Top" Classes="card" Padding="12" Margin="0,0,0,10">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                    <TextBlock Name="HeaderText" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Name="ReasonText" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="1" Name="CountdownText" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 하단: 측정 미리보기 · 테스트 결과 + 결정 버튼 -->
        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">
            <TextBlock Name="PreviewText" Classes="cap" TextWrapping="Wrap" />
            <TextBlock Name="ResultText" TextWrapping="Wrap" FontWeight="SemiBold" IsVisible="False" />
            <Grid ColumnDefinitions="*,Auto">
                <CheckBox Name="SaveCheck" Content="확정 시 학습 데이터로 저장" IsVisible="False" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Name="RejectBtn" Content="✖ 실패 처리" Classes="danger" />
                    <Button Name="UseAutoBtn" Content="자동 결과로 진행 (저장 안 함)" />
                    <Button Name="ConfirmBtn" Content="✔ 이 선으로 진행 + 학습 데이터 저장" Classes="accent" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- 도구줄 -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <WrapPanel.Styles>
                <Style Selector="WrapPanel > :is(Control)"><Setter Property="Margin" Value="0,0,8,4" /></Style>
            </WrapPanel.Styles>
            <RadioButton Name="IrRadio" GroupName="mod" Content="IR" VerticalAlignment="Center" />
            <RadioButton Name="RgbRadio" GroupName="mod" Content="RGB" VerticalAlignment="Center" />
            <Button Name="ClearBtn" Content="선 지우기" />
            <Button Name="LoadAutoBtn" Content="자동 검출 선 불러오기" />
            <ComboBox Name="AxisCombo" Width="130" IsVisible="False" ToolTip.Tip="비드 진행 방향 — Peak 선은 이 축에 수직으로 그어진다">
                <ComboBoxItem>진행축 가로</ComboBoxItem>
                <ComboBoxItem>진행축 세로</ComboBoxItem>
            </ComboBox>
            <Button Name="LiveBtn" Content="⏸ 라이브 정지" IsVisible="False" />
            <Button Name="OpenFileBtn" Content="📂 저장된 사진 열기" IsVisible="False" />
            <TextBlock Name="SourceText" Classes="cap" VerticalAlignment="Center" />
        </WrapPanel>
        <TextBlock DockPanel.Dock="Top" Classes="cap" TextWrapping="Wrap" Margin="0,0,0,6"
                   Text="영상에서 보이는 비드 양 끝을 클릭하세요(2점 이상 · 점 드래그로 이동 · 우클릭 = 마지막 점 삭제). 자홍 = Peak(측정 위치) · 회색 점선 = FOV 기준선 · 노랑 = Bead ROI · 청록 = Peak ROI · 하늘색 점선 = 자동 검출 선." />

        <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Background="Black">
            <views:MaskCanvas Name="BeadCanvas" Cursor="Cross" />
        </Border>
    </DockPanel>
</Window>
