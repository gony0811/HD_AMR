<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HD.AMR.Desktop.ViewModels"
             x:Class="HD.AMR.Desktop.Views.CameraView"
             x:DataType="vm:CameraViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.axis"><Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" /><Setter Property="FontSize" Value="12" /></Style>
        <Style Selector="Image.stream"><Setter Property="Stretch" Value="Fill" /></Style>
        <Style Selector="Border.badge.busy"><Setter Property="Background" Value="{DynamicResource AppWarnBgBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AppWarnBorderBrush}" /></Style>
        <Style Selector="Border.badge.busy > TextBlock"><Setter Property="Foreground" Value="{DynamicResource AppWarnFgBrush}" /></Style>
        <Style Selector="Border.badge.bad"><Setter Property="BorderBrush" Value="{DynamicResource AppErrorBrush}" /></Style>
        <Style Selector="Border.badge.bad > TextBlock"><Setter Property="Foreground" Value="{DynamicResource AppErrorBrush}" /></Style>
        <Style Selector="TextBlock.flatval"><Setter Property="FontSize" Value="13" /><Setter Property="Margin" Value="0,0,0,6" /></Style>
        <Style Selector="Border.legend"><Setter Property="Width" Value="10" /><Setter Property="Height" Value="10" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
        <Style Selector="Border.streambox"><Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="4" /><Setter Property="Background" Value="Black" /><Setter Property="Height" Value="240" /></Style>
    </UserControl.Styles>

    <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
        <TextBlock Classes="page-title" Text="RealSense D435 깊이 카메라" />

        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Border Classes="badge" Classes.on="{Binding IsConnected}" Classes.off="{Binding !IsConnected}">
                <TextBlock Text="{Binding IsConnected, Converter={x:Static vm:BoolTextConverters.Connection}, StringFormat='연결 {0}'}" />
            </Border>
            <Border Classes="badge" Classes.on="{Binding IsStreaming}" Classes.off="{Binding !IsStreaming}">
                <TextBlock Text="{Binding IsStreaming, Converter={x:Static vm:BoolTextConverters.Stream}, StringFormat='스트림 {0}'}" />
            </Border>
            <TextBlock Classes="axis" VerticalAlignment="Center" Text="{Binding SettingsSummary}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
            <Button Content="시작" Classes="accent" Command="{Binding StartStreamCommand}" IsEnabled="{Binding !IsStreaming}" />
            <Button Content="정지" Classes="danger" Command="{Binding StopStreamCommand}" IsEnabled="{Binding IsStreaming}" />
            <Button Name="JogPopupBtn" Content="코봇 조그 (팝업)" />
        </StackPanel>

        <!-- 캡처 -->
        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Text="학습 데이터 캡처 (RGB·IR·Depth · PNG 무손실)" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Text="저장 폴더" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Grid.Column="1" Text="{Binding CaptureDir}" IsReadOnly="True" Watermark="폴더 선택… 버튼으로 지정" />
                    <Button Grid.Column="2" Name="BrowseButton" Margin="8,0,0,0" Content="📁 폴더 선택…" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="📷 캡처" Classes="accent" Command="{Binding CaptureCommand}" IsEnabled="{Binding IsStreaming}" />
                    <TextBlock Classes="axis" VerticalAlignment="Center" Text="{Binding CaptureCount, StringFormat='세션 누적 {0}회'}" />
                    <TextBlock Classes="axis" VerticalAlignment="Center" Text="{Binding LastCaptureInfo}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Classes="alert" IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        </Border>

        <!-- 영상 -->
        <Grid ColumnDefinitions="*,*,*" Margin="0,4,0,0">
            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                <TextBlock Classes="axis" Text="RGB" />
                <Border Classes="streambox"><Image Classes="stream" Source="{Binding ColorImage}" /></Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,6,0">
                <TextBlock Classes="axis" Text="IR" />
                <Border Classes="streambox"><Image Classes="stream" Source="{Binding IrImage}" /></Border>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Classes="axis" Text="Depth (hover=거리, 드래그=ROI)" />
                <Border Classes="streambox">
                    <Grid Name="DepthHost" Background="Transparent">
                        <Image Classes="stream" Source="{Binding DepthImage}" />
                        <Canvas Name="DepthOverlay" Background="Transparent">
                            <Rectangle Name="RoiRect" Stroke="#FFD000" StrokeThickness="2" IsVisible="False" />                            <Border Name="ProbeLabel" Background="#CC000000" CornerRadius="3" Padding="4,2" IsVisible="False">
                                <TextBlock Text="{Binding ProbeText}" Foreground="White" FontSize="11" />
                            </Border>
                        </Canvas>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <!-- 깊이 ROI -->
        <Border Classes="card" Margin="0,10,0,0" MaxWidth="640" HorizontalAlignment="Left">
            <StackPanel Spacing="8">
                <TextBlock Text="깊이 ROI (평탄면 통계)" FontWeight="SemiBold" />
                <CheckBox Content="ROI 사용(관심영역만 계산)" IsChecked="{Binding RoiEnabled}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <StackPanel><TextBlock Classes="axis" Text="X %" /><NumericUpDown Value="{Binding RoiXPct}" Minimum="0" Maximum="100" Increment="0.5" FormatString="0.0" /></StackPanel>
                    <StackPanel><TextBlock Classes="axis" Text="Y %" /><NumericUpDown Value="{Binding RoiYPct}" Minimum="0" Maximum="100" Increment="0.5" FormatString="0.0" /></StackPanel>
                    <StackPanel><TextBlock Classes="axis" Text="너비 %" /><NumericUpDown Value="{Binding RoiWPct}" Minimum="0" Maximum="100" Increment="0.5" FormatString="0.0" /></StackPanel>
                    <StackPanel><TextBlock Classes="axis" Text="높이 %" /><NumericUpDown Value="{Binding RoiHPct}" Minimum="0" Maximum="100" Increment="0.5" FormatString="0.0" /></StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="저장 (ROI)" Classes="accent" Command="{Binding SaveRoiCommand}" />
                    <Button Content="평탄 검증" Command="{Binding VerifyPlaneCommand}" IsEnabled="{Binding IsStreaming}" />
                    <TextBlock Classes="axis" VerticalAlignment="Center" Text="{Binding StatsText}" />
                </StackPanel>

                <!-- 평탄면 검출 결과 — 검출 순간의 깊이 프레임 정지 화면 + 결과값.
                     코봇이 이동해 라이브가 바뀌어도 다음 검출 전까지 남는다. -->
                <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,4,0,0">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="평탄면 검출 결과" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Classes="badge" IsVisible="{Binding HasFlat}"
                                    Classes.on="{Binding FlatStageOk}" Classes.busy="{Binding FlatStageBusy}" Classes.bad="{Binding FlatStageFailed}">
                                <TextBlock Text="{Binding FlatStageText}" />
                            </Border>
                        </Grid>
                        <TextBlock Classes="axis" IsVisible="{Binding !HasFlat}" TextWrapping="Wrap"
                                   Text="검출 결과 없음 — '평탄 검증'을 누르거나 시퀀스 평탄면 센터링을 실행하면 표시됩니다." />
                        <Grid ColumnDefinitions="300,*" IsVisible="{Binding HasFlat}">
                            <StackPanel Grid.Column="0" Spacing="6">
                                <Border Width="300" Height="188" Background="Black" CornerRadius="4" ClipToBounds="True">
                                    <Grid Name="FlatHost">
                                        <Image Source="{Binding FlatImage}" Stretch="Fill" />
                                        <Canvas Name="FlatOverlay" />
                                        <Border Background="#A6000000" CornerRadius="3" Padding="5,2" Margin="4"
                                                HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Foreground="White" FontSize="11" Text="{Binding FlatSourceText, StringFormat='정지 화면 · {0}'}" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Border Classes="legend" Background="#3B6D11" /><TextBlock Classes="axis" Text="평탄" Margin="0,0,6,0" />
                                    <Border Classes="legend" Background="#E24B4A" /><TextBlock Classes="axis" Text="거침" Margin="0,0,6,0" />
                                    <Border Classes="legend" Background="#888780" /><TextBlock Classes="axis" Text="무효" Margin="0,0,6,0" />
                                    <Border Classes="legend" BorderBrush="#5DCAA5" BorderThickness="2" /><TextBlock Classes="axis" Text="선택" Margin="0,0,6,0" />
                                    <Border Classes="legend" BorderBrush="#5DCAA5" BorderThickness="1" /><TextBlock Classes="axis" Text="2순위" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                <TextBlock Classes="axis" Text="출처 · 시각" />
                                <TextBlock Classes="flatval" Text="{Binding FlatSourceText}" />
                                <TextBlock Classes="axis" Text="선택 셀 / 2순위 (열,행)" />
                                <TextBlock Classes="flatval" Text="{Binding FlatCellText}" TextWrapping="Wrap" />
                                <TextBlock Classes="axis" Text="깊이" />
                                <TextBlock Classes="flatval" Text="{Binding FlatDepthText}" />
                                <TextBlock Classes="axis" Text="이동량 Δx, Δy" />
                                <TextBlock Classes="flatval" Text="{Binding FlatDeltaText}" />
                                <TextBlock Classes="axis" Text="레이저 3점" />
                                <TextBlock Classes="flatval" Text="{Binding FlatLaserText}" TextWrapping="Wrap" />
                                <TextBlock Classes="axis" Text="{Binding FlatLaserChannelsText}" Margin="0,-4,0,6"
                                           IsVisible="{Binding FlatLaserChannelsText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <!-- 평탄 검증 결과 위치로 코봇을 실제 이동 — 셀 Δ + 카메라→레이저 보정 후 측정만(틸트 보정 없음) -->
                                <Button Content="레이저 이동·측정 (코봇 이동)" Command="{Binding LaserMeasureCommand}"
                                        IsEnabled="{Binding CanLaserMeasure}" Margin="0,2,0,6" />
                                <TextBlock Classes="axis" TextWrapping="Wrap" IsVisible="{Binding !CanLaserMeasure}"
                                           Text="'평탄 검증' 직후, 코봇이 그 자리에 있을 때만 사용할 수 있습니다." />
                                <TextBlock Classes="axis" Text="{Binding FlatStageMessage}" TextWrapping="Wrap"
                                           IsVisible="{Binding FlatStageMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <TextBlock Classes="axis" Margin="0,10,0,0" TextWrapping="Wrap"
                   Text="후속(Tier 3 확장): Bead/Peak ROI 영속, IR 노출 튜닝, 평탄면 자동 정렬, 코봇 조그 팝업. macOS 는 카메라 하드웨어가 없어 영상이 비어 있습니다(Windows 실장비에서 표시)." />
    </StackPanel>
</UserControl>
