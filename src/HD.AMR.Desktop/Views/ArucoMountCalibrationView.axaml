<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HD.AMR.Desktop.ViewModels"
             x:Class="HD.AMR.Desktop.Views.ArucoMountCalibrationView"
             x:DataType="vm:ArucoMountCalibrationViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.axis"><Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/><Setter Property="FontSize" Value="12"/></Style>
    <Style Selector="TextBlock.hint"><Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style Selector="NumericUpDown.pose"><Setter Property="Width" Value="92"/><Setter Property="Margin" Value="0,0,6,0"/></Style>
  </UserControl.Styles>
  <ScrollViewer>
    <StackPanel MaxWidth="1050" HorizontalAlignment="Left">
      <TextBlock Classes="cardHead" Text="ArUco 장착 보정 (T_A_B)"/>
      <TextBlock Classes="hint" TextWrapping="Wrap" Text="바닥에 고정한 ArUco의 높이(q_z)만 입력하고, 서로 다른 AMR·코봇 자세에서 촬영하여 AMR→코봇 장착 변환과 마커의 미지 X/Y/Yaw를 동시에 추정합니다. 이 페이지는 장비를 자동으로 움직이지 않습니다."/>
      <Border Classes="alert" Classes.info="{Binding !IsError}" IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}"><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/></Border>

      <Border Classes="card"><StackPanel Spacing="8">
        <TextBlock Classes="cardHead" Text="마커 q_z 와 T_T_C 확인"/>
        <TextBlock Classes="hint" Text="ArUco ID·크기·Tool 번호는 위 공통 설정 카드에서 지정합니다. 여기서는 마커 중앙의 바닥 기준 높이(q_z)만 입력하세요."/>
        <WrapPanel>
          <StackPanel Margin="0,0,10,8"><TextBlock Classes="axis" Text="마커 q_z (mm)"/><NumericUpDown Value="{Binding MarkerQzMm}" Increment="0.1"/></StackPanel>
          <CheckBox VerticalAlignment="Bottom" Margin="0,0,14,10" Content="q_z 확인" IsChecked="{Binding QzConfirmed}"/>
        </WrapPanel>
        <TextBlock Classes="axis" Text="T_T_C — ① 단계에서 측정한 값 (읽기 전용)"/>
        <TextBlock Text="{Binding HandEyeText}" TextWrapping="Wrap"/>
        <Border Classes="alert"><TextBlock FontSize="12" TextWrapping="Wrap" Text="T_T_C 는 ① 핸드아이 측정 단계에서 AX=XB 로 산출·저장한 값입니다. 여기서 직접 입력하지 않습니다 — 가정값을 넣으면 그 오차가 T_A_B 로 흡수되어 잔차로는 드러나지 않기 때문입니다. 값을 바꾸려면 ① 탭으로 돌아가세요."/></Border>
      </StackPanel></Border>

      <Border Classes="card"><StackPanel Spacing="8">
        <TextBlock Classes="cardHead" Text="표본 수집"/>
        <TextBlock Classes="hint" Text="AMR을 완전히 정지시킨 뒤 촬영하세요. 같은 마커를 계속 사용하며, AMR 4곳 이상·yaw 60° 이상(권장 90°), 각 위치에서 코봇 시점 3~5개로 총 15~40개를 권장합니다. 마커는 중간에 움직이면 안 됩니다."/>
        <WrapPanel>
          <Border Classes="badge" Classes.on="{Binding AmrConnected}" Classes.off="{Binding !AmrConnected}" Margin="0,0,6,6"><TextBlock Text="AMR"/></Border>
          <Border Classes="badge" Classes.on="{Binding CobotConnected}" Classes.off="{Binding !CobotConnected}" Margin="0,0,6,6"><TextBlock Text="Cobot"/></Border>
          <Border Classes="badge" Classes.on="{Binding CameraReady}" Classes.off="{Binding !CameraReady}" Margin="0,0,6,6"><TextBlock Text="D435 RGB"/></Border>
          <Border Classes="badge" Margin="0,0,6,6"><TextBlock Text="{Binding SampleSummary}"/></Border>
        </WrapPanel>
        <TextBlock Text="{Binding AmrPoseText}"/>
        <StackPanel Orientation="Horizontal" Spacing="8"><Button Classes="accent" Content="현재 자세에서 ArUco 캡처" Command="{Binding CaptureCommand}"/><Button Content="전체 삭제" Command="{Binding ClearCommand}"/></StackPanel>
        <ItemsControl ItemsSource="{Binding Rows}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ArucoMountSampleRow">
          <Grid ColumnDefinitions="45,120,120,100,100,*" Margin="0,3"><TextBlock Text="{Binding Index}"/><TextBlock Grid.Column="1" Text="{Binding X, StringFormat='X {0:0.0}'}"/><TextBlock Grid.Column="2" Text="{Binding Y, StringFormat='Y {0:0.0}'}"/><TextBlock Grid.Column="3" Text="{Binding Yaw, StringFormat='{}{0:0.0}°'}"/><TextBlock Grid.Column="4" Text="{Binding ErrorPx, StringFormat='{}{0:0.00}px'}"/><Button Grid.Column="5" HorizontalAlignment="Left" Content="삭제" Command="{Binding $parent[ItemsControl].((vm:ArucoMountCalibrationViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding Index}"/></Grid>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel></Border>

      <Border Classes="card"><StackPanel Spacing="8">
        <TextBlock Classes="cardHead" Text="③ 동시 산출 및 저장"/>
        <Button Classes="accent" HorizontalAlignment="Left" Content="T_A_B + T_W_Q 동시 산출" Command="{Binding SolveCommand}"/>
        <StackPanel IsVisible="{Binding Result, Converter={x:Static ObjectConverters.IsNotNull}}" Spacing="5">
          <TextBlock Text="{Binding Result.TranslationRmsMm, StringFormat='위치 RMS {0:0.0} mm'}"/><TextBlock Text="{Binding Result.RotationRmsDeg, StringFormat='회전 RMS {0:0.00}°'}"/>
          <TextBlock Text="{Binding Result.MarkerPoseWQ[0], StringFormat='추정 마커 W.X {0:0.0} mm'}"/><TextBlock Text="{Binding Result.MarkerPoseWQ[1], StringFormat='추정 마커 W.Y {0:0.0} mm'}"/><TextBlock Text="{Binding Result.MarkerPoseWQ[5], StringFormat='추정 마커 W.Yaw {0:0.00}°'}"/>
        </StackPanel>
        <TextBlock Classes="axis" Text="저장할 T_A_B (mm/도)"/>
        <WrapPanel>
          <StackPanel><TextBlock Classes="axis" Text="X"/><NumericUpDown Classes="pose" Value="{Binding Mount.V0}"/></StackPanel><StackPanel><TextBlock Classes="axis" Text="Y"/><NumericUpDown Classes="pose" Value="{Binding Mount.V1}"/></StackPanel><StackPanel><TextBlock Classes="axis" Text="Z"/><NumericUpDown Classes="pose" Value="{Binding Mount.V2}"/></StackPanel><StackPanel><TextBlock Classes="axis" Text="Rx"/><NumericUpDown Classes="pose" Value="{Binding Mount.V3}"/></StackPanel><StackPanel><TextBlock Classes="axis" Text="Ry"/><NumericUpDown Classes="pose" Value="{Binding Mount.V4}"/></StackPanel><StackPanel><TextBlock Classes="axis" Text="Rz"/><NumericUpDown Classes="pose" Value="{Binding Mount.V5}"/></StackPanel>
        </WrapPanel>
        <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="산출값 적용" Command="{Binding ApplyCommand}"/><Button Classes="accent" Content="T_A_B 저장" Command="{Binding SaveMountCommand}"/></StackPanel>
        <Border Classes="alert"><TextBlock FontSize="12" TextWrapping="Wrap" Text="저장 전 RMS와 산출값을 확인하세요. 이 방식은 T_T_C와 D435 내부 파라미터 오차를 T_A_B에 흡수할 수 있으므로, 별도 검증 위치에서 마커 재측정 후 오차를 확인해야 합니다."/></Border>
      </StackPanel></Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
