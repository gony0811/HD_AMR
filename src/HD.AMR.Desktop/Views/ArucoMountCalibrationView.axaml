<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HD.AMR.Desktop.ViewModels" x:Class="HD.AMR.Desktop.Views.ArucoMountCalibrationView"
             x:DataType="vm:ArucoMountCalibrationViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.axis"><Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/><Setter Property="FontSize" Value="12"/></Style>
    <Style Selector="TextBlock.hint"><Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style Selector="NumericUpDown.pose"><Setter Property="Width" Value="108"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Increment" Value="0.1"/></Style>
  </UserControl.Styles>
  <ScrollViewer>
    <StackPanel MaxWidth="1050" HorizontalAlignment="Left">
      <TextBlock Classes="cardHead" Text="T_A_B 직접 입력"/>
      <TextBlock Classes="hint" Text="AMR 차체 좌표계 A에서 본 코봇 BASE 좌표계 B의 장착 자세를 도면 치수로 직접 입력합니다. 이 값은 AMR이 이동해도 변하지 않는 고정 장착 변환입니다."/>
      <Border Classes="alert" Classes.info="{Binding !IsError}" IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}"><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/></Border>

      <Border Classes="card"><StackPanel Spacing="8">
        <TextBlock Classes="cardHead" Text="TTC hand-eye 보정 결과"/>
        <TextBlock Text="{Binding HandEyeText}" TextWrapping="Wrap"/>
        <TextBlock Classes="hint" Text="이 값은 ① 단계에서 저장한 결과이며 여기서는 변경하지 않습니다."/>
      </StackPanel></Border>

      <Border Classes="card"><StackPanel Spacing="10">
        <TextBlock Classes="cardHead" Text="AMR → 코봇 BASE 장착 자세 (T_A_B)"/>
        <TextBlock Classes="hint" Text="위치는 AMR 원점에서 코봇 BASE 원점까지의 이동량입니다. AMR +X 방향은 X+, +Y 방향은 Y+, +Z 방향은 Z+로 입력하고 반대쪽이면 음수로 입력하세요."/>
        <WrapPanel>
          <StackPanel><TextBlock Classes="axis" Text="X (mm)"/><NumericUpDown Classes="pose" Value="{Binding Mount.V0}"/></StackPanel>
          <StackPanel><TextBlock Classes="axis" Text="Y (mm)"/><NumericUpDown Classes="pose" Value="{Binding Mount.V1}"/></StackPanel>
          <StackPanel><TextBlock Classes="axis" Text="Z (mm)"/><NumericUpDown Classes="pose" Value="{Binding Mount.V2}"/></StackPanel>
          <StackPanel><TextBlock Classes="axis" Text="Rx (°)"/><NumericUpDown Classes="pose" Value="{Binding Mount.V3}"/></StackPanel>
          <StackPanel><TextBlock Classes="axis" Text="Ry (°)"/><NumericUpDown Classes="pose" Value="{Binding Mount.V4}"/></StackPanel>
          <StackPanel><TextBlock Classes="axis" Text="Rz (°)"/><NumericUpDown Classes="pose" Value="{Binding Mount.V5}"/></StackPanel>
        </WrapPanel>
        <Border Classes="alert"><StackPanel Spacing="4">
          <TextBlock FontSize="12" TextWrapping="Wrap" Text="회전값은 코봇 BASE 축이 AMR 축에 대해 돌아간 각도입니다(R = Rz × Ry × Rx). 두 좌표계 축 방향이 같으면 Rx=Ry=Rz=0°입니다."/>
          <TextBlock FontSize="12" TextWrapping="Wrap" Text="예: 코봇 BASE +X가 AMR +Y를 향하고 두 좌표계가 수평이면 Rz=+90°입니다. 장비 좌표계 표기와 오른손 법칙을 반드시 도면에서 확인하세요."/>
        </StackPanel></Border>
        <Button Classes="accent" HorizontalAlignment="Left" Content="T_A_B 저장" Command="{Binding SaveMountCommand}"/>
      </StackPanel></Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
