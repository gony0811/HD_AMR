<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HD.AMR.Desktop.ViewModels" x:Class="HD.AMR.Desktop.Views.ArucoMountCalibrationView"
             x:DataType="vm:ArucoMountCalibrationViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.axis"><Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/><Setter Property="FontSize" Value="12"/></Style>
    <Style Selector="TextBlock.hint"><Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style Selector="NumericUpDown.pose"><Setter Property="Width" Value="108"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Increment" Value="0.1"/></Style>
  </UserControl.Styles>
  <ScrollViewer>
    <StackPanel MaxWidth="1050" HorizontalAlignment="Left">
      <TextBlock Classes="cardHead" Text="도면 설치 좌표 입력"/>
      <TextBlock Classes="hint" Text="TTC hand-eye 보정 후, 설치 도면에 표시된 AMR 원점과 코봇 BASE 원점의 자세를 동일한 도면 좌표계 기준으로 입력합니다. 두 자세로 AMR→코봇 BASE 변환(T_A_B)을 계산합니다."/>
      <Border Classes="alert" Classes.info="{Binding !IsError}" IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}"><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/></Border>

      <Border Classes="card"><StackPanel Spacing="8">
        <TextBlock Classes="cardHead" Text="TTC hand-eye 보정 결과"/>
        <TextBlock Text="{Binding HandEyeText}" TextWrapping="Wrap"/>
        <TextBlock Classes="hint" Text="이 값은 ① 단계에서 저장한 결과이며 여기서는 변경하지 않습니다."/>
      </StackPanel></Border>

      <Border Classes="card"><StackPanel Spacing="10">
        <TextBlock Classes="cardHead" Text="1. AMR 설치 자세 (T_G_A)"/>
        <TextBlock Classes="hint" Text="도면 좌표계 G에서 본 AMR 차체 원점 A의 좌표입니다. 거리는 mm, 각도는 도(°), 회전은 Rx/Ry/Rz (ZYX) 규약입니다."/>
        <WrapPanel>
          <StackPanel><TextBlock Classes="axis" Text="X (mm)"/><NumericUpDown Classes="pose" Value="{Binding DrawingAmr.V0}"/></StackPanel>
          <StackPanel><TextBlock Classes="axis" Text="Y (mm)"/><NumericUpDown Classes="pose" Value="{Binding DrawingAmr.V1}"/></StackPanel>
          <StackPanel><TextBlock Classes="axis" Text="Z (mm)"/><NumericUpDown Classes="pose" Value="{Binding DrawingAmr.V2}"/></StackPanel>
          <StackPanel><TextBlock Classes="axis" Text="Rx (°)"/><NumericUpDown Classes="pose" Value="{Binding DrawingAmr.V3}"/></StackPanel>
          <StackPanel><TextBlock Classes="axis" Text="Ry (°)"/><NumericUpDown Classes="pose" Value="{Binding DrawingAmr.V4}"/></StackPanel>
          <StackPanel><TextBlock Classes="axis" Text="Rz (°)"/><NumericUpDown Classes="pose" Value="{Binding DrawingAmr.V5}"/></StackPanel>
        </WrapPanel>
      </StackPanel></Border>

      <Border Classes="card"><StackPanel Spacing="10">
        <TextBlock Classes="cardHead" Text="2. 코봇 BASE 설치 자세 (T_G_B)"/>
        <TextBlock Classes="hint" Text="같은 도면 좌표계 G에서 본 코봇 BASE 원점 B의 좌표입니다. AMR 좌표와 동일한 원점·축 방향·단위를 사용하세요."/>
        <WrapPanel>
          <StackPanel><TextBlock Classes="axis" Text="X (mm)"/><NumericUpDown Classes="pose" Value="{Binding DrawingCobot.V0}"/></StackPanel>
          <StackPanel><TextBlock Classes="axis" Text="Y (mm)"/><NumericUpDown Classes="pose" Value="{Binding DrawingCobot.V1}"/></StackPanel>
          <StackPanel><TextBlock Classes="axis" Text="Z (mm)"/><NumericUpDown Classes="pose" Value="{Binding DrawingCobot.V2}"/></StackPanel>
          <StackPanel><TextBlock Classes="axis" Text="Rx (°)"/><NumericUpDown Classes="pose" Value="{Binding DrawingCobot.V3}"/></StackPanel>
          <StackPanel><TextBlock Classes="axis" Text="Ry (°)"/><NumericUpDown Classes="pose" Value="{Binding DrawingCobot.V4}"/></StackPanel>
          <StackPanel><TextBlock Classes="axis" Text="Rz (°)"/><NumericUpDown Classes="pose" Value="{Binding DrawingCobot.V5}"/></StackPanel>
        </WrapPanel>
      </StackPanel></Border>

      <Border Classes="card"><StackPanel Spacing="10">
        <TextBlock Classes="cardHead" Text="3. T_A_B 계산 및 저장"/>
        <TextBlock Classes="hint" Text="T_A_B = inv(T_G_A) × T_G_B. 결과는 직접 편집하지 않으며 입력 좌표가 바뀌면 다시 계산해야 저장할 수 있습니다."/>
        <Button Classes="accent" HorizontalAlignment="Left" Content="도면 좌표로 T_A_B 계산" Command="{Binding CalculateCommand}"/>
        <WrapPanel>
          <StackPanel><TextBlock Classes="axis" Text="X (mm)"/><NumericUpDown Classes="pose" Value="{Binding Mount.V0}" IsReadOnly="True"/></StackPanel>
          <StackPanel><TextBlock Classes="axis" Text="Y (mm)"/><NumericUpDown Classes="pose" Value="{Binding Mount.V1}" IsReadOnly="True"/></StackPanel>
          <StackPanel><TextBlock Classes="axis" Text="Z (mm)"/><NumericUpDown Classes="pose" Value="{Binding Mount.V2}" IsReadOnly="True"/></StackPanel>
          <StackPanel><TextBlock Classes="axis" Text="Rx (°)"/><NumericUpDown Classes="pose" Value="{Binding Mount.V3}" IsReadOnly="True"/></StackPanel>
          <StackPanel><TextBlock Classes="axis" Text="Ry (°)"/><NumericUpDown Classes="pose" Value="{Binding Mount.V4}" IsReadOnly="True"/></StackPanel>
          <StackPanel><TextBlock Classes="axis" Text="Rz (°)"/><NumericUpDown Classes="pose" Value="{Binding Mount.V5}" IsReadOnly="True"/></StackPanel>
        </WrapPanel>
        <Button Classes="accent" HorizontalAlignment="Left" Content="T_A_B 저장" Command="{Binding SaveMountCommand}"/>
        <Border Classes="alert"><TextBlock FontSize="12" TextWrapping="Wrap" Text="저장 전 도면의 두 좌표가 같은 기준 원점과 축 방향을 사용하는지 확인하세요. 특히 도면 단위(m/mm)와 AMR 전방(+X), 좌측(+Y), 상방(+Z) 축 정의가 일치해야 합니다."/></Border>
      </StackPanel></Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
