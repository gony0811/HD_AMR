<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HD.AMR.Desktop.ViewModels"
        x:Class="HD.AMR.Desktop.Views.SequenceMonitorWindow"
        x:DataType="vm:SequenceMonitorViewModel"
        Width="760" Height="900"
        Title="시퀀스 모니터"
        Background="{DynamicResource AppWindowBrush}">
    <Window.Styles>
        <Style Selector="TextBlock.cap"><Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" /><Setter Property="FontSize" Value="12" /><Setter Property="Margin" Value="0,0,0,4" /></Style>
        <Style Selector="Border.imgbox"><Setter Property="Background" Value="Black" /><Setter Property="CornerRadius" Value="4" /><Setter Property="ClipToBounds" Value="True" /></Style>
    </Window.Styles>
    <Grid Margin="16">
        <TextBlock IsVisible="{Binding !HasStep}" Text="{Binding IdleText}"
                   Foreground="{DynamicResource AppMutedTextBrush}" TextWrapping="Wrap"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />

        <DockPanel IsVisible="{Binding HasStep}">
            <Border DockPanel.Dock="Top" Classes="card" Padding="12">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding StepHeader}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding TargetDistanceText, StringFormat='목표 거리: {0}'}"
                                   Foreground="{DynamicResource AppMutedTextBrush}" FontSize="12" />
                    </StackPanel>
                    <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="4" Padding="10,5"
                            Background="{Binding StatusKind, Converter={x:Static vm:SeqConverters.StatusBrush}}">
                        <TextBlock Text="{Binding StatusText}" Foreground="White" />
                    </Border>
                </Grid>
            </Border>

            <!-- 카메라 칸 — 평탄면 센터링·레이저 WD·Peak/Bead 찾기·센터링 단계에서만 표시. -->
            <Border DockPanel.Dock="Bottom" Classes="card" Padding="12" Margin="0,10,0,0" IsVisible="{Binding ShowCamera}">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="카메라" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Classes="cap" Margin="0" Text="{Binding CameraHint, StringFormat='{}{0} · 마우스를 올리면 거리(mm)'}" />
                    </Grid>

                    <!-- 2칸: 라이브 + (검출 결과 | 레이저 3점 값) -->
                    <Grid ColumnDefinitions="*,*" IsVisible="{Binding ShowTwoPane}">
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Classes="cap" Text="{Binding LiveTitle}" />
                            <Border Classes="imgbox" Height="190">
                                <Grid Name="LiveHost" Background="Transparent">
                                    <Image Source="{Binding LiveImage}" Stretch="Fill" />
                                    <Canvas Name="LiveOverlay" />
                                    <Canvas Name="LiveProbe" />
                                </Grid>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0" IsVisible="{Binding ShowResultImage}">
                            <TextBlock Classes="cap" Text="{Binding ResultTitle}" />
                            <Border Classes="imgbox" Height="190">
                                <Image Source="{Binding ResultImage}" Stretch="Fill" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0" IsVisible="{Binding ShowTextPane}">
                            <TextBlock Classes="cap" Text="{Binding TextPaneTitle}" />
                            <Border Height="190" CornerRadius="4" Padding="10"
                                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                                <TextBlock Text="{Binding PaneText}" FontFamily="monospace" FontSize="13" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- 3칸(평탄면 센터링): 라이브 + 평탄 셀 검출 + 레이저 측정 직전 -->
                    <StackPanel Spacing="6" IsVisible="{Binding ShowFlatPane}">
                        <Grid ColumnDefinitions="*,*,*">
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Classes="cap" Text="{Binding LiveTitle}" />
                                <Border Classes="imgbox" Height="135">
                                    <Grid Name="FlatLiveHost" Background="Transparent">
                                        <Image Source="{Binding LiveImage}" Stretch="Fill" />
                                        <Canvas Name="FlatLiveProbe" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                <TextBlock Classes="cap" Text="{Binding FlatTitle}" TextTrimming="CharacterEllipsis" />
                                <Border Classes="imgbox" Height="135">
                                    <Grid Name="FlatHost" Background="Transparent">
                                        <Image Source="{Binding FlatImage}" Stretch="Fill" />
                                        <Canvas Name="FlatOverlay" />
                                        <Canvas Name="FlatProbe" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                <TextBlock Classes="cap" Text="{Binding CenteredTitle}" TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="카메라 센터링 직후 화면. 청록 사각형 = 레이저 예상 측정 범위(ROI 중심, 선택 셀 크기)" />
                                <Border Classes="imgbox" Height="135">
                                    <Grid Name="CenteredHost" Background="Transparent">
                                        <Image Source="{Binding CenteredImage}" Stretch="Fill" />
                                        <Canvas Name="CenteredOverlay" />
                                        <Canvas Name="CenteredProbe" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <TextBlock Classes="cap" Margin="0" Text="{Binding FlatLaserText}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 레이저 3채널 실시간 — 로그와 카메라 칸 사이(DockPanel 은 Bottom 을 선언 순서대로 아래부터 쌓는다). -->
            <Border DockPanel.Dock="Bottom" Classes="card" Padding="12,6" Margin="0,10,0,0">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text="레이저" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding LaserLine}" FontFamily="monospace" FontSize="13"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <Border Classes="card" Padding="0" Margin="0,10,0,0">
                <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                         FontFamily="monospace" FontSize="12" BorderThickness="0"
                         VerticalAlignment="Stretch" TextWrapping="NoWrap" />
            </Border>
        </DockPanel>
    </Grid>
</Window>
