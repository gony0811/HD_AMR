<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HD.AMR.Desktop.ViewModels"
             xmlns:ent="using:HD.AMR.App.Data.Entities"
             x:Class="HD.AMR.Desktop.Views.SequenceView"
             x:DataType="vm:SequenceViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.axis"><Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" /><Setter Property="FontSize" Value="12" /></Style>
        <Style Selector="TextBlock.hint"><Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" /><Setter Property="FontSize" Value="12" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    </UserControl.Styles>

    <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
        <TextBlock Classes="page-title" Text="Sequence" />

        <!-- 실행 제어 -->
        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Text="시퀀스 실행" FontWeight="SemiBold" />
                <Border Classes="alert" IsVisible="{Binding !CobotConnected}">
                    <TextBlock Text="⚠ 코봇 RPC 미연결 — 시퀀스 실행 불가." />
                </Border>
                <Border Classes="alert" IsVisible="{Binding FaultText, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Text="{Binding FaultText}" />
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <StackPanel><TextBlock Classes="axis" Text="공구(tool) ⓐ" ToolTip.Tip="ACS 실행에서는 티칭 프로필 RunTool (0 이면 #1 로 보정)" /><NumericUpDown Value="{Binding Tool}" Minimum="0" Maximum="15" Increment="1" FormatString="0" IsEnabled="{Binding !Busy}" /></StackPanel>
                    <StackPanel><TextBlock Classes="axis" Text="속도(%) ⓐ" ToolTip.Tip="ACS 실행에서는 티칭 프로필 RunVel (기본 20%)" /><NumericUpDown Value="{Binding Velocity}" Minimum="1" Maximum="100" Increment="1" FormatString="0" IsEnabled="{Binding !Busy}" /></StackPanel>
                    <Button VerticalAlignment="Bottom" Content="▶▶ 풀오토" Classes="accent" Command="{Binding RunAllCommand}" />
                    <Button VerticalAlignment="Bottom" Content="■ 정지" Classes="danger" Command="{Binding StopCommand}" />
                    <Button VerticalAlignment="Bottom" Content="오류 해제" Command="{Binding ResetFaultCommand}" IsEnabled="{Binding CobotConnected}" />
                    <Button VerticalAlignment="Bottom" Content="↺ 상태 초기화" Command="{Binding ResetStatusesCommand}" IsEnabled="{Binding !Busy}" />
                </StackPanel>
                <Border Classes="alert" IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>

        <!-- 실행 파라미터 -->
        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Text="실행 파라미터" FontWeight="SemiBold" />
                <TextBlock Classes="hint" Text="ACS 실행(VDA5050 startWeldInspection)에서는 아래 ⓐ 값들을 액션·레시피가 대신 결정합니다 — 여기 입력값은 이 페이지에서 수동 실행할 때만 쓰입니다. ⓑ 는 장비 보정 상수라 ACS 실행에도 여기 저장한 값이 그대로 적용됩니다." />

                <TextBlock Classes="axis" Text="ⓐ ACS 실행 시 액션·레시피가 결정 (수동 실행 전용 입력)" />
                <WrapPanel>
                    <StackPanel Width="230" Margin="0,0,12,8">
                        <TextBlock Classes="axis" Text="검사 Wall (Surface)" ToolTip.Tip="ACS: params.drawingPos.wall_code → Surface ID" />
                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding SurfaceOptions}"
                                  SelectedValue="{Binding InspectionSurfaceId}" SelectedValueBinding="{Binding SurfaceId}"
                                  IsEnabled="{Binding !Busy}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:SurfaceOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Width="130" Margin="0,0,12,8">
                        <TextBlock Classes="axis" Text="방향" ToolTip.Tip="ACS: seamStartW→seamEndW 벡터와 정차 노드 theta 로 자동 유도" />
                        <ComboBox HorizontalAlignment="Stretch" SelectedIndex="{Binding DirectionIndex}" IsEnabled="{Binding !Busy}">
                            <ComboBoxItem>수평</ComboBoxItem><ComboBoxItem>수직</ComboBoxItem><ComboBoxItem>자동 (용접선)</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Classes="hint" Text="{Binding DirectionHint}" IsVisible="{Binding DirectionHint, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8"><TextBlock Classes="axis" Text="카메라 목표거리" ToolTip.Tip="ACS: 레시피 CameraTargetDistanceMm (빈 값=400). action.workingDistanceMm 은 미사용" /><NumericUpDown Value="{Binding CameraTargetDistanceMm}" Increment="1" IsEnabled="{Binding !Busy}" /></StackPanel>
                </WrapPanel>

                <TextBlock Classes="axis" Text="ⓑ 장비 보정 상수 (ACS 실행에도 이 값이 적용됨)" />
                <WrapPanel>
                    <StackPanel Margin="0,0,12,8"><TextBlock Classes="axis" Text="U (좌+/우−)" /><NumericUpDown Value="{Binding OffsetU}" Increment="0.1" IsEnabled="{Binding !Busy}" /></StackPanel>
                    <StackPanel Margin="0,0,12,8"><TextBlock Classes="axis" Text="V (상+/하−)" /><NumericUpDown Value="{Binding OffsetV}" Increment="0.1" IsEnabled="{Binding !Busy}" /></StackPanel>
                    <StackPanel Width="150" Margin="0,0,12,8"><TextBlock Classes="axis" Text="레이저중심 Y" /><NumericUpDown Value="{Binding CameraToLaserShiftYmm}" Increment="0.1" IsEnabled="{Binding !Busy}" /></StackPanel>
                    <StackPanel Width="110" Margin="0,0,12,8">
                        <TextBlock Classes="axis" Text="Peak X부호" />
                        <ComboBox HorizontalAlignment="Stretch" SelectedIndex="{Binding XSignIndex}" IsEnabled="{Binding !Busy}"><ComboBoxItem>+1</ComboBoxItem><ComboBoxItem>−1</ComboBoxItem></ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8"><TextBlock Classes="axis" Text="검사캠 X" /><NumericUpDown Value="{Binding InspectCamOffsetX}" Increment="0.1" IsEnabled="{Binding !Busy}" /></StackPanel>
                    <StackPanel Margin="0,0,12,8"><TextBlock Classes="axis" Text="검사캠 Y" /><NumericUpDown Value="{Binding InspectCamOffsetY}" Increment="0.1" IsEnabled="{Binding !Busy}" /></StackPanel>
                    <StackPanel Margin="0,0,12,8"><TextBlock Classes="axis" Text="z 기준 보정(mm)" ToolTip.Tip="도면 전역 z → AMR 바닥 기준: 해당 층 바닥 높이(level_z)를 뺀다. 1층=0" /><NumericUpDown Value="{Binding ZDatumOffsetMm}" Increment="1" IsEnabled="{Binding !Busy}" /></StackPanel>
                    <StackPanel Margin="0,0,12,8"><TextBlock Classes="axis" Text="작업물 번호" /><NumericUpDown Value="{Binding WobjId}" Minimum="0" Maximum="14" Increment="1" FormatString="0" IsEnabled="{Binding !Busy}" /></StackPanel>
                    <StackPanel Margin="0,0,12,8"><TextBlock Classes="axis" Text="Pitch" /><NumericUpDown Value="{Binding PitchMm}" Minimum="1" Increment="1" IsEnabled="{Binding !Busy}" /></StackPanel>
                    <StackPanel Width="130" Margin="0,0,12,8">
                        <TextBlock Classes="axis" Text="Peak1→2 방향" />
                        <ComboBox HorizontalAlignment="Stretch" SelectedIndex="{Binding PitchDirIndex}" IsEnabled="{Binding !Busy}"><ComboBoxItem>+1</ComboBoxItem><ComboBoxItem>−1</ComboBoxItem></ComboBox>
                    </StackPanel>
                    <StackPanel Width="200" Margin="0,0,12,8">
                        <TextBlock Classes="axis" Text="티칭설정 (ⓐ)" ToolTip.Tip="ACS: (seamType, wall_code) → 레시피 → 레시피에 지정된 티칭 프로필" />
                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Profiles}"
                                  SelectedValue="{Binding InspectionProfileId}" SelectedValueBinding="{Binding Id}" IsEnabled="{Binding !Busy}">
                            <ComboBox.ItemTemplate><DataTemplate x:DataType="ent:InspectionProfile"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ACS 작업 입력 재현: ① AMR 정차 위치 + 용접선 좌표 -->
        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Text="ACS 작업 입력 (테스트)" FontWeight="SemiBold" />
                <TextBlock Classes="hint" Text="ACS order 의 정차 위치(nodePosition)와 startWeldInspection 의 용접선 좌표(position.seamStartW/seamEndW)를 직접 입력해 수동 실행에서 재현합니다. 좌표는 맵(SLAM) 기준 m, z 는 도면 전역 z. ACS 실행에서는 이 값들 대신 수신값을 쓰며 ① 단계는 실행되지 않습니다." />

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <CheckBox Content="① AMR 위치 이동 사용" IsChecked="{Binding AmrMoveEnabled}" IsEnabled="{Binding !Busy}" VerticalAlignment="Bottom"
                              ToolTip.Tip="끄면 ① 단계는 이동 없이 통과합니다. 켜면 θ 가 벽 정면 방향(노드 theta)으로도 쓰입니다." />
                    <StackPanel><TextBlock Classes="axis" Text="X (m)" /><NumericUpDown Value="{Binding AmrX}" Increment="0.01" FormatString="0.000" IsEnabled="{Binding AmrMoveEnabled}" /></StackPanel>
                    <StackPanel><TextBlock Classes="axis" Text="Y (m)" /><NumericUpDown Value="{Binding AmrY}" Increment="0.01" FormatString="0.000" IsEnabled="{Binding AmrMoveEnabled}" /></StackPanel>
                    <StackPanel><TextBlock Classes="axis" Text="θ (°)" /><NumericUpDown Value="{Binding AmrThetaDeg}" Increment="1" FormatString="0.00" IsEnabled="{Binding AmrMoveEnabled}" /></StackPanel>
                    <Button VerticalAlignment="Bottom" Content="현재 위치 가져오기" Command="{Binding UseCurrentAmrPoseCommand}" IsEnabled="{Binding !Busy}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Width="150" VerticalAlignment="Bottom" Margin="0,0,0,6" Text="용접선 시작점 seamStartW" />
                    <StackPanel><TextBlock Classes="axis" Text="x (m)" /><NumericUpDown Value="{Binding SeamStartX}" Increment="0.01" FormatString="0.000" IsEnabled="{Binding !Busy}" /></StackPanel>
                    <StackPanel><TextBlock Classes="axis" Text="y (m)" /><NumericUpDown Value="{Binding SeamStartY}" Increment="0.01" FormatString="0.000" IsEnabled="{Binding !Busy}" /></StackPanel>
                    <StackPanel><TextBlock Classes="axis" Text="z (m)" /><NumericUpDown Value="{Binding SeamStartZ}" Increment="0.01" FormatString="0.000" IsEnabled="{Binding !Busy}" /></StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Width="150" VerticalAlignment="Bottom" Margin="0,0,0,6" Text="용접선 끝점 seamEndW" />
                    <StackPanel><TextBlock Classes="axis" Text="x (m)" /><NumericUpDown Value="{Binding SeamEndX}" Increment="0.01" FormatString="0.000" IsEnabled="{Binding !Busy}" /></StackPanel>
                    <StackPanel><TextBlock Classes="axis" Text="y (m)" /><NumericUpDown Value="{Binding SeamEndY}" Increment="0.01" FormatString="0.000" IsEnabled="{Binding !Busy}" /></StackPanel>
                    <StackPanel><TextBlock Classes="axis" Text="z (m)" /><NumericUpDown Value="{Binding SeamEndZ}" Increment="0.01" FormatString="0.000" IsEnabled="{Binding !Busy}" /></StackPanel>
                </StackPanel>
                <TextBlock Classes="hint" Text="wall_code 는 위 '검사 Wall (Surface)' 선택에서 정해집니다 (면 법선 자세 계산용)." />
            </StackPanel>
        </Border>

        <!-- 단계 목록 -->
        <Border Classes="card">
            <StackPanel Spacing="4">
                <Grid ColumnDefinitions="40,*,150,Auto">
                    <TextBlock Grid.Column="0" Text="#" Classes="axis" />
                    <TextBlock Grid.Column="1" Text="단계" Classes="axis" />
                    <TextBlock Grid.Column="2" Text="상태" Classes="axis" />
                    <TextBlock Grid.Column="3" Text="Operate" Classes="axis" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SeqStepVm">
                            <Border Padding="0,4" Background="{Binding IsCurrent, Converter={x:Static vm:SeqRowConverters.CurrentBrush}}">
                                <Grid ColumnDefinitions="40,*,150,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding No}" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" VerticalAlignment="Center" TextWrapping="Wrap"
                                               Foreground="{Binding StatusKind, Converter={x:Static vm:SeqConverters.StatusBrush}}" />
                                    <Button Grid.Column="3" Content="▶ 실행"
                                            Command="{Binding $parent[ItemsControl].((vm:SequenceViewModel)DataContext).RunStepCommand}"
                                            CommandParameter="{Binding Key}" IsEnabled="{Binding CanRun}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
