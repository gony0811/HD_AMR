<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HD.AMR.Desktop.ViewModels"
             xmlns:vis="using:HD.AMR.App.Communication.Vision"
             x:Class="HD.AMR.Desktop.Views.VisionPanelView"
             x:DataType="vm:VisionPanelViewModel">
    <Border Classes="card">
        <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding RoleTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Grid.Column="1" Classes="badge" Classes.on="{Binding IsConnected}" Classes.off="{Binding !IsConnected}">
                    <TextBlock Text="{Binding StatusText}" />
                </Border>
            </Grid>

            <!-- 연결 -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <StackPanel><TextBlock Classes="muted" FontSize="12" Text="비전 서버 IP" /><TextBox Width="140" Text="{Binding Host}" IsEnabled="{Binding !IsConnected}" /></StackPanel>
                <StackPanel><TextBlock Classes="muted" FontSize="12" Text="Port" /><NumericUpDown Value="{Binding Port}" Minimum="1" Maximum="65535" Increment="1" FormatString="0" IsEnabled="{Binding !IsConnected}" /></StackPanel>
                <Button VerticalAlignment="Bottom" Content="▶ Connect" Classes="accent" Command="{Binding ConnectCommand}" IsEnabled="{Binding !IsConnected}" />
                <Button VerticalAlignment="Bottom" Content="Disconnect" Command="{Binding DisconnectCommand}" IsEnabled="{Binding IsConnected}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="16">
                <CheckBox Content="Heartbeat 5초 자동 송신" IsChecked="{Binding AutoHeartbeat}" Command="{Binding ApplyHeartbeatCommand}" />
                <CheckBox Content="Heartbeat 실패 시 재연결 (3초/최대10회)" IsChecked="{Binding AutoReconnect}" />
            </StackPanel>

            <!-- 탭 -->
            <TabControl SelectedIndex="{Binding TabIndex}">
                <TabItem Header="프레임">
                    <StackPanel Spacing="8" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <StackPanel>
                                <TextBlock Classes="muted" FontSize="12" Text="COMMAND" />
                                <ComboBox Width="200" SelectedIndex="{Binding CommandIndex}">
                                    <ComboBoxItem>0x01 HEARTBEAT</ComboBoxItem>
                                    <ComboBoxItem>0x02 CAPTURE_REQ</ComboBoxItem>
                                    <ComboBoxItem>0x03 CAPTURE_RES</ComboBoxItem>
                                    <ComboBoxItem>0x04 ERROR_NOTI</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel><TextBlock Classes="muted" FontSize="12" Text="SEQ" /><NumericUpDown Value="{Binding Seq}" Minimum="0" Maximum="255" Increment="1" FormatString="0" IsEnabled="{Binding !AutoSeq}" /></StackPanel>
                            <CheckBox VerticalAlignment="Bottom" Content="Auto++" IsChecked="{Binding AutoSeq}" />
                            <StackPanel>
                                <TextBlock Classes="muted" FontSize="12" Text="TO" />
                                <ComboBox Width="150" SelectedIndex="{Binding ToIndex}">
                                    <ComboBoxItem>0x01 Automation</ComboBoxItem>
                                    <ComboBoxItem>0x02 Vision</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>

                        <!-- Heartbeat DATA -->
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsHeartbeat}">
                            <StackPanel><TextBlock Classes="muted" FontSize="12" Text="Timestamp (14B)" /><TextBox Width="160" MaxLength="14" Text="{Binding HbTimestamp}" /></StackPanel>
                            <StackPanel><TextBlock Classes="muted" FontSize="12" Text="Reserved (6B)" /><TextBox Width="90" MaxLength="6" Text="{Binding HbReserved}" /></StackPanel>
                            <Button VerticalAlignment="Bottom" Content="현재 시각" Command="{Binding StampNowCommand}" />
                        </StackPanel>

                        <!-- CaptureReq DATA -->
                        <StackPanel Spacing="8" IsVisible="{Binding IsCaptureReq}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <StackPanel>
                                    <TextBlock Classes="muted" FontSize="12" Text="Surface Type" />
                                    <ComboBox Width="150" SelectedIndex="{Binding SurfaceType}">
                                        <ComboBoxItem>0x00 Flat</ComboBoxItem>
                                        <ComboBoxItem>0x01 Corner</ComboBoxItem>
                                        <ComboBoxItem>0x02 Corrugation</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Classes="muted" FontSize="12" Text="Wall ID" />
                                    <ComboBox Width="240" ItemsSource="{Binding Surfaces}" SelectedIndex="{Binding SurfaceIndex}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vis:SurfaceInfo">
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <StackPanel><TextBlock Classes="muted" FontSize="12" Text="PosX = u (mm)" /><NumericUpDown Value="{Binding PosX}" Minimum="-999999" Maximum="999999" Increment="1" FormatString="0" /></StackPanel>
                                <StackPanel><TextBlock Classes="muted" FontSize="12" Text="PosY = v (mm)" /><NumericUpDown Value="{Binding PosY}" Minimum="-999999" Maximum="999999" Increment="1" FormatString="0" /></StackPanel>
                                <StackPanel><TextBlock Classes="muted" FontSize="12" Text="PosZ = h (mm)" /><NumericUpDown Value="{Binding PosZ}" Minimum="-999999" Maximum="999999" Increment="1" FormatString="0" /></StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <StackPanel MinWidth="330">
                                    <TextBlock Classes="muted" FontSize="12" Text="taskId (GUID — 비우면 Guid.Empty)" />
                                    <TextBox Width="320" Watermark="00000000-0000-0000-0000-000000000000" Text="{Binding TaskIdText}" />
                                </StackPanel>
                                <StackPanel><TextBlock Classes="muted" FontSize="12" Text="attempt" /><NumericUpDown Value="{Binding Attempt}" Minimum="0" Maximum="255" Increment="1" FormatString="0" /></StackPanel>
                                <StackPanel><TextBlock Classes="muted" FontSize="12" Text="captureSeq" /><NumericUpDown Value="{Binding CaptureSeq}" Minimum="0" Maximum="65535" Increment="1" FormatString="0" /></StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Result/Error DATA -->
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsResult}">
                            <StackPanel>
                                <TextBlock Classes="muted" FontSize="12" Text="Result / Error Code" />
                                <ComboBox Width="240" SelectedIndex="{Binding ResultIndex}">
                                    <ComboBoxItem>0x0000 OK</ComboBoxItem>
                                    <ComboBoxItem>0x0001</ComboBoxItem>
                                    <ComboBoxItem>0x0002</ComboBoxItem>
                                    <ComboBoxItem>0x0003</ComboBoxItem>
                                    <ComboBoxItem>0x0004</ComboBoxItem>
                                    <ComboBoxItem>0x0005</ComboBoxItem>
                                    <ComboBoxItem>0x00FF</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>

                        <!-- 오버라이드 -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <CheckBox VerticalAlignment="Bottom" Content="Auto LENGTH" IsChecked="{Binding AutoLen}" />
                            <NumericUpDown Value="{Binding Len}" Minimum="0" Maximum="65535" Increment="1" FormatString="0" IsEnabled="{Binding !AutoLen}" />
                            <CheckBox VerticalAlignment="Bottom" Content="Auto CHECKSUM" IsChecked="{Binding AutoChk}" />
                            <NumericUpDown Value="{Binding Chk}" Minimum="0" Maximum="255" Increment="1" FormatString="0" IsEnabled="{Binding !AutoChk}" />
                        </StackPanel>

                        <Button Content="▶ Send" Classes="accent" Command="{Binding SendCommand}" IsEnabled="{Binding IsConnected}" HorizontalAlignment="Left" />
                    </StackPanel>
                </TabItem>
                <TabItem Header="Raw HEX">
                    <StackPanel Spacing="8" Margin="0,8,0,0">
                        <TextBox AcceptsReturn="True" Height="70" FontFamily="monospace" Text="{Binding RawHex}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="▶ Send Raw" Classes="accent" Command="{Binding SendRawCommand}" IsEnabled="{Binding IsConnected}" />
                            <TextBlock Foreground="{DynamicResource BadgeNeutral}" VerticalAlignment="Center" Text="{Binding RawError}"
                                       IsVisible="{Binding RawError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                    </StackPanel>
                </TabItem>
            </TabControl>

            <!-- 로그 -->
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="로그 (최신순)" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Clear" Command="{Binding ClearLogCommand}" />
            </Grid>
            <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="4">
                <ScrollViewer MaxHeight="300">
                    <ItemsControl ItemsSource="{Binding Log}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:VisionLogRow">
                                <Grid ColumnDefinitions="90,48,*,2*" Background="{Binding Kind, Converter={x:Static vm:VisionConverters.RowBrush}}"
                                      Margin="0,1">
                                    <TextBlock Grid.Column="0" Text="{Binding Time}" FontFamily="monospace" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="{Binding Direction}" FontFamily="monospace" FontSize="11" />
                                    <TextBlock Grid.Column="2" Text="{Binding Hex}" FontFamily="monospace" FontSize="11" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="3" Text="{Binding Summary}" FontFamily="monospace" FontSize="11" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
