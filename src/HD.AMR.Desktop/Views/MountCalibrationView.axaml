<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HD.AMR.Desktop.ViewModels"
             xmlns:m="using:HD.AMR.App.Models"
             x:Class="HD.AMR.Desktop.Views.MountCalibrationView"
             x:DataType="vm:MountCalibrationViewModel">
    <UserControl.Styles>
        <Style Selector="NumericUpDown.pose"><Setter Property="Margin" Value="0,0,6,0" /></Style>
        <Style Selector="TextBlock.axis">
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.val">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
        <TextBlock Classes="page-title" Text="코봇 장착 보정 (T_A_B)" />
        <TextBlock Classes="page-subtitle" TextWrapping="Wrap"
                   Text="고정 표적 한 점을 서로 다른 AMR 자세에서 코봇으로 터치해 AMR 차체 → 코봇 BASE 변환(T_A_B)을 산출합니다. 이 페이지는 AMR도 코봇도 스스로 움직이지 않습니다 — 이동은 전부 작업자가 합니다." />

        <Border Classes="alert" Classes.info="{Binding !IsError}"
                IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        </Border>

        <!-- ⓪ 준비 상태 -->
        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Classes="cardHead" Text="준비 상태" />
                <WrapPanel>
                    <Border Classes="badge" Classes.on="{Binding AmrConnected}" Classes.off="{Binding !AmrConnected}" Margin="0,0,6,6">
                        <TextBlock Text="AMR 연결" /></Border>
                    <Border Classes="badge" Classes.on="{Binding CobotConnected}" Classes.off="{Binding !CobotConnected}" Margin="0,0,6,6">
                        <TextBlock Text="코봇 연결" /></Border>
                    <Border Classes="badge" Classes.on="{Binding ServoOn}" Classes.off="{Binding !ServoOn}" Margin="0,0,6,6">
                        <TextBlock Text="서보" /></Border>
                    <Border Classes="badge" Classes.on="{Binding IsAmrStationary}" Classes.off="{Binding !IsAmrStationary}" Margin="0,0,6,6">
                        <TextBlock Text="{Binding StationaryText}" /></Border>
                    <Border Classes="badge" Margin="0,0,6,6"><TextBlock Text="{Binding SampleCountText}" /></Border>
                    <Border Classes="badge" Classes.on="{Binding YawSpanOk}" Classes.off="{Binding !YawSpanOk}" Margin="0,0,6,6">
                        <TextBlock Text="{Binding YawSpanText}" /></Border>
                </WrapPanel>
                <TextBlock Text="{Binding NextStepText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Name="JogPopupBtn" Content="코봇 조그 (팝업)" />
                    <TextBlock Classes="axis" VerticalAlignment="Center" Text="{Binding LastSolveText}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ① 표적 정의 -->
        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Classes="cardHead" Text="① 표적 정의" />
                <TextBlock Classes="hint"
                           Text="한 점만 씁니다 — 모든 표본에서 물리적으로 동일한 점을 터치해야 합니다. 바닥에 고정한 센터펀치 자국·원뿔 지그처럼 팁이 재현성 있게 안착하는 점을 쓰세요." />
                <WrapPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Classes="axis" Text="터치 공구(tool) 번호" />
                        <NumericUpDown Value="{Binding Tool}" Minimum="0" Maximum="15" Increment="1" FormatString="0"
                                       IsEnabled="{Binding !Busy}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Classes="axis" Text="표적 높이 q_z (mm)" />
                        <NumericUpDown Value="{Binding TargetQzMm}" Increment="1" FormatString="0.0"
                                       IsEnabled="{Binding !Busy}" />
                    </StackPanel>
                    <CheckBox VerticalAlignment="Bottom" Margin="0,0,12,8"
                              Content="q_z 값을 확인했습니다" IsChecked="{Binding QzConfirmed}" IsEnabled="{Binding !Busy}" />
                    <StackPanel Margin="0,0,6,8">
                        <TextBlock Classes="axis" Text="CAD tz (mm)" />
                        <NumericUpDown Value="{Binding CadTzMm}" Increment="1" FormatString="0.0"
                                       IsEnabled="{Binding !Busy}" />
                    </StackPanel>
                    <Button VerticalAlignment="Bottom" Margin="0,0,0,8"
                            Content="CAD tz 로부터 계산" Command="{Binding ApplyCadTzCommand}"
                            ToolTip.Tip="q_z = CAD tz + 평균 Bz. rx≈ry≈0 가정이므로 초기 추정용입니다." />
                </WrapPanel>
                <Border Classes="alert">
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Text="q_z 는 AMR 차체 좌표계에서 잰 표적 점의 Z 입니다. 차체 원점보다 아래면 음수(예: 바닥 표적 −320 mm). AMR pose 가 평면(x·y·yaw)이라 z 방정식이 q_z 와 tz 를 차이로만 담습니다 — 이 값이 없으면 tz 가 수학적으로 관측되지 않아 T_A_B 의 Z 가 결정되지 않습니다. 추정치라도 반드시 실측 근거를 남기세요." />
                </Border>
            </StackPanel>
        </Border>

        <!-- ② 표본 수집 -->
        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Classes="cardHead" Text="② 표본 수집" />
                <TextBlock Classes="hint"
                           Text="팁이 표적에 물리적으로 닿은 상태에서, AMR 이 완전히 정지한 뒤 캡처하세요. 정밀도는 접촉 정밀도가 지배합니다(±0.5~1.5 mm). AMR 을 밀거나 주행시켜 yaw 를 30° 이상 바꾸고 반복하세요 — 같은 yaw 의 표본은 해에 기여하지 않습니다." />
                <Grid ColumnDefinitions="*,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Classes="axis" Text="AMR 현재 pose (맵 기준)" />
                        <TextBlock Text="{Binding AmrXText, StringFormat='X: {0}'}" />
                        <TextBlock Text="{Binding AmrYText, StringFormat='Y: {0}'}" />
                        <TextBlock Text="{Binding AmrYawText, StringFormat='Yaw: {0}'}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Classes="axis" Text="코봇 TCP (BASE 기준)" />
                        <TextBlock Text="{Binding TcpXText, StringFormat='X: {0}'}" />
                        <TextBlock Text="{Binding TcpYText, StringFormat='Y: {0}'}" />
                        <TextBlock Text="{Binding TcpZText, StringFormat='Z: {0}'}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <CheckBox Content="실시간 읽기" IsChecked="{Binding LiveTcp}" />
                            <Button Content="지금 읽기" Command="{Binding RefreshTcpNowCommand}" />
                        </StackPanel>
                        <TextBlock Classes="axis" Text="{Binding TcpAgeText}" />
                    </StackPanel>
                </Grid>
                <WrapPanel>
                    <Border Classes="badge" Classes.on="{Binding YawGapOk}" Classes.off="{Binding !YawGapOk}" Margin="0,0,6,6">
                        <TextBlock Text="{Binding YawGapText}" /></Border>
                    <TextBlock Classes="axis" VerticalAlignment="Center" Text="{Binding BzSpreadText}" />
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="표본 캡처" Classes="accent" Command="{Binding CaptureSampleCommand}" />
                    <Button Content="전체 삭제" Classes="danger" Command="{Binding ClearSamplesCommand}"
                            IsEnabled="{Binding !Busy}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ③ 표본 목록 -->
        <Border Classes="card">
            <StackPanel Spacing="6">
                <TextBlock Classes="cardHead" Text="③ 표본 목록" />
                <Grid ColumnDefinitions="40,90,90,80,80,80,80,80,Auto">
                    <TextBlock Classes="axis" Text="#" />
                    <TextBlock Grid.Column="1" Classes="axis" Text="AMR X" />
                    <TextBlock Grid.Column="2" Classes="axis" Text="AMR Y" />
                    <TextBlock Grid.Column="3" Classes="axis" Text="Yaw(°)" />
                    <TextBlock Grid.Column="4" Classes="axis" Text="Bx" />
                    <TextBlock Grid.Column="5" Classes="axis" Text="By" />
                    <TextBlock Grid.Column="6" Classes="axis" Text="Bz" />
                    <TextBlock Grid.Column="7" Classes="axis" Text="잔차(mm)" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MountSampleRow">
                            <Grid ColumnDefinitions="40,90,90,80,80,80,80,80,Auto" Margin="0,2">
                                <TextBlock Text="{Binding No}" />
                                <TextBlock Grid.Column="1" Text="{Binding AmrXmm, StringFormat='{}{0:F1}'}" />
                                <TextBlock Grid.Column="2" Text="{Binding AmrYmm, StringFormat='{}{0:F1}'}" />
                                <TextBlock Grid.Column="3" Text="{Binding AmrYawDeg, StringFormat='{}{0:F1}'}" />
                                <TextBlock Grid.Column="4" Text="{Binding Bx, StringFormat='{}{0:F1}'}" />
                                <TextBlock Grid.Column="5" Text="{Binding By, StringFormat='{}{0:F1}'}" />
                                <TextBlock Grid.Column="6" Text="{Binding Bz, StringFormat='{}{0:F1}'}" />
                                <TextBlock Grid.Column="7" Text="{Binding ResidualText}">
                                    <TextBlock.Styles>
                                        <Style Selector="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
                                        </Style>
                                    </TextBlock.Styles>
                                </TextBlock>
                                <Button Grid.Column="8" Content="삭제" Padding="6,2"
                                        Command="{Binding $parent[ItemsControl].((vm:MountCalibrationViewModel)DataContext).RemoveSampleCommand}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Expander Header="수동 표본 입력 (하드웨어 없이 산출 경로 검증용)">
                    <StackPanel Spacing="6" Margin="0,6,0,0">
                        <WrapPanel>
                            <StackPanel><TextBlock Classes="axis" Text="AMR X" /><NumericUpDown Classes="pose" Value="{Binding ManAmrX}" Increment="1" /></StackPanel>
                            <StackPanel><TextBlock Classes="axis" Text="AMR Y" /><NumericUpDown Classes="pose" Value="{Binding ManAmrY}" Increment="1" /></StackPanel>
                            <StackPanel><TextBlock Classes="axis" Text="Yaw" /><NumericUpDown Classes="pose" Value="{Binding ManYaw}" Increment="1" /></StackPanel>
                            <StackPanel><TextBlock Classes="axis" Text="Bx" /><NumericUpDown Classes="pose" Value="{Binding ManBx}" Increment="1" /></StackPanel>
                            <StackPanel><TextBlock Classes="axis" Text="By" /><NumericUpDown Classes="pose" Value="{Binding ManBy}" Increment="1" /></StackPanel>
                            <StackPanel><TextBlock Classes="axis" Text="Bz" /><NumericUpDown Classes="pose" Value="{Binding ManBz}" Increment="1" /></StackPanel>
                            <Button VerticalAlignment="Bottom" Content="추가" Command="{Binding AddManualSampleCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>

        <!-- ④ 해 계산 · 결과 -->
        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Classes="cardHead" Text="④ 해 계산 · 결과" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="해 계산" Classes="accent" Command="{Binding SolveCommand}" />
                    <TextBlock Classes="hint" VerticalAlignment="Center" Text="{Binding SolveBlockedReason}" />
                </StackPanel>

                <StackPanel IsVisible="{Binding Result, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <StackPanel DataContext="{Binding Result}" x:DataType="m:MountCalibrationResult" Spacing="8">
                    <Border Classes="alert" IsVisible="{Binding !Success}">
                        <TextBlock Text="{Binding Error, StringFormat='산출 실패: {0}'}" TextWrapping="Wrap" />
                    </Border>
                    <StackPanel IsVisible="{Binding Success}" Spacing="6">
                        <Grid ColumnDefinitions="*,*,*,*,*,*">
                            <StackPanel Grid.Column="0"><TextBlock Classes="axis" HorizontalAlignment="Center" Text="tx (mm)" /><TextBlock Classes="val" Text="{Binding MountPose[0], StringFormat='{}{0:F1}'}" /></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Classes="axis" HorizontalAlignment="Center" Text="ty (mm)" /><TextBlock Classes="val" Text="{Binding MountPose[1], StringFormat='{}{0:F1}'}" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Classes="axis" HorizontalAlignment="Center" Text="tz (mm)" /><TextBlock Classes="val" Text="{Binding MountPose[2], StringFormat='{}{0:F1}'}" /></StackPanel>
                            <StackPanel Grid.Column="3"><TextBlock Classes="axis" HorizontalAlignment="Center" Text="rx (°)" /><TextBlock Classes="val" Text="{Binding MountPose[3], StringFormat='{}{0:F3}'}" /></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Classes="axis" HorizontalAlignment="Center" Text="ry (°)" /><TextBlock Classes="val" Text="{Binding MountPose[4], StringFormat='{}{0:F3}'}" /></StackPanel>
                            <StackPanel Grid.Column="5"><TextBlock Classes="axis" HorizontalAlignment="Center" Text="rz (°)" /><TextBlock Classes="val" Text="{Binding MountPose[5], StringFormat='{}{0:F3}'}" /></StackPanel>
                        </Grid>
                        <TextBlock Classes="hint" Text="{Binding N, StringFormat='표본 {0}개'}" />
                        <TextBlock Classes="hint">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="RMS {0:F2} mm · 최대 {1:F2} mm · 터치(평면) RMS {2:F2} mm · SLAM(평면내) RMS {3:F1} mm">
                                    <Binding Path="RmsMm" />
                                    <Binding Path="MaxAbsMm" />
                                    <Binding Path="PlaneRmsMm" />
                                    <Binding Path="PlanarRmsMm" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Classes="hint">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="터치점 펼침 {0:F0} mm · Yaw 범위 {1:F0}° · 기울기 추정오차 ±{2:F3}°">
                                    <Binding Path="PlaneSpanMm" />
                                    <Binding Path="YawSpanDeg" />
                                    <Binding Path="TiltSigmaDeg" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Classes="hint" IsVisible="{Binding !TzObserved}"
                                   Text="{Binding PlaneOffsetDmm, StringFormat='tz 미확정 — d = {0:F1} mm 만 산출되었습니다. 표적 높이를 입력하면 재터치 없이 닫힙니다.'}" />
                        <ItemsControl ItemsSource="{Binding Warnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Classes="alert"><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" /></Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ⑤ 적용 · 저장 -->
        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Classes="cardHead" Text="⑤ 적용 · 저장" />
                <TextBlock Classes="axis" Text="T_A_B — AMR 중심 → 코봇 Base (mm/도)" />
                <WrapPanel>
                    <StackPanel><TextBlock Classes="axis" Text="X" /><NumericUpDown Classes="pose" Value="{Binding Mount.V0}" Increment="0.1" /></StackPanel>
                    <StackPanel><TextBlock Classes="axis" Text="Y" /><NumericUpDown Classes="pose" Value="{Binding Mount.V1}" Increment="0.1" /></StackPanel>
                    <StackPanel><TextBlock Classes="axis" Text="Z" /><NumericUpDown Classes="pose" Value="{Binding Mount.V2}" Increment="0.1" /></StackPanel>
                    <StackPanel><TextBlock Classes="axis" Text="Rx" /><NumericUpDown Classes="pose" Value="{Binding Mount.V3}" Increment="0.1" /></StackPanel>
                    <StackPanel><TextBlock Classes="axis" Text="Ry" /><NumericUpDown Classes="pose" Value="{Binding Mount.V4}" Increment="0.1" /></StackPanel>
                    <StackPanel><TextBlock Classes="axis" Text="Rz" /><NumericUpDown Classes="pose" Value="{Binding Mount.V5}" Increment="0.1" /></StackPanel>
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="결과 적용" Command="{Binding ApplyResultCommand}" />
                    <Button Content="T_A_B 저장" Classes="accent" Command="{Binding SaveMountCommand}" />
                    <Button Content="저장값 되돌리기" Command="{Binding ReloadMountCommand}" />
                    <TextBlock Classes="axis" VerticalAlignment="Center" Text="{Binding DirtyText}" />
                </StackPanel>
                <TextBlock Classes="hint"
                           Text="산출값은 자동으로 채워지지 않습니다 — '결과 적용'을 눌러 편집란에 넣고, 필요하면 수치를 직접 보정한 뒤 저장하세요." />
            </StackPanel>
        </Border>

        <Border Classes="alert">
            <TextBlock TextWrapping="Wrap" FontSize="12"
                       Text="이 페이지는 AMR 과 코봇을 스스로 움직이지 않습니다. AMR 이동은 작업자가 직접, 코봇 이동은 조그 팝업에서만 수행하세요. 저장은 이 앱의 설정 DB 에만 기록되며, 코봇 컨트롤러나 HD_ACS 에는 자동으로 쓰지 않습니다." />
        </Border>
    </StackPanel>
</UserControl>
