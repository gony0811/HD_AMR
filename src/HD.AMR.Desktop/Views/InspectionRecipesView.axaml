<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HD.AMR.Desktop.ViewModels"
             x:Class="HD.AMR.Desktop.Views.InspectionRecipesView"
             x:DataType="vm:InspectionRecipesViewModel">
    <StackPanel MaxWidth="1120" HorizontalAlignment="Left">
        <TextBlock Classes="page-title" Text="검사 레시피 관리" />
        <TextBlock Classes="page-subtitle" TextWrapping="Wrap"
                   Text="ACS startWeldInspection 의 (seamType, wall_code) 조합으로 선택되는 검사 타입 17종의 실행 구성입니다. Enabled 는 실기 E2E 검증 후에만 켜세요." />

        <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
            <Button Grid.Column="0" Content="새로고침" Command="{Binding ReloadCommand}" IsEnabled="{Binding !Busy}" />
            <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Classes="muted" Text="{Binding TotalCount, StringFormat='총 {0} 종'}" />
        </Grid>

        <Border Classes="alert" IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        </Border>

        <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RecipeRow">
                    <Border Classes="card" Padding="12" Margin="0,0,0,8">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="Auto,120,*,Auto,120,Auto">
                                <Button Grid.Column="0" Width="30"
                                        Content="{Binding IsExpanded, Converter={x:Static vm:RecipeConverters.Chevron}}"
                                        Command="{Binding $parent[ItemsControl].((vm:InspectionRecipesViewModel)DataContext).ToggleExpandCommand}"
                                        CommandParameter="{Binding}" />
                                <TextBlock Grid.Column="1" Text="{Binding Id}" FontFamily="monospace" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding DisplayName}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <CheckBox Grid.Column="3" IsChecked="{Binding Enabled}" Content="Enabled" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="4" Value="{Binding VisionFailRatioMax}" Increment="0.05" Minimum="0" Maximum="1"
                                               FormatString="0.00" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4">
                                    <Button Content="저장" Classes="accent"
                                            Command="{Binding $parent[ItemsControl].((vm:InspectionRecipesViewModel)DataContext).SaveCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="기본값"
                                            Command="{Binding $parent[ItemsControl].((vm:InspectionRecipesViewModel)DataContext).ResetToDefaultCommand}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>

                            <TextBox Text="{Binding StepKeysJson}" FontFamily="monospace" FontSize="12"
                                     Watermark="StepKeysJson (null = 풀시퀀스)" />

                            <!-- 고급 설정 -->
                            <Border IsVisible="{Binding IsExpanded}" Padding="8" CornerRadius="6"
                                    Background="{DynamicResource CardBorder}">
                                <WrapPanel>
                                    <StackPanel Width="220" Margin="0,0,12,8">
                                        <TextBlock Classes="muted" FontSize="12" Text="접근 자세 티칭 키" />
                                        <TextBox Text="{Binding ApproachTeachingKey}" FontFamily="monospace" Watermark="(빈 값 = 스텝 기본)" />
                                    </StackPanel>
                                    <StackPanel Width="150" Margin="0,0,12,8">
                                        <TextBlock Classes="muted" FontSize="12" Text="Standoff 폴백 [mm]" />
                                        <NumericUpDown Value="{Binding DefaultStandoffMm}" Increment="10" Minimum="0" FormatString="0" />
                                    </StackPanel>
                                    <StackPanel Width="170" Margin="0,0,12,8">
                                        <TextBlock Classes="muted" FontSize="12" Text="카메라 목표거리 [mm]" />
                                        <NumericUpDown Value="{Binding CameraTargetDistanceMm}" Increment="10" Minimum="0" FormatString="0" />
                                    </StackPanel>
                                    <StackPanel Width="170" Margin="0,0,12,8">
                                        <TextBlock Classes="muted" FontSize="12" Text="Surface 강제" />
                                        <ComboBox SelectedIndex="{Binding SurfaceIndex}" HorizontalAlignment="Stretch">
                                            <ComboBoxItem>자동(|θ| 판정)</ComboBoxItem>
                                            <ComboBoxItem>0 · Flat</ComboBoxItem>
                                            <ComboBoxItem>1 · Corner</ComboBoxItem>
                                            <ComboBoxItem>2 · Corrugation</ComboBoxItem>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Width="130" Margin="0,0,12,8">
                                        <TextBlock Classes="muted" FontSize="12" Text="정렬 재시도" />
                                        <NumericUpDown Value="{Binding AlignRetryCount}" Increment="1" Minimum="0" FormatString="0" />
                                    </StackPanel>
                                    <TextBlock Classes="muted" FontSize="12" Width="700"
                                               Text="{Binding SeamType, StringFormat='seamType={0} · 세부값 편집 후 저장을 누르세요.'}" />
                                </WrapPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Classes="muted" HorizontalAlignment="Center" Margin="0,10"
                   Text="레시피가 없습니다 — 앱 재기동 시 자동 시드됩니다."
                   IsVisible="{Binding Rows.Count, Converter={x:Static vm:CountConverters.IsZero}}" />
    </StackPanel>
</UserControl>
