<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HD.AMR.Desktop.ViewModels"
             x:Class="HD.AMR.Desktop.Views.InspectionRecipesView"
             x:DataType="vm:InspectionRecipesViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.section"><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,4" /></Style>
        <Style Selector="TextBlock.hint"><Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" /><Setter Property="FontSize" Value="12" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
        <Style Selector="TextBlock.warn"><Setter Property="Foreground" Value="{DynamicResource AppWarnFgBrush}" /><Setter Property="FontSize" Value="11" /></Style>
        <Style Selector="ListBox.recipes ListBoxItem"><Setter Property="Padding" Value="10,6" /></Style>
    </UserControl.Styles>

    <StackPanel MaxWidth="1400" HorizontalAlignment="Left">
        <TextBlock Classes="page-title" Text="검사 레시피 관리" />
        <TextBlock Classes="page-subtitle" TextWrapping="Wrap"
                   Text="ACS startWeldInspection 의 (seamType, wall_code) 조합으로 선택되는 검사 타입 17종의 실행 구성입니다. 왼쪽에서 레시피를 선택해 설정하고 저장하세요. Enabled 는 실기 E2E 검증 후에만 켜세요." />

        <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
            <Button Grid.Column="0" Content="새로고침" Command="{Binding ReloadCommand}" IsEnabled="{Binding !Busy}"
                    ToolTip.Tip="DB 에서 다시 읽습니다 — 저장하지 않은 편집(● 미저장)은 사라집니다." />
            <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Classes="muted" Text="{Binding TotalCount, StringFormat='총 {0} 종'}" />
        </Grid>

        <Border Classes="alert" Margin="0,0,0,8" IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        </Border>

        <Grid ColumnDefinitions="300,*">
            <!-- 좌: 레시피 목록 -->
            <Border Grid.Column="0" Classes="card" Padding="6" Margin="0,0,12,12" VerticalAlignment="Top">
                <ListBox Classes="recipes" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:RecipeRow">
                            <StackPanel Spacing="3">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Id}" FontFamily="monospace" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="● 미저장" Classes="warn" VerticalAlignment="Center"
                                               IsVisible="{Binding IsDirty}" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Classes="badge" Classes.on="{Binding Enabled}" Classes.off="{Binding !Enabled}" Padding="8,1">
                                        <Panel>
                                            <TextBlock FontSize="11" Text="ON" IsVisible="{Binding Enabled}" />
                                            <TextBlock FontSize="11" Text="OFF" IsVisible="{Binding !Enabled}" />
                                        </Panel>
                                    </Border>
                                    <TextBlock Classes="warn" VerticalAlignment="Center" Text="⚠ 프로필 미지정"
                                               IsVisible="{Binding ProfileMissing}" />
                                    <TextBlock Classes="muted" FontSize="11" VerticalAlignment="Center" Text="{Binding StepSummary}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- 우: 선택 레시피 상세 -->
            <StackPanel Grid.Column="1">
                <Border Classes="alert info" Margin="0" IsVisible="{Binding !HasSelection}">
                    <TextBlock Text="왼쪽에서 레시피를 선택하세요." />
                </Border>

                <Border Classes="card" IsVisible="{Binding HasSelection}">
                    <ContentControl Content="{Binding SelectedRow}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate x:DataType="vm:RecipeRow">
                                <StackPanel Spacing="14">
                                    <!-- 헤더 -->
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Id}" FontFamily="monospace" FontSize="20" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" />
                                        <TextBlock Classes="hint" Text="{Binding SeamOrientationText}" />
                                    </StackPanel>

                                    <!-- 실행 허용 -->
                                    <StackPanel>
                                        <TextBlock Classes="section" Text="실행 허용" />
                                        <CheckBox IsChecked="{Binding Enabled}" Content="Enabled" />
                                        <TextBlock Classes="hint" Text="꺼져 있으면 이 레시피로 매핑된 ACS 액션은 FAILED + inspectionFailed 로 보고됩니다. 실기 E2E 검증 후에만 켜세요." />
                                    </StackPanel>

                                    <!-- 티칭 프로필 -->
                                    <StackPanel>
                                        <TextBlock Classes="section" Text="티칭 프로필 (경유점)" />
                                        <ComboBox MinWidth="360" HorizontalAlignment="Left"
                                                  IsVisible="{Binding CanPickProfile}"
                                                  ItemsSource="{Binding ProfileOptions}" SelectedItem="{Binding SelectedProfile}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ProfileOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Classes="hint" IsVisible="{Binding CanPickProfile}"
                                                   Text="검사 프로파일 페이지에서 저장한 같은 타입 프로필만 표시됩니다. 미지정이면 ACS 액션이 FAILED 입니다." />
                                        <TextBlock Classes="hint" IsVisible="{Binding IsCorner3}"
                                                   Text="CORNER3 는 고정 티칭 슬롯(corner3.L/R.*)을 순회하므로 프로필을 지정하지 않습니다." />
                                    </StackPanel>

                                    <!-- 실행 스텝 — 시퀀스 풀에서 끌어오기 -->
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Classes="section" Text="실행 스텝" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                <Button Content="전체 담기" FontSize="12" Padding="8,2" Command="{Binding AddAllStepsCommand}" />
                                                <Button Content="비우기 (풀시퀀스)" FontSize="12" Padding="8,2" Command="{Binding ClearStepsCommand}" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,12,*">
                                            <!-- 좌: 시퀀스 풀 -->
                                            <StackPanel Grid.Column="0" Spacing="3">
                                                <TextBlock Classes="hint" Text="시퀀스 풀 — 담을 스텝 (＋)" />
                                                <Border Classes="card" Padding="2">
                                                    <ListBox ItemsSource="{Binding StepPool}" Background="Transparent" MaxHeight="300">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:StepPick">
                                                                <Grid ColumnDefinitions="34,*,Auto" ToolTip.Tip="{Binding Key}">
                                                                    <TextBlock Grid.Column="0" Classes="hint" Text="{Binding OrderText}" VerticalAlignment="Center" />
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                                                        <TextBlock Classes="hint" FontFamily="monospace" Text="{Binding Key}" />
                                                                    </StackPanel>
                                                                    <Button Grid.Column="2" Content="＋" Padding="8,0" VerticalAlignment="Center"
                                                                            ToolTip.Tip="이 레시피에 담기"
                                                                            Command="{Binding $parent[ListBox].((vm:RecipeRow)DataContext).AddStepCommand}"
                                                                            CommandParameter="{Binding}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </Border>
                                            </StackPanel>

                                            <!-- 우: 이 레시피가 실행할 스텝 -->
                                            <StackPanel Grid.Column="2" Spacing="3">
                                                <TextBlock Classes="hint" Text="이 레시피에서 실행 (－ 로 빼기)" />
                                                <Border Classes="card" Padding="2">
                                                    <Panel MinHeight="60">
                                                        <ListBox ItemsSource="{Binding SelectedSteps}" Background="Transparent" MaxHeight="300">
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:StepPick">
                                                                    <Grid ColumnDefinitions="34,*,Auto" ToolTip.Tip="{Binding Key}">
                                                                        <TextBlock Grid.Column="0" Classes="hint" Text="{Binding OrderText}" VerticalAlignment="Center" />
                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                                                            <TextBlock Classes="hint" FontFamily="monospace" Text="{Binding Key}" />
                                                                        </StackPanel>
                                                                        <Button Grid.Column="2" Content="－" Padding="8,0" VerticalAlignment="Center"
                                                                                ToolTip.Tip="이 레시피에서 빼기"
                                                                                Command="{Binding $parent[ListBox].((vm:RecipeRow)DataContext).RemoveStepCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                        <TextBlock Classes="hint" Margin="8" VerticalAlignment="Center" TextWrapping="Wrap"
                                                                   IsVisible="{Binding IsFullSequence}"
                                                                   Text="비어 있음 = 등록된 스텝 전체를 순서대로 실행합니다(풀시퀀스). 일부만 실행하려면 왼쪽에서 ＋ 로 담으세요." />
                                                    </Panel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Classes="hint" Text="왼쪽 숫자는 실행 순서입니다. 담는 순서는 실행 순서에 영향을 주지 않습니다 — 런타임은 언제나 이 번호 순으로 실행합니다(스텝 간 선후 의존을 이 번호가 보장합니다)." />
                                        <Expander Header="저장값 보기 (StepKeysJson)">
                                            <TextBox Text="{Binding StepKeysJson, Mode=OneWay}" IsReadOnly="True"
                                                     FontFamily="monospace" FontSize="12" AcceptsReturn="True" TextWrapping="Wrap"
                                                     Watermark="null — 풀시퀀스 전체 실행" />
                                        </Expander>
                                    </StackPanel>

                                    <!-- 비전 실패율 상한 / 카메라 목표거리 -->
                                    <WrapPanel>
                                        <StackPanel Width="260" Margin="0,0,24,0">
                                            <TextBlock Classes="section" Text="비전 실패율 상한" />
                                            <NumericUpDown Width="170" HorizontalAlignment="Left" Value="{Binding VisionFailRatioMax}"
                                                           Increment="0.05" Minimum="0" Maximum="1" FormatString="0.00" />
                                            <TextBlock Classes="hint" Text="0~1. 초과 시 액션 FAILED · 1.0 = 판정 안 함" />
                                        </StackPanel>
                                        <StackPanel Width="300">
                                            <TextBlock Classes="section" Text="카메라 목표거리 [mm]" />
                                            <NumericUpDown Width="170" HorizontalAlignment="Left" Value="{Binding CameraTargetDistanceMm}"
                                                           Increment="10" Minimum="0" FormatString="0" />
                                            <TextBlock Classes="hint" Text="③ 카메라 거리 정렬 목표 (빈 값 = 400, ACS workingDistanceMm 미사용)" />
                                        </StackPanel>
                                    </WrapPanel>

                                    <!-- 버튼 -->
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="저장" Classes="accent"
                                                Command="{Binding $parent[UserControl].((vm:InspectionRecipesViewModel)DataContext).SaveCommand}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="기본값"
                                                ToolTip.Tip="코드 기본값(시드)으로 되돌립니다 — Enabled·StepKeysJson·실패율·카메라 거리. 티칭 프로필 지정은 유지됩니다."
                                                Command="{Binding $parent[UserControl].((vm:InspectionRecipesViewModel)DataContext).ResetToDefaultCommand}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Border>
            </StackPanel>
        </Grid>

        <TextBlock Classes="muted" HorizontalAlignment="Center" Margin="0,10"
                   Text="레시피가 없습니다 — 앱 재기동 시 자동 시드됩니다."
                   IsVisible="{Binding Rows.Count, Converter={x:Static vm:CountConverters.IsZero}}" />
    </StackPanel>
</UserControl>
