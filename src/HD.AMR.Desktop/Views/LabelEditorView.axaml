<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HD.AMR.Desktop.ViewModels"
             xmlns:views="using:HD.AMR.Desktop.Views"
             x:Class="HD.AMR.Desktop.Views.LabelEditorView"
             x:DataType="vm:LabelEditorViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.axis"><Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" /><Setter Property="FontSize" Value="12" /></Style>
    </UserControl.Styles>

    <StackPanel MaxWidth="1200" HorizontalAlignment="Left">
        <TextBlock Classes="page-title" Text="비드 라벨링 (DL 학습용 · 면/선)" />

        <Border Classes="alert" IsVisible="{Binding !HasDir}">
            <StackPanel Spacing="6">
                <TextBlock TextWrapping="Wrap" Text="라벨링 폴더가 없습니다. 폴더를 선택하거나 Camera 페이지에서 캡처 저장 폴더를 지정하세요." />
                <Button Name="PickDirBtn2" Content="📁 폴더 선택…" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>

        <StackPanel IsVisible="{Binding HasDir}">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                <TextBlock Classes="axis" VerticalAlignment="Center" Text="{Binding Dir, StringFormat='폴더: {0}'}" />
                <Button Name="PickDirBtn" Content="📁 폴더 선택…" IsEnabled="{Binding !Busy}" />
                <Button Content="캡처 폴더로" Command="{Binding UseCaptureDirCommand}" IsEnabled="{Binding !Busy}"
                        ToolTip.Tip="라벨링 폴더를 Camera 의 캡처 저장 폴더로 되돌립니다." />
                <Button Content="새로고침" Command="{Binding RefreshListCommand}" IsEnabled="{Binding !Busy}" />
            </StackPanel>

            <Grid ColumnDefinitions="260,*">
                <!-- 좌: 촬영본 목록 -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TabStrip SelectedIndex="{Binding ModalityTab}" Margin="0,0,0,4">
                        <TabStripItem Content="{Binding IrTabText}" />
                        <TabStripItem Content="{Binding RgbTabText}" />
                    </TabStrip>
                    <TextBlock Classes="axis" Text="{Binding ListTitle}" />
                    <ListBox ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected}" Height="520" FontFamily="monospace" FontSize="12">
                        <ListBox.ItemTemplate><DataTemplate x:DataType="vm:CaptureEntryRow"><TextBlock Text="{Binding Label}" /></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Classes="axis" Text="▦ = 면 라벨 · 📏 = 선 라벨 (선택한 탭 기준)" />
                </StackPanel>

                <!-- 우: 에디터 -->
                <StackPanel Grid.Column="1">
                    <Border Classes="alert" IsVisible="{Binding !HasSelection}"><TextBlock Text="왼쪽에서 촬영본을 선택하세요." /></Border>
                    <StackPanel IsVisible="{Binding HasSelection}" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox Width="110" SelectedIndex="{Binding KindIndex}" ToolTip.Tip="면·선 라벨은 따로 저장됩니다(_area.png / _line.json).">
                                <ComboBoxItem>▦ 면 라벨</ComboBoxItem><ComboBoxItem>📏 선 라벨</ComboBoxItem>
                            </ComboBox>
                            <ComboBox Width="110" SelectedIndex="{Binding BrushModeIndex}" IsVisible="{Binding IsBrushMode}">
                                <ComboBoxItem>🖌 칠하기</ComboBoxItem><ComboBoxItem>🧽 지우기</ComboBoxItem>
                            </ComboBox>
                            <TextBlock Classes="axis" VerticalAlignment="Center" IsVisible="{Binding IsBrushMode}" Text="{Binding Radius, StringFormat='굵기 {0}'}" />
                            <Slider Width="140" Minimum="2" Maximum="60" IsVisible="{Binding IsBrushMode}" Value="{Binding Radius}" />
                            <TextBlock Classes="axis" VerticalAlignment="Center" IsVisible="{Binding IsLineMode}" Text="{Binding LineThickness, StringFormat='선 두께 {0}px'}" />
                            <Slider Width="140" Minimum="3" Maximum="31" TickFrequency="1" IsSnapToTickEnabled="True" IsVisible="{Binding IsLineMode}" Value="{Binding LineThickness}" />
                            <Button Content="다시 불러오기" Command="{Binding ReloadDraftCommand}" />
                            <Button Content="전체 지우기" Command="{Binding ClearMaskCommand}" />
                            <Button Name="SaveBtn" Content="{Binding SaveButtonText}" Classes="accent" IsEnabled="{Binding !Busy}" />
                        </StackPanel>
                        <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Background="Black">
                            <views:MaskCanvas Name="Mask" Height="480" Cursor="Cross" />
                        </Border>
                        <TextBlock Classes="axis" TextWrapping="Wrap" Text="{Binding SaveHint}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>

        <Border Classes="alert" Margin="0,10,0,0" IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        </Border>
    </StackPanel>
</UserControl>
