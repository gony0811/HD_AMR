<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HD.AMR.Desktop.ViewModels"
             x:Class="HD.AMR.Desktop.Views.InspectionMapView"
             x:DataType="vm:InspectionMapViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.axis"><Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" /><Setter Property="FontSize" Value="12" /></Style>
        <Style Selector="TextBlock.cell"><Setter Property="FontSize" Value="12" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
        <Style Selector="Border.mapcell"><Setter Property="CornerRadius" Value="4" /><Setter Property="Padding" Value="6,3" /><Setter Property="Margin" Value="2" /><Setter Property="HorizontalAlignment" Value="Left" /></Style>
    </UserControl.Styles>
    <UserControl.Resources>
        <DataTemplate x:Key="MapCellTpl" x:DataType="vm:MapCell">
            <Border Classes="badge mapcell" Classes.on="{Binding Enabled}" Classes.off="{Binding !Enabled}">
                <TextBlock Text="{Binding Label}" FontSize="11" />
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel MaxWidth="1150" HorizontalAlignment="Left">
        <TextBlock Classes="page-title" Text="검사 매핑 요약" />
        <TextBlock Classes="page-subtitle" TextWrapping="Wrap"
                   Text="ACS startWeldInspection 한 건은 두 축이 합쳐져 실행됩니다 — 어떻게(레시피: seamType×wall_code) + 어디를(경유점: sectionDxfId → 도면 → 최신 티칭 프로필). 둘 중 하나라도 없으면 FAILED. CORNER3 는 고정 티칭 슬롯(corner3.*)을 순회하므로 도면 티칭이 필요 없습니다." />

        <Border Classes="alert" IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        </Border>
        <Button Content="새로고침" Command="{Binding ReloadCommand}" IsEnabled="{Binding !Busy}" HorizontalAlignment="Left" Margin="0,0,0,8" />

        <!-- ① wall_code × seamType → 레시피 -->
        <Border Classes="card">
            <StackPanel Spacing="4">
                <TextBlock Text="① wall_code × seamType → 레시피 (§8.5.1)" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="70,150,*,*,*,*,*">
                    <TextBlock Grid.Column="0" Text="wall_code" Classes="axis" />
                    <TextBlock Grid.Column="1" Text="면" Classes="axis" />
                    <TextBlock Grid.Column="2" Text="LINE" Classes="axis" />
                    <TextBlock Grid.Column="3" Text="CROSS3" Classes="axis" />
                    <TextBlock Grid.Column="4" Text="CROSS4" Classes="axis" />
                    <TextBlock Grid.Column="5" Text="CORNER2" Classes="axis" />
                    <TextBlock Grid.Column="6" Text="CORNER3" Classes="axis" />
                </Grid>
                <ItemsControl ItemsSource="{Binding MapRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WallMapRow">
                            <Grid ColumnDefinitions="70,150,*,*,*,*,*">
                                <TextBlock Grid.Column="0" Classes="cell" FontFamily="monospace" Text="{Binding Code}" />
                                <TextBlock Grid.Column="1" Classes="cell" Text="{Binding Label}" />
                                <ContentControl Grid.Column="2" Content="{Binding Line}" ContentTemplate="{StaticResource MapCellTpl}" />
                                <ContentControl Grid.Column="3" Content="{Binding Cross3}" ContentTemplate="{StaticResource MapCellTpl}" />
                                <ContentControl Grid.Column="4" Content="{Binding Cross4}" ContentTemplate="{StaticResource MapCellTpl}" />
                                <ContentControl Grid.Column="5" Content="{Binding Corner2}" ContentTemplate="{StaticResource MapCellTpl}" />
                                <ContentControl Grid.Column="6" Content="{Binding Corner3}" ContentTemplate="{StaticResource MapCellTpl}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="axis" TextWrapping="Wrap" Text="초록 = 실행 활성(Enabled) · 회색 = 매핑되나 Disabled(→ FAILED+inspectionFailed) · CORNER 의 L/R 은 옆면(P*=좌현/S*=우현) 기준 거울 판별." />
            </StackPanel>
        </Border>

        <!-- ② 레시피 카탈로그 상태 -->
        <Border Classes="card">
            <StackPanel Spacing="4">
                <TextBlock Text="② 레시피 카탈로그 상태" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="130,80,90,80,*">
                    <TextBlock Grid.Column="0" Text="레시피 ID" Classes="axis" />
                    <TextBlock Grid.Column="1" Text="seamType" Classes="axis" />
                    <TextBlock Grid.Column="2" Text="면자세" Classes="axis" />
                    <TextBlock Grid.Column="3" Text="실행" Classes="axis" />
                    <TextBlock Grid.Column="4" Text="경유점 소스" Classes="axis" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Recipes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RecipeStatusRow">
                            <Grid ColumnDefinitions="130,80,90,80,*" Margin="0,2">
                                <TextBlock Grid.Column="0" Classes="cell" FontFamily="monospace" Text="{Binding Id}" />
                                <TextBlock Grid.Column="1" Classes="cell" Text="{Binding SeamType}" />
                                <TextBlock Grid.Column="2" Classes="cell" Text="{Binding Orientation}" />
                                <Border Grid.Column="3" Classes="badge mapcell" Classes.on="{Binding Enabled}" Classes.off="{Binding !Enabled}">
                                    <TextBlock Text="{Binding Enabled, Converter={x:Static vm:BoolTextConverters.EnabledText}}" FontSize="11" />
                                </Border>
                                <TextBlock Grid.Column="4" Classes="cell axis" Text="{Binding Source}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="axis" Text="레시피가 없습니다 — 앱 재기동 시 자동 시드됩니다." HorizontalAlignment="Center"
                           IsVisible="{Binding Recipes.Count, Converter={x:Static vm:CountConverters.IsZero}}" />
            </StackPanel>
        </Border>

        <!-- ③ 티칭 프로필 현황 -->
        <Border Classes="card">
            <StackPanel Spacing="4">
                <TextBlock Text="③ 티칭 프로필(경유점) 현황" FontWeight="SemiBold" />
                <TextBlock Classes="axis" TextWrapping="Wrap" Text="LINE/CROSS 검사는 레시피 SeamType 과 일치하는 최신 티칭 프로필의 경유점을 사용합니다(도면 무관). 티칭 없음 또는 경유점 0 이면 FAILED+inspectionFailed." />
                <Grid ColumnDefinitions="180,90,70,140,110,150">
                    <TextBlock Grid.Column="0" Text="프로필" Classes="axis" />
                    <TextBlock Grid.Column="1" Text="타입" Classes="axis" />
                    <TextBlock Grid.Column="2" Text="경유점" Classes="axis" />
                    <TextBlock Grid.Column="3" Text="티칭 시각(UTC)" Classes="axis" />
                    <TextBlock Grid.Column="4" Text="상태" Classes="axis" />
                    <TextBlock Grid.Column="5" Text="연결 도면(구)" Classes="axis" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Teaching}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TeachingRow">
                            <Grid ColumnDefinitions="180,90,70,140,110,150" Margin="0,2">
                                <TextBlock Grid.Column="0" Classes="cell" Text="{Binding ProfileName}" />
                                <TextBlock Grid.Column="1" Classes="cell" Text="{Binding SeamType}" />
                                <TextBlock Grid.Column="2" Classes="cell" Text="{Binding WaypointCount}" />
                                <TextBlock Grid.Column="3" Classes="cell axis" Text="{Binding TaughtAt}" />
                                <Border Grid.Column="4" Classes="badge mapcell" Classes.on="{Binding Runnable}" Classes.off="{Binding !Runnable}">
                                    <TextBlock Text="{Binding Status}" FontSize="11" />
                                </Border>
                                <TextBlock Grid.Column="5" Classes="cell axis" Text="{Binding DrawingName}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="axis" Text="저장된 티칭 프로필이 없습니다 — 검사 포인트(X-Y) 페이지에서 교시 후 표시됩니다." HorizontalAlignment="Center"
                           IsVisible="{Binding Teaching.Count, Converter={x:Static vm:CountConverters.IsZero}}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
