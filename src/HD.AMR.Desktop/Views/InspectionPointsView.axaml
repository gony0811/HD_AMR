<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HD.AMR.Desktop.ViewModels"
             xmlns:ent="using:HD.AMR.App.Data.Entities"
             xmlns:views="using:HD.AMR.Desktop.Views"
             x:Class="HD.AMR.Desktop.Views.InspectionPointsView"
             x:DataType="vm:InspectionPointsViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.axis"><Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" /><Setter Property="FontSize" Value="12" /></Style>
        <Style Selector="NumericUpDown.cell"><Setter Property="Margin" Value="1,0" /></Style>
    </UserControl.Styles>

    <StackPanel MaxWidth="1400" HorizontalAlignment="Left">
        <TextBlock Classes="page-title" Text="검사 포인트 티칭 (X-Y 평면)" />
        <TextBlock Classes="page-subtitle" TextWrapping="Wrap"
                   Text="X-Y=검사평면, Z=검사면 법선(카메라 WD). 굴곡면은 코봇을 검사 자세로 조그한 뒤 '현재 자세 캡처'로 Rx/Ry/Z 실측을 담으세요." />

        <Border Classes="alert" IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        </Border>
        
                <!-- 코봇 실행 -->
        <Border Classes="card" Margin="0,10,0,0">
            <StackPanel Spacing="8">
                <TextBlock Text="코봇 실행 (작업물 좌표계, pose=[X,Y,Z])" FontWeight="SemiBold" />
                <Border Classes="alert" IsVisible="{Binding !CobotConnected}"><TextBlock Text="⚠ 코봇 RPC 미연결." /></Border>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <StackPanel><TextBlock Classes="axis" Text="공구(tool)" /><NumericUpDown Value="{Binding RunTool}" Minimum="0" Maximum="15" Increment="1" FormatString="0" /></StackPanel>
                    <StackPanel><TextBlock Classes="axis" Text="작업물(user)" /><NumericUpDown Value="{Binding RunUser}" Minimum="0" Maximum="14" Increment="1" FormatString="0" /></StackPanel>
                    <StackPanel><TextBlock Classes="axis" Text="속도(%)" /><NumericUpDown Value="{Binding RunVel}" Minimum="1" Maximum="100" Increment="1" FormatString="0" /></StackPanel>
                    <StackPanel><TextBlock Classes="axis" Text="정착 대기(초)" /><NumericUpDown Value="{Binding SettleSec}" Minimum="0" Increment="0.1" FormatString="0.0" /></StackPanel>
                    <Button VerticalAlignment="Bottom" Content="실행" Classes="accent" Command="{Binding RunPointsCommand}" IsEnabled="{Binding CobotConnected}" />
                    <Button VerticalAlignment="Bottom" Content="■ 정지" Classes="danger" Command="{Binding StopRunCommand}" IsEnabled="{Binding IsRunning}" />
                </StackPanel>
                <TextBlock Text="{Binding RunMsg}" IsVisible="{Binding RunMsg, Converter={x:Static ObjectConverters.IsNotNull}}"
                           Foreground="{Binding RunErr, Converter={x:Static vm:OkErrConverters.Brush}}" />
            </StackPanel>
        </Border>

        <!-- 프로필 -->
        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Text="프로필 저장 / 불러오기" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal">
                    <TextBox Width="220" Classes="axis" Watermark="프로필 이름" Text="{Binding ProfileName}" />
                    <Button VerticalAlignment="Bottom" Content="저장" Classes="accent" Command="{Binding SaveProfileCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <StackPanel>
                        <TextBlock Classes="axis" Text="저장된 프로필" />
                        <ComboBox Width="280" ItemsSource="{Binding Profiles}" SelectedValue="{Binding SelectedProfileId}" SelectedValueBinding="{Binding Id}">
                            <ComboBox.ItemTemplate><DataTemplate x:DataType="ent:InspectionProfile"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <Button VerticalAlignment="Bottom" Content="불러오기" Command="{Binding LoadSelectedCommand}" />
                    <Button VerticalAlignment="Bottom" Content="삭제" Command="{Binding DeleteSelectedCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- CSV -->
        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Text="경유점 CSV 내보내기 / 불러오기" FontWeight="SemiBold" />
                <TextBlock Classes="axis" TextWrapping="Wrap"
                           Text="열: X_mm, Y_mm, Z_mm(WD), Rx_deg, Ry_deg, Rz_deg, Surface(0/1/2). 불러오기는 현재 목록을 덮어씁니다." />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Name="ExportBtn" Content="⭳ 내보내기" />
                    <Button Name="TemplateBtn" Content="템플릿 다운로드" />
                    <Button Name="ImportBtn" Content="불러오기…" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding CsvMsg}"
                               IsVisible="{Binding CsvMsg, Converter={x:Static ObjectConverters.IsNotNull}}"
                               Foreground="{Binding CsvErr, Converter={x:Static vm:OkErrConverters.Brush}}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 타입/FOV/Z -->
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,8">
            <StackPanel><TextBlock Classes="axis" Text="검사 타입" />
                <ComboBox Width="210" SelectedIndex="{Binding SeamTypeIndex}">
                    <ComboBoxItem>LINE (직선)</ComboBoxItem><ComboBoxItem>CROSS4 (4갈래)</ComboBoxItem>
                    <ComboBoxItem>CROSS3 (3갈래)</ComboBoxItem><ComboBoxItem>CORNER2</ComboBoxItem><ComboBoxItem>CORNER3</ComboBoxItem>
                </ComboBox></StackPanel>
            <StackPanel><TextBlock Classes="axis" Text="FOV(mm)" /><NumericUpDown Value="{Binding FovMm}" Minimum="1" Increment="1" FormatString="0" /></StackPanel>
            <StackPanel><TextBlock Classes="axis" Text="기본 Z(WD, mm)" /><NumericUpDown Value="{Binding DefaultZ}" Increment="1" FormatString="0" /></StackPanel>
            
            
            
        </StackPanel>
        

        <StackPanel Spacing="10">
            <!-- 캔버스 -->
            <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource AppCanvasBrush}">
                <views:XyPlot Name="Plot" Height="440" />
            </Border>

            <!-- 포인트 표 -->
            <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                    <Button Content="＋ 추가" Classes="accent" Command="{Binding AddPointCommand}" IsEnabled="{Binding !IsRunning}" />
                    <Button Content="◉ 현재 자세 캡처" Command="{Binding CaptureCurrentPoseCommand}" IsEnabled="{Binding CobotConnected}" />
                    <Button Content="선택점 갱신" Command="{Binding CaptureIntoSelectedCommand}" IsEnabled="{Binding CobotConnected}" />
                    <Button Content="십자 채우기" Command="{Binding FillCrossPatternCommand}" IsVisible="{Binding IsCross}" IsEnabled="{Binding !IsRunning}" />
                    <TextBlock Classes="axis" VerticalAlignment="Center" Text="{Binding PointCount, StringFormat='{}{0} 점'}" />
                </StackPanel>

                <Grid ColumnDefinitions="30,155,155,155,155,155,155,110,Auto" Margin="0,0,0,5">
                    <TextBlock Grid.Column="0" Text="#" Classes="axis" />
                    <TextBlock Grid.Column="1" Text="X" Classes="axis" />
                    <TextBlock Grid.Column="2" Text="Y" Classes="axis" />
                    <TextBlock Grid.Column="3" Text="Z(WD)" Classes="axis" />
                    <TextBlock Grid.Column="4" Text="Rx°" Classes="axis" />
                    <TextBlock Grid.Column="5" Text="Ry°(θ)" Classes="axis" />
                    <TextBlock Grid.Column="6" Text="Rz°" Classes="axis" />
                    <TextBlock Grid.Column="7" Text="Surf" Classes="axis" />
                    <TextBlock Grid.Column="8" Text="" />
                </Grid>
                <ListBox ItemsSource="{Binding Points}" SelectedIndex="{Binding Selected}" MaxHeight="360"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem"><Setter Property="Padding" Value="2" /><Setter Property="MinHeight" Value="0" /></Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:XyPointVm">
                            <Grid ColumnDefinitions="30,155,155,155,155,155,155,110,Auto">
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding Index}" />
                                <NumericUpDown Grid.Column="1" Classes="cell" Value="{Binding X}" Increment="0.1" FormatString="0.###" />
                                <NumericUpDown Grid.Column="2" Classes="cell" Value="{Binding Y}" Increment="0.1" FormatString="0.###" />
                                <NumericUpDown Grid.Column="3" Classes="cell" Value="{Binding Z}" Increment="0.1" FormatString="0.###" />
                                <NumericUpDown Grid.Column="4" Value="{Binding Rx}" Increment="1" FormatString="0.###" />
                                <NumericUpDown Grid.Column="5" Value="{Binding Theta}" Increment="1" FormatString="0.###" />
                                <NumericUpDown Grid.Column="6" Value="{Binding Rz}" Increment="1" FormatString="0.###" />
                                <ComboBox Grid.Column="7" Width="86" SelectedIndex="{Binding Surface}">
                                    <ComboBoxItem>Flat</ComboBoxItem><ComboBoxItem>Corner</ComboBoxItem><ComboBoxItem>Corrugation</ComboBoxItem>
                                </ComboBox>
                                <StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="5">
                                    <Button Content="이동" Command="{Binding $parent[ItemsControl].((vm:InspectionPointsViewModel)DataContext).MoveToPointCommand}" CommandParameter="{Binding}" />
                                    <Button Content="－" Command="{Binding $parent[ItemsControl].((vm:InspectionPointsViewModel)DataContext).RemovePointCommand}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </StackPanel>


    </StackPanel>
</UserControl>
