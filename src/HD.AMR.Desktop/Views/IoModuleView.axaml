<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HD.AMR.Desktop.ViewModels"
             x:Class="HD.AMR.Desktop.Views.IoModuleView"
             x:DataType="vm:IoModuleViewModel">
    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
        <TextBlock Classes="page-title" Text="IO Module" />
        <TextBlock Classes="page-subtitle" Text="LS산전 IO Module — 접점 모니터링 / 출력 제어" />

        <!-- 통신 연결 -->
        <Border Classes="card">
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="통신 연결 (ModbusTCP)" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Classes="badge" Classes.on="{Binding IsConnected}" Classes.off="{Binding !IsConnected}">
                        <TextBlock Text="{Binding IsConnected, Converter={x:Static vm:BoolTextConverters.Connection}}" />
                    </Border>
                </Grid>
                <TextBlock Classes="muted" FontSize="12" Text="{Binding ConnectionSummary}" TextWrapping="Wrap" />
                <TextBlock Classes="muted" FontSize="12" Text="{Binding AdapterLedSummary, StringFormat='어댑터 LED: {0}'}"
                           IsVisible="{Binding AdapterLedSummary, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Classes="muted" FontSize="12" Text="{Binding LastUpdateText}" />
                <Border Classes="alert" IsVisible="{Binding LastError, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Text="{Binding LastError, StringFormat='통신 오류: {0}'}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>

        <!-- 입력 접점 -->
        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="입력 접점" FontWeight="SemiBold" />
                <TextBlock Classes="muted" FontSize="12"
                           Text="{Binding PointMapNote}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Inputs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:IoBit">
                            <Border Classes="badge" Classes.on="{Binding On}" Classes.off="{Binding !On}"
                                    Classes.unassigned="{Binding !Assigned}"
                                    MinWidth="150" Margin="0,0,8,8" Padding="8,6">
                                <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 출력 접점 -->
        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="출력 접점 테스트" FontWeight="SemiBold" />
                <TextBlock Classes="muted" FontSize="12"
                           Text="출력별 ON/OFF 버튼을 눌러 실제 접점을 테스트합니다. 통신 연결 중에만 조작할 수 있습니다."
                           TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Outputs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:IoBit">
                            <Border Classes="badge" Classes.on="{Binding On}" Classes.off="{Binding !On}"
                                    Classes.unassigned="{Binding !Assigned}"
                                    Width="196" Margin="0,0,8,8" Padding="10,8">
                                <StackPanel Spacing="7">
                                    <TextBlock Text="{Binding Label}" HorizontalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Grid ColumnDefinitions="*,6,*">
                                        <Button Grid.Column="0" Content="ON" HorizontalContentAlignment="Center"
                                                Command="{Binding $parent[ItemsControl].((vm:IoModuleViewModel)DataContext).SetOutputOnCommand}"
                                                CommandParameter="{Binding}" />
                                        <Button Grid.Column="2" Content="OFF" HorizontalContentAlignment="Center"
                                                Command="{Binding $parent[ItemsControl].((vm:IoModuleViewModel)DataContext).SetOutputOffCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="muted" FontSize="12"
                           Text="{Binding PointMapNote}" TextWrapping="Wrap" />
                <Border Classes="alert" IsVisible="{Binding OutputMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Text="{Binding OutputMessage}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
