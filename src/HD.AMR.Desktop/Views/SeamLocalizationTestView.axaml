<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HD.AMR.Desktop.ViewModels"
             x:Class="HD.AMR.Desktop.Views.SeamLocalizationTestView"
             x:DataType="vm:SeamLocalizationTestViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.axis"><Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/><Setter Property="FontSize" Value="12"/></Style>
    <Style Selector="NumericUpDown.coord"><Setter Property="Width" Value="105"/></Style>
  </UserControl.Styles>
  <ScrollViewer>
    <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
      <TextBlock Classes="page-title" Text="용접선 위치 시험 (초안)"/>
      <TextBlock Classes="axis" TextWrapping="Wrap" Margin="0,0,0,10"
                 Text="ACS 월드 좌표의 용접선 중심을 T_W_A · T_A_B · T_B_T · T_T_C로 컬러 영상에 투영하고 ±200 mm Depth ROI를 검증합니다. 이 화면은 코봇 모션을 실행하지 않습니다."/>

      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
        <Border Classes="badge" Classes.on="{Binding IsAmrConnected}" Classes.off="{Binding !IsAmrConnected}"><TextBlock Text="AMR"/></Border>
        <Border Classes="badge" Classes.on="{Binding IsCobotConnected}" Classes.off="{Binding !IsCobotConnected}"><TextBlock Text="Cobot"/></Border>
        <Border Classes="badge" Classes.on="{Binding IsCameraStreaming}" Classes.off="{Binding !IsCameraStreaming}"><TextBlock Text="Depth Camera"/></Border>
      </StackPanel>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="ACS 입력 모사 · seamStartW / seamEndW (m)" FontWeight="SemiBold"/>
          <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" RowDefinitions="Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Start X" VerticalAlignment="Center"/><NumericUpDown Classes="coord" Grid.Row="0" Grid.Column="1" Value="{Binding StartX}" Increment="0.001" FormatString="0.000"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="Y" VerticalAlignment="Center"/><NumericUpDown Classes="coord" Grid.Row="0" Grid.Column="3" Value="{Binding StartY}" Increment="0.001" FormatString="0.000"/>
            <TextBlock Grid.Row="0" Grid.Column="4" Text="Z" VerticalAlignment="Center"/><NumericUpDown Classes="coord" Grid.Row="0" Grid.Column="5" Value="{Binding StartZ}" Increment="0.001" FormatString="0.000"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="End X" VerticalAlignment="Center"/><NumericUpDown Classes="coord" Grid.Row="1" Grid.Column="1" Value="{Binding EndX}" Increment="0.001" FormatString="0.000"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="Y" VerticalAlignment="Center"/><NumericUpDown Classes="coord" Grid.Row="1" Grid.Column="3" Value="{Binding EndY}" Increment="0.001" FormatString="0.000"/>
            <TextBlock Grid.Row="1" Grid.Column="4" Text="Z" VerticalAlignment="Center"/><NumericUpDown Classes="coord" Grid.Row="1" Grid.Column="5" Value="{Binding EndZ}" Increment="0.001" FormatString="0.000"/>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="ROI 반폭" VerticalAlignment="Center"/><NumericUpDown Width="110" Value="{Binding RoiHalfWidthMm}" Minimum="10" Maximum="500" Increment="10"/><TextBlock Text="mm" VerticalAlignment="Center"/>
            <TextBlock Text="T_T_C Tool" VerticalAlignment="Center" Margin="16,0,0,0"/><NumericUpDown Width="80" Value="{Binding Tool}" Minimum="0" Maximum="15" Increment="1"/>
            <Button Content="좌표 체인 분석" Classes="accent" Command="{Binding AnalyzeCommand}" IsEnabled="{Binding !Busy}" Margin="16,0,0,0"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card" Margin="0,10,0,0">
        <StackPanel Spacing="7">
          <TextBlock Text="분석 결과" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"/>
          <TextBlock Classes="axis" Text="{Binding ChainText}" TextWrapping="Wrap"/>
          <TextBlock Classes="axis" Text="{Binding CameraPointText}" TextWrapping="Wrap"/>
          <TextBlock Classes="axis" Text="{Binding RoiStatsText}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <StackPanel Margin="0,10,0,0">
        <TextBlock Text="Color 광학 프레임 투영 · 노랑=±ROI · 빨강=예상 용접선 중심" FontWeight="SemiBold"/>
        <Border Height="480" Background="Black" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4">
          <Grid Name="ImageHost">
            <Image Source="{Binding ColorImage}" Stretch="Fill"/>
            <Canvas Background="Transparent">
              <Rectangle Name="RoiRect" Stroke="#FFFF00" StrokeThickness="2" IsVisible="False"/>
              <Ellipse Name="TargetMark" Width="12" Height="12" Stroke="#FF4040" StrokeThickness="3" IsVisible="False"/>
            </Canvas>
          </Grid>
        </Border>
      </StackPanel>

      <Border Classes="card" Margin="0,10,0,0">
        <StackPanel Spacing="9">
          <TextBlock Text="ACS 계산 결과 입력 모사 (VDA5050 확장 데이터 초안)" FontSize="17" FontWeight="SemiBold"/>
          <TextBlock Classes="axis" TextWrapping="Wrap"
                     Text="ACS가 T_W_G를 적용해 계산한 월드/SLAM 좌표계(W) 기준 TOOL 목표 pose를 입력합니다. 이 영역은 데이터 계약 검토용이며 아직 코봇 이동을 실행하지 않습니다."/>

          <Grid ColumnDefinitions="Auto,2*,Auto,2*,Auto,*" RowDefinitions="Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="jobRef" VerticalAlignment="Center"/><TextBox Grid.Row="0" Grid.Column="1" Text="{Binding AcsJobRef}" Margin="5,2,12,2"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="taskId (UUID)" VerticalAlignment="Center"/><TextBox Grid.Row="0" Grid.Column="3" Text="{Binding AcsTaskId}" Margin="5,2,12,2"/>
            <TextBlock Grid.Row="0" Grid.Column="4" Text="attempt" VerticalAlignment="Center"/><NumericUpDown Grid.Row="0" Grid.Column="5" Value="{Binding AcsAttempt}" Minimum="1" Maximum="255" Increment="1"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="wall_code" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AcsWallCode}" Margin="5,2,12,2"/>
          </Grid>

          <TextBlock Text="좌표계 식별" FontWeight="SemiBold" Margin="0,4,0,0"/>
          <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*">
            <TextBlock Grid.Column="0" Text="mapId" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding AcsMapId}" Margin="5,2,12,2"/>
            <TextBlock Grid.Column="2" Text="mapVersion" VerticalAlignment="Center"/><TextBox Grid.Column="3" Text="{Binding AcsMapVersion}" Margin="5,2,12,2"/>
            <TextBlock Grid.Column="4" Text="registrationVersion" VerticalAlignment="Center"/><TextBox Grid.Column="5" Text="{Binding AcsRegistrationVersion}" Margin="5,2,0,2"/>
          </Grid>

          <TextBlock Text="targetToolPointW · ACS가 정차거리/워킹거리를 적용해 계산한 목표 TOOL 위치 (W 기준, m)" FontWeight="SemiBold" Margin="0,4,0,0"/>
          <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="X" VerticalAlignment="Center"/><NumericUpDown Classes="coord" Grid.Row="0" Grid.Column="1" Value="{Binding TargetWx}" Increment="0.001" FormatString="0.000"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="Y" VerticalAlignment="Center"/><NumericUpDown Classes="coord" Grid.Row="0" Grid.Column="3" Value="{Binding TargetWy}" Increment="0.001" FormatString="0.000"/>
            <TextBlock Grid.Row="0" Grid.Column="4" Text="Z" VerticalAlignment="Center"/><NumericUpDown Classes="coord" Grid.Row="0" Grid.Column="5" Value="{Binding TargetWz}" Increment="0.001" FormatString="0.000"/>
          </Grid>

          <TextBlock Text="surfaceNormalW · 벽면 바깥쪽 단위 법선 (W 기준)" FontWeight="SemiBold" Margin="0,4,0,0"/>
          <WrapPanel Orientation="Horizontal">
            <TextBlock Text="Nx" VerticalAlignment="Center"/><NumericUpDown Classes="coord" Value="{Binding NormalWx}" Increment="0.01" FormatString="0.000" Margin="5,0,12,0"/>
            <TextBlock Text="Ny" VerticalAlignment="Center"/><NumericUpDown Classes="coord" Value="{Binding NormalWy}" Increment="0.01" FormatString="0.000" Margin="5,0,12,0"/>
            <TextBlock Text="Nz" VerticalAlignment="Center"/><NumericUpDown Classes="coord" Value="{Binding NormalWz}" Increment="0.01" FormatString="0.000" Margin="5,0,12,0"/>
            <TextBlock Text="standoffMm" VerticalAlignment="Center"/><NumericUpDown Width="105" Value="{Binding AcsStandoffMm}" Minimum="0" Maximum="2000" Increment="1" Margin="5,0,12,0"/>
            <TextBlock Text="workingDistanceMm" VerticalAlignment="Center"/><NumericUpDown Width="105" Value="{Binding AcsWorkingDistanceMm}" Minimum="0" Maximum="5000" Increment="1" Margin="5,0,0,0"/>
          </WrapPanel>

          <Separator Margin="0,4"/>
          <WrapPanel Orientation="Horizontal">
            <TextBlock Text="이동 속도" VerticalAlignment="Center"/><NumericUpDown Width="85" Value="{Binding MoveVelocityPct}" Minimum="1" Maximum="20" Increment="1" Margin="5,0,5,0"/><TextBlock Text="%" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <TextBlock Text="최대 이동거리" VerticalAlignment="Center"/><NumericUpDown Width="100" Value="{Binding MaxMoveDistanceMm}" Minimum="10" Maximum="2000" Increment="10" Margin="5,0,5,0"/><TextBlock Text="mm" VerticalAlignment="Center"/>
          </WrapPanel>
          <CheckBox IsChecked="{Binding MotionConfirmed}" Content="주변 안전과 목표 좌표를 확인했습니다. 실제 코봇 이동을 허용합니다."/>
          <WrapPanel Orientation="Horizontal">
            <Button Content="계산된 위치로 TOOL 이동" Classes="accent" Command="{Binding MoveToAcsTargetCommand}" IsEnabled="{Binding !Busy}"/>
            <Button Content="즉시 정지" Command="{Binding StopCobotCommand}" Margin="8,0,0,0"/>
          </WrapPanel>
          <TextBlock Text="{Binding MoveStatusText}" TextWrapping="Wrap"/>

          <TextBlock Classes="axis" Foreground="#D69E2E" TextWrapping="Wrap"
                     Text="이동 시 Rx/Ry/Rz=0을 명령하지 않고 현재 선택 TOOL의 자세를 유지합니다. targetToolPointW는 ACS가 정차거리와 워킹거리를 반영한 최종 위치여야 합니다. surfaceNormalW는 길이 1이어야 하며 이후 광축 방향 검증에 사용합니다."/>
        </StackPanel>
      </Border>

      <Border Classes="alert" Margin="0,10,0,0">
        <TextBlock TextWrapping="Wrap" Text="초안 범위: 예상점/Depth ROI 분석과 ACS 목표점으로의 저속 MoveL 시험을 제공합니다. IK와 최대 이동거리는 확인하지만 충돌·특이점·작업공간 안전을 완전히 보장하지 않으므로 현장 안전 조치와 저속 수동 감시가 필요합니다."/>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
