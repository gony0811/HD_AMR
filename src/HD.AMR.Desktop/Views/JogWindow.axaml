<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HD.AMR.Desktop.ViewModels"
        xmlns:views="using:HD.AMR.Desktop.Views"
        x:Class="HD.AMR.Desktop.Views.JogWindow"
        x:DataType="vm:JogRibbonViewModel"
        Width="1040" Height="820"
        Title="코봇 조그"
        Background="{DynamicResource AppWindowBrush}">
    <ScrollViewer Padding="16">
        <StackPanel Spacing="8">
            <TextBlock Classes="page-title" Text="코봇 조그" />
            <!-- 팝업 단독 사용을 위해 안전 헤더(연결/서보/E-STOP/오류해제)를 함께 렌더한다. -->
            <views:JogRibbonView />
        </StackPanel>
    </ScrollViewer>
</Window>
