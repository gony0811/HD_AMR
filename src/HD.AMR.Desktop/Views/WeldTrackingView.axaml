<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HD.AMR.Desktop.ViewModels"
             x:Class="HD.AMR.Desktop.Views.WeldTrackingView"
             x:DataType="vm:WeldTrackingViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.axis"><Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" /><Setter Property="FontSize" Value="12" /></Style>
        <Style Selector="Border.imgbox"><Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="4" /><Setter Property="Background" Value="Black" /></Style>
        <Style Selector="Image.stream"><Setter Property="Stretch" Value="Fill" /></Style>
    </UserControl.Styles>

    <!-- 다른 페이지와 같은 최대 폭 + 왼쪽 정렬. 좌우 카드(*,*)를 같은 폭으로 나누려고 코드비하인드가 Width 를
         min(창 폭, MaxWidth) 로 지정한다(지정 안 하면 내용 크기로 줄어 카드마다 폭이 달라짐). -->
    <StackPanel Name="PageRoot" MaxWidth="1180" HorizontalAlignment="Left">
        <TextBlock Classes="page-title" Text="용접라인 추적 (수동 2-shot)" />
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Border Classes="badge" Classes.on="{Binding DetectorAvailable}" Classes.off="{Binding !DetectorAvailable}">
                <TextBlock Text="{Binding MethodText, StringFormat='검출 {0}'}" />
            </Border>
            <Border Classes="badge"><TextBlock Text="{Binding StateText, StringFormat='상태: {0}'}" /></Border>
            <TextBlock Classes="axis" VerticalAlignment="Center"
                       Text="검출은 카메라·OpenCV/ONNX 필요 (Windows 전용). macOS 는 비활성." />
        </StackPanel>

        <Grid ColumnDefinitions="*,*">
            <!-- 좌: ROI 에디터 -->
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock FontWeight="SemiBold">
                            <Run Text="ROI 지정" /><Run Text="  스트림 위 드래그" FontWeight="Normal" FontSize="12" Foreground="{DynamicResource AppMutedTextBrush}" />
                        </TextBlock>
                        <Grid ColumnDefinitions="*,Auto">
                            <ComboBox SelectedIndex="{Binding DrawKindIndex}" HorizontalAlignment="Stretch">
                                <ComboBoxItem>Bead ROI</ComboBoxItem>
                                <ComboBoxItem>Peak ROI</ComboBoxItem>
                            </ComboBox>
                            <Button Grid.Column="1" Margin="8,0,0,0" Content="ROI 초기화" Command="{Binding ResetRoiCommand}" />
                        </Grid>

                        <Border Classes="imgbox" Height="300" IsVisible="{Binding IsStreaming}">
                            <Grid Name="EditorHost" Background="Transparent">
                                <Image Classes="stream" Source="{Binding EditorImage}" />
                                <Canvas Name="EditorOverlay" Background="Transparent">
                                    <Rectangle Name="WeldRect" Stroke="#FFD000" StrokeThickness="2" IsVisible="False" />
                                    <Rectangle Name="PeakRect" Stroke="#00C6E0" StrokeThickness="2" IsVisible="False" />
                                    <Rectangle Name="DragRect" Stroke="#FFFFFF" StrokeThickness="1" StrokeDashArray="4,3" IsVisible="False" />
                                </Canvas>
                            </Grid>
                        </Border>
                        <Border Classes="alert" Margin="0" IsVisible="{Binding !IsStreaming}">
                            <TextBlock Text="⏸ 스트림 정지 — Camera 페이지에서 시작 후 지정하세요" TextWrapping="Wrap" />
                        </Border>

                        <!-- X·Y·W·H — 카드 폭을 4등분(좁으면 코드비하인드가 2×2 로 바꿈). 영역 밖으로 밀리지 않게 칸 폭에 맞춰 늘린다. -->
                        <UniformGrid Name="RoiNumbers" Columns="4">
                            <StackPanel Margin="0,0,6,6"><TextBlock Classes="axis" Text="X" /><NumericUpDown Value="{Binding Mx}" Increment="1" FormatString="0" HorizontalAlignment="Stretch" MinWidth="0" /></StackPanel>
                            <StackPanel Margin="0,0,6,6"><TextBlock Classes="axis" Text="Y" /><NumericUpDown Value="{Binding My}" Increment="1" FormatString="0" HorizontalAlignment="Stretch" MinWidth="0" /></StackPanel>
                            <StackPanel Margin="0,0,6,6"><TextBlock Classes="axis" Text="W" /><NumericUpDown Value="{Binding Mw}" Increment="1" FormatString="0" HorizontalAlignment="Stretch" MinWidth="0" /></StackPanel>
                            <StackPanel Margin="0,0,0,6"><TextBlock Classes="axis" Text="H" /><NumericUpDown Value="{Binding Mh}" Increment="1" FormatString="0" HorizontalAlignment="Stretch" MinWidth="0" /></StackPanel>
                        </UniformGrid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap">
                                <Run Text="Bead" Foreground="#CAA500" /><Run Text=" " /><Run Text="{Binding WeldRoiText}" />
                                <Run Text="  ·  Peak" Foreground="#00A6C0" /><Run Text=" " /><Run Text="{Binding PeakRoiText}" />
                            </TextBlock>
                            <Button Grid.Column="1" Margin="8,0,0,0" Content="ROI 적용" Command="{Binding ApplyManualRoiCommand}" />
                        </Grid>

                        <Separator Margin="0,4" />
                        <Grid ColumnDefinitions="*,Auto,*,Auto">
                            <StackPanel><TextBlock Classes="axis" Text="프로파일명" /><TextBox Text="{Binding ProfileName}" /></StackPanel>
                            <Button Grid.Column="1" Margin="8,0" VerticalAlignment="Bottom" Content="저장" Classes="accent" Command="{Binding SaveProfileCommand}" />
                            <StackPanel Grid.Column="2"><TextBlock Classes="axis" Text="불러오기" /><ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding LoadName}" HorizontalAlignment="Stretch" PlaceholderText="선택" /></StackPanel>
                            <Button Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Bottom" Content="불러오기" Command="{Binding LoadProfileCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,10,0,0">
                    <TextBlock Classes="axis" Text="최근 검출 오버레이 (라이브 미리보기)" />
                    <Border Classes="imgbox" Height="240"><Image Classes="stream" Source="{Binding OverlayImage}" /></Border>
                </StackPanel>
            </StackPanel>

            <!-- 우: 검출/측정 -->
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="검출 방식" FontWeight="SemiBold" />
                        <!-- 라벨 열(56) 고정 + 드롭박스 칸을 같은 격자에 맞춤: 방식 / 모델 / 입력·진행축 -->
                        <Grid ColumnDefinitions="56,*,68,*" RowDefinitions="Auto,Auto,Auto">
                            <TextBlock Classes="axis" Text="방식" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" Grid.ColumnSpan="3" SelectedIndex="{Binding MethodIndex}" HorizontalAlignment="Stretch">
                                <ComboBoxItem>🧠 YOLO 세그멘테이션</ComboBoxItem>
                                <ComboBoxItem>🧩 U-Net·히트맵 세그멘테이션</ComboBoxItem>
                                <ComboBoxItem>⚙ 파라미터(CV)</ComboBoxItem>
                                <ComboBoxItem>〰 Ridge 필터(학습 불필요)</ComboBoxItem>
                            </ComboBox>
                            <!-- 모델 선택 — 검출 방식에 맞는 .onnx 만 표시(DL: weld_yolo/weld_seg, U-Net·히트맵: weld_unet/weld_heatmap).
                                 고르는 즉시 Weld.Yolo.ModelPath / Weld.Unet.ModelPath 저장(시퀀스·재시작 공유). 모델을 쓰지 않는 방식이면 행 숨김. -->
                            <TextBlock Grid.Row="1" Margin="0,8,0,0" Classes="axis" Text="모델" VerticalAlignment="Center" IsVisible="{Binding IsModelMethod}"
                                       ToolTip.Tip="{Binding ModelLabel}" />
                            <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,8,0,0" ColumnDefinitions="*,Auto" IsVisible="{Binding IsModelMethod}">
                                <ComboBox ItemsSource="{Binding DlModels}" SelectedItem="{Binding SelectedDlModel}" HorizontalAlignment="Stretch"
                                          PlaceholderText="모델을 선택하세요" />
                                <Button Grid.Column="1" Margin="8,0,0,0" Content="⟳" Command="{Binding LoadDlModelsCommand}" ToolTip.Tip="모델 목록 새로고침 (내보내기·이름 변경 후)" />
                            </Grid>
                            <!-- 입력 영상 = 학습한 모델의 모달리티와 맞춰야 한다. 모델을 고르면 파일명(ir/rgb)에 맞춰 입력이 자동 지정된다.
                                 Ridge·CV 검출도 이 입력 영상을 쓴다. 바꾸면 파라미터(Weld.ImageMode)에 저장되어 재시작 후에도 유지된다. -->
                            <TextBlock Grid.Row="2" Margin="0,8,0,0" Classes="axis" Text="입력" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" SelectedIndex="{Binding ImageModeIndex}" HorizontalAlignment="Stretch">
                                <ComboBoxItem>IR</ComboBoxItem>
                                <ComboBoxItem>RGB Grayscale</ComboBoxItem>
                                <ComboBoxItem>RGB HSV(S)</ComboBoxItem>
                            </ComboBox>
                            <!-- 진행축 = 용접선(비드)이 뻗은 방향. Peak 선은 이 축에 수직으로 그려진다.
                                 시퀀스 실행 시 검사방향으로 자동 설정되며, 여기서는 수동 시험용으로 바꾼다. -->
                            <TextBlock Grid.Row="2" Grid.Column="2" Margin="12,8,0,0" Classes="axis" Text="진행축" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="2" Grid.Column="3" Margin="0,8,0,0" SelectedIndex="{Binding ProgressAxisIndex}" HorizontalAlignment="Stretch">
                                <ComboBoxItem>가로 (Peak 선 세로)</ComboBoxItem>
                                <ComboBoxItem>세로 (Peak 선 가로)</ComboBoxItem>
                            </ComboBox>
                        </Grid>
                        <Border Classes="alert" Margin="0" IsVisible="{Binding IsRgbMode}">
                            <TextBlock FontSize="12" TextWrapping="Wrap">
                                <Run Text="ⓘ RGB 입력: ROI는 IR 기준으로 저장됩니다  " />
                                <Run Text="자세히" TextDecorations="Underline" />
                                <ToolTip.Tip>
                                    <TextBlock MaxWidth="420" TextWrapping="Wrap"
                                               Text="RGB 입력: 시퀀스·자동모드도 비드를 컬러 영상에서 찾되, 센터링·거리 기준은 IR 과 같습니다. ROI 는 이 화면에서 그려도 IR 기준으로 저장됩니다(Depth·카메라 연결 필요). 작업거리가 크게 바뀌면 컬러 화면의 ROI 표시 위치가 조금 밀릴 수 있습니다." />
                                </ToolTip.Tip>
                            </TextBlock>
                        </Border>
                        <!-- Ridge 검출 파라미터 — 바꾸는 즉시 DB(Weld.Ridge.*) 저장, 시퀀스·재시작 후에도 동일 값 사용. -->
                        <Border Classes="card" IsVisible="{Binding IsRidge}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Ridge 검출 파라미터 (변경 즉시 저장)" FontWeight="SemiBold" />
                                <WrapPanel Orientation="Horizontal">
                                    <StackPanel Margin="0,0,8,4"><TextBlock Classes="axis" Text="σ 최소(px)" /><NumericUpDown Value="{Binding RidgeSigmaMin}" Minimum="0.5" Maximum="20" Increment="0.5" FormatString="0.0" Width="110" /></StackPanel>
                                    <StackPanel Margin="0,0,8,4"><TextBlock Classes="axis" Text="σ 최대(px)" /><NumericUpDown Value="{Binding RidgeSigmaMax}" Minimum="0.5" Maximum="20" Increment="0.5" FormatString="0.0" Width="110" /></StackPanel>
                                    <StackPanel Margin="0,0,8,4"><TextBlock Classes="axis" Text="스케일 수" /><NumericUpDown Value="{Binding RidgeScales}" Minimum="1" Maximum="6" Increment="1" FormatString="0" Width="100" /></StackPanel>
                                    <StackPanel Margin="0,0,8,4"><TextBlock Classes="axis" Text="극성" />
                                        <ComboBox SelectedIndex="{Binding RidgePolarityIndex}" Width="130">
                                            <ComboBoxItem>밝/어둡 모두</ComboBoxItem>
                                            <ComboBoxItem>밝은 선</ComboBoxItem>
                                            <ComboBoxItem>어두운 선</ComboBoxItem>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,4"><TextBlock Classes="axis" Text="허용각(°)" /><NumericUpDown Value="{Binding RidgeMaxAngleDeg}" Minimum="0" Maximum="90" Increment="5" FormatString="0" Width="100" /></StackPanel>
                                    <StackPanel Margin="0,0,8,4"><TextBlock Classes="axis" Text="임계 k" /><NumericUpDown Value="{Binding RidgeThresholdK}" Minimum="0" Maximum="50" Increment="0.5" FormatString="0.0" Width="100" /></StackPanel>
                                    <StackPanel Margin="0,0,8,4"><TextBlock Classes="axis" Text="상대 임계(0~1)" /><NumericUpDown Value="{Binding RidgeRelative}" Minimum="0" Maximum="1" Increment="0.05" FormatString="0.00" Width="110" /></StackPanel>
                                    <Button Margin="0,0,0,4" VerticalAlignment="Bottom" Content="기본값" Command="{Binding ResetRidgeCommand}" />
                                </WrapPanel>
                                <TextBlock Classes="hint" TextWrapping="Wrap"
                                           Text="σ 최대를 낮추면 넓은 하이라이트(코로게이션 능선) 응답이 줄고, 극성을 비드 쪽으로 고르면 반대 극성의 능선이 빠집니다. 허용각은 진행축 대비 선 기울기 허용치입니다. 바꾼 뒤 Detect 로 확인하세요." />
                            </StackPanel>
                        </Border>
                        <!-- YOLO 임계값 — 슬라이더는 라이브 검출에 바로 반영, "파라미터에 저장" 때만 Weld.Yolo.* 저장(시퀀스·재시작 공유). -->
                        <StackPanel IsVisible="{Binding IsDl}">
                            <Separator Margin="0,2,0,6" />
                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock FontSize="12" Text="YOLO 임계값" Foreground="{DynamicResource AppMutedTextBrush}" VerticalAlignment="Center" />
                                    <Border CornerRadius="4" Padding="6,1" Background="{DynamicResource AppWarnBgBrush}" IsVisible="{Binding DlDirty}">
                                        <TextBlock FontSize="11" Foreground="{DynamicResource AppWarnFgBrush}" Text="{Binding DlSavedText}" />
                                    </Border>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource AppGoodBrush}" Text="✓ 저장됨" VerticalAlignment="Center" IsVisible="{Binding !DlDirty}" />
                                </StackPanel>
                                <Button Grid.Column="1" Margin="8,0,0,0" Content="되돌리기" Command="{Binding RevertDlThresholdsCommand}" IsEnabled="{Binding DlDirty}"
                                        ToolTip.Tip="저장값으로 되돌립니다" />
                                <Button Grid.Column="2" Margin="8,0,0,0" Content="파라미터에 저장" Command="{Binding SaveDlThresholdsCommand}" IsEnabled="{Binding DlDirty}"
                                        ToolTip.Tip="이 임계값을 파라미터에 저장 — 시퀀스·재시작 후에도 이 값을 씁니다" />
                            </Grid>
                            <Grid ColumnDefinitions="44,*,40,24,44,*,40">
                                <TextBlock Classes="axis" Text="conf" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Value="{Binding DlConfidence}" Minimum="{Binding DlConfidenceMin}" Maximum="{Binding DlConfidenceMax}"
                                        TickFrequency="0.05" IsSnapToTickEnabled="True" />
                                <TextBlock Grid.Column="2" Text="{Binding DlConfidence, StringFormat='{}{0:0.00}'}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="4" Classes="axis" Text="mask" VerticalAlignment="Center" />
                                <Slider Grid.Column="5" Value="{Binding DlMaskThreshold}" Minimum="{Binding DlMaskThresholdMin}" Maximum="{Binding DlMaskThresholdMax}"
                                        TickFrequency="0.05" IsSnapToTickEnabled="True" />
                                <TextBlock Grid.Column="6" Text="{Binding DlMaskThreshold, StringFormat='{}{0:0.00}'}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                            <TextBlock Classes="axis" Margin="0,6,0,0" Text="움직이면 라이브 검출에 바로 반영 · 시퀀스·재시작은 저장한 값 사용" />
                        </StackPanel>
                        <!-- U-Net 임계값 — 슬라이더는 라이브 검출에 바로 반영, "파라미터에 저장" 때만 Weld.Unet.Threshold 저장. -->
                        <StackPanel IsVisible="{Binding IsUnet}">
                            <Separator Margin="0,2,0,6" />
                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock FontSize="12" Text="U-Net 임계값" Foreground="{DynamicResource AppMutedTextBrush}" VerticalAlignment="Center" />
                                    <Border CornerRadius="4" Padding="6,1" Background="{DynamicResource AppWarnBgBrush}" IsVisible="{Binding UnetDirty}">
                                        <TextBlock FontSize="11" Foreground="{DynamicResource AppWarnFgBrush}" Text="{Binding UnetSavedText}" />
                                    </Border>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource AppGoodBrush}" Text="✓ 저장됨" VerticalAlignment="Center" IsVisible="{Binding !UnetDirty}" />
                                </StackPanel>
                                <Button Grid.Column="1" Margin="8,0,0,0" Content="되돌리기" Command="{Binding RevertUnetThresholdCommand}" IsEnabled="{Binding UnetDirty}"
                                        ToolTip.Tip="저장값으로 되돌립니다" />
                                <Button Grid.Column="2" Margin="8,0,0,0" Content="파라미터에 저장" Command="{Binding SaveUnetThresholdCommand}" IsEnabled="{Binding UnetDirty}"
                                        ToolTip.Tip="이 임계값을 파라미터에 저장 — 시퀀스·재시작 후에도 이 값을 씁니다" />
                            </Grid>
                            <Grid ColumnDefinitions="44,*,40">
                                <TextBlock Classes="axis" Text="확률" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Value="{Binding UnetThreshold}" Minimum="{Binding UnetThresholdMin}" Maximum="{Binding UnetThresholdMax}"
                                        TickFrequency="0.05" IsSnapToTickEnabled="True" />
                                <TextBlock Grid.Column="2" Text="{Binding UnetThreshold, StringFormat='{}{0:0.00}'}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                            <TextBlock Classes="axis" Margin="0,6,0,0" Text="움직이면 라이브 검출에 바로 반영 · 시퀀스·재시작은 저장한 값 사용" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="1회 검출(Peak)" Classes="accent" Command="{Binding FindPeakCommand}" IsEnabled="{Binding !Busy}" />
                            <Button Content="#1 캡처" Command="{Binding CaptureCommand}" CommandParameter="1" IsEnabled="{Binding DetectorAvailable}" />
                            <Button Content="#2 캡처" Command="{Binding CaptureCommand}" CommandParameter="2" IsEnabled="{Binding DetectorAvailable}" />
                            <Button Content="Detect" Command="{Binding DetectOnceCommand}" IsEnabled="{Binding DetectorAvailable}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <StackPanel><TextBlock Classes="axis" Text="Pitch" /><NumericUpDown Value="{Binding Pitch}" Increment="0.1" FormatString="0.0" /></StackPanel>
                            <Button VerticalAlignment="Bottom" Content="각도 계산" Classes="accent" Command="{Binding ComputeAngleCommand}" />
                            <Button VerticalAlignment="Bottom" Content="측정 초기화" Command="{Binding ResetMeasurementsCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 학습 데이터 캡처 — Camera 페이지와 같은 기능·같은 저장 폴더(Camera.Capture.Dir). -->
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="학습 데이터 캡처 (RGB·IR·Depth · PNG 무손실)" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="저장 폴더" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" Text="{Binding CaptureDir}" IsReadOnly="True" Watermark="폴더 선택… 버튼으로 지정" />
                            <Button Grid.Column="2" Name="BrowseButton" Margin="8,0,0,0" Content="📁 폴더 선택…" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="📷 캡처" Classes="accent" Command="{Binding TrainingCaptureCommand}" IsEnabled="{Binding IsStreaming}" />
                            <TextBlock Classes="axis" VerticalAlignment="Center" Text="{Binding CaptureCount, StringFormat='세션 누적 {0}회'}" />
                            <TextBlock Classes="axis" VerticalAlignment="Center" Text="{Binding LastCaptureInfo}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="4">
                        <TextBlock Text="측정 결과" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="120,*"><TextBlock Text="#1 비드 d" Classes="axis" /><TextBlock Grid.Column="1" Text="{Binding M1Text}" /></Grid>
                        <Grid ColumnDefinitions="120,*"><TextBlock Text="#2 비드 d" Classes="axis" /><TextBlock Grid.Column="1" Text="{Binding M2Text}" /></Grid>
                        <Grid ColumnDefinitions="120,*"><TextBlock Text="theta" Classes="axis" /><TextBlock Grid.Column="1" Text="{Binding AngleText}" FontWeight="SemiBold" /></Grid>
                    </StackPanel>
                </Border>

                <Grid ColumnDefinitions="*,*">
                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                        <TextBlock Classes="axis" Text="Peak #1" />
                        <Border Classes="imgbox" Height="180"><Image Classes="stream" Source="{Binding Peak1Image}" /></Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                        <TextBlock Classes="axis" Text="Peak #2" />
                        <Border Classes="imgbox" Height="180"><Image Classes="stream" Source="{Binding Peak2Image}" /></Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>

        <Border Classes="alert" IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        </Border>
    </StackPanel>
</UserControl>
