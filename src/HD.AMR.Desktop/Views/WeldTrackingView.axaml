<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HD.AMR.Desktop.ViewModels"
             x:Class="HD.AMR.Desktop.Views.WeldTrackingView"
             x:DataType="vm:WeldTrackingViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.axis"><Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" /><Setter Property="FontSize" Value="12" /></Style>
        <Style Selector="Border.imgbox"><Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="4" /><Setter Property="Background" Value="Black" /></Style>
        <Style Selector="Image.stream"><Setter Property="Stretch" Value="Fill" /></Style>
    </UserControl.Styles>

    <StackPanel MaxWidth="1180" HorizontalAlignment="Left">
        <TextBlock Classes="page-title" Text="용접라인 추적 (수동 2-shot)" />
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Border Classes="badge" Classes.on="{Binding DetectorAvailable}" Classes.off="{Binding !DetectorAvailable}">
                <TextBlock Text="{Binding MethodText, StringFormat='검출 {0}'}" />
            </Border>
            <Border Classes="badge"><TextBlock Text="{Binding StateText, StringFormat='상태: {0}'}" /></Border>
            <TextBlock Classes="axis" VerticalAlignment="Center"
                       Text="검출은 카메라·OpenCV/ONNX 필요 (Windows 전용). macOS 는 비활성." />
        </StackPanel>

        <Grid ColumnDefinitions="*,*">
            <!-- 좌: ROI 에디터 -->
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="ROI 지정 (스트림 위 드래그)" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox SelectedIndex="{Binding DrawKindIndex}" Width="140">
                                <ComboBoxItem>Bead ROI</ComboBoxItem>
                                <ComboBoxItem>Peak ROI</ComboBoxItem>
                            </ComboBox>
                            <Button Content="ROI 초기화" Command="{Binding ResetRoiCommand}" />
                        </StackPanel>

                        <Border Classes="imgbox" Height="300" IsVisible="{Binding IsStreaming}">
                            <Grid Name="EditorHost" Background="Transparent">
                                <Image Classes="stream" Source="{Binding EditorImage}" />
                                <Canvas Name="EditorOverlay" Background="Transparent">
                                    <Rectangle Name="WeldRect" Stroke="#FFD000" StrokeThickness="2" IsVisible="False" />
                                    <Rectangle Name="PeakRect" Stroke="#00C6E0" StrokeThickness="2" IsVisible="False" />
                                    <Rectangle Name="DragRect" Stroke="#FFFFFF" StrokeThickness="1" StrokeDashArray="4,3" IsVisible="False" />
                                </Canvas>
                            </Grid>
                        </Border>
                        <Border Classes="alert" IsVisible="{Binding !IsStreaming}">
                            <TextBlock Text="스트림이 정지 상태입니다. Camera 페이지에서 시작 후 ROI를 지정하세요." />
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <StackPanel><TextBlock Classes="axis" Text="X" /><NumericUpDown Value="{Binding Mx}" Increment="1" FormatString="0" /></StackPanel>
                            <StackPanel><TextBlock Classes="axis" Text="Y" /><NumericUpDown Value="{Binding My}" Increment="1" FormatString="0" /></StackPanel>
                            <StackPanel><TextBlock Classes="axis" Text="W" /><NumericUpDown Value="{Binding Mw}" Increment="1" FormatString="0" /></StackPanel>
                            <StackPanel><TextBlock Classes="axis" Text="H" /><NumericUpDown Value="{Binding Mh}" Increment="1" FormatString="0" /></StackPanel>
                            <Button VerticalAlignment="Bottom" Content="ROI 적용" Command="{Binding ApplyManualRoiCommand}" />
                        </StackPanel>
                        <TextBlock FontSize="12">
                            <Run Text="Bead:" Foreground="#CAA500" /><Run Text="{Binding WeldRoiText}" />
                            <Run Text="  |  Peak:" Foreground="#00A6C0" /><Run Text="{Binding PeakRoiText}" />
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <StackPanel Width="150"><TextBlock Classes="axis" Text="프로파일명" /><TextBox Text="{Binding ProfileName}" /></StackPanel>
                            <Button VerticalAlignment="Bottom" Content="Save" Classes="accent" Command="{Binding SaveProfileCommand}" />
                            <StackPanel Width="150"><TextBlock Classes="axis" Text="불러오기" /><ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding LoadName}" HorizontalAlignment="Stretch" /></StackPanel>
                            <Button VerticalAlignment="Bottom" Content="Load" Command="{Binding LoadProfileCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,10,0,0">
                    <TextBlock Classes="axis" Text="최근 검출 오버레이 (라이브 미리보기)" />
                    <Border Classes="imgbox" Height="240"><Image Classes="stream" Source="{Binding OverlayImage}" /></Border>
                </StackPanel>
            </StackPanel>

            <!-- 우: 검출/측정 -->
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="검출 방식" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox SelectedIndex="{Binding MethodIndex}" Width="200">
                                <ComboBoxItem>🧠 DL 모델</ComboBoxItem>
                                <ComboBoxItem>⚙ 파라미터(CV)</ComboBoxItem>
                            </ComboBox>
                            <!-- 진행축 = 용접선(비드)이 뻗은 방향. Peak 선은 이 축에 수직으로 그려진다.
                                 시퀀스 실행 시 검사방향으로 자동 설정되며, 여기서는 수동 시험용으로 바꾼다. -->
                            <TextBlock Classes="axis" Text="진행축" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <ComboBox SelectedIndex="{Binding ProgressAxisIndex}" Width="150">
                                <ComboBoxItem>가로 (Peak 선 세로)</ComboBoxItem>
                                <ComboBoxItem>세로 (Peak 선 가로)</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="1회 검출(Peak)" Classes="accent" Command="{Binding FindPeakCommand}" IsEnabled="{Binding !Busy}" />
                            <Button Content="#1 캡처" Command="{Binding CaptureCommand}" CommandParameter="1" IsEnabled="{Binding DetectorAvailable}" />
                            <Button Content="#2 캡처" Command="{Binding CaptureCommand}" CommandParameter="2" IsEnabled="{Binding DetectorAvailable}" />
                            <Button Content="Detect" Command="{Binding DetectOnceCommand}" IsEnabled="{Binding DetectorAvailable}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <StackPanel><TextBlock Classes="axis" Text="Pitch" /><NumericUpDown Value="{Binding Pitch}" Increment="0.1" FormatString="0.0" /></StackPanel>
                            <Button VerticalAlignment="Bottom" Content="각도 계산" Classes="accent" Command="{Binding ComputeAngleCommand}" />
                            <Button VerticalAlignment="Bottom" Content="측정 초기화" Command="{Binding ResetMeasurementsCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 학습 데이터 캡처 — Camera 페이지와 같은 기능·같은 저장 폴더(Camera.Capture.Dir). -->
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="학습 데이터 캡처 (RGB·IR·Depth · PNG 무손실)" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="저장 폴더" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" Text="{Binding CaptureDir}" IsReadOnly="True" Watermark="폴더 선택… 버튼으로 지정" />
                            <Button Grid.Column="2" Name="BrowseButton" Margin="8,0,0,0" Content="📁 폴더 선택…" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="📷 캡처" Classes="accent" Command="{Binding TrainingCaptureCommand}" IsEnabled="{Binding IsStreaming}" />
                            <TextBlock Classes="axis" VerticalAlignment="Center" Text="{Binding CaptureCount, StringFormat='세션 누적 {0}회'}" />
                            <TextBlock Classes="axis" VerticalAlignment="Center" Text="{Binding LastCaptureInfo}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="4">
                        <TextBlock Text="측정 결과" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="120,*"><TextBlock Text="#1 비드 d" Classes="axis" /><TextBlock Grid.Column="1" Text="{Binding M1Text}" /></Grid>
                        <Grid ColumnDefinitions="120,*"><TextBlock Text="#2 비드 d" Classes="axis" /><TextBlock Grid.Column="1" Text="{Binding M2Text}" /></Grid>
                        <Grid ColumnDefinitions="120,*"><TextBlock Text="theta" Classes="axis" /><TextBlock Grid.Column="1" Text="{Binding AngleText}" FontWeight="SemiBold" /></Grid>
                    </StackPanel>
                </Border>

                <Grid ColumnDefinitions="*,*">
                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                        <TextBlock Classes="axis" Text="Peak #1" />
                        <Border Classes="imgbox" Height="180"><Image Classes="stream" Source="{Binding Peak1Image}" /></Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                        <TextBlock Classes="axis" Text="Peak #2" />
                        <Border Classes="imgbox" Height="180"><Image Classes="stream" Source="{Binding Peak2Image}" /></Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>

        <Border Classes="alert" IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        </Border>
    </StackPanel>
</UserControl>
