<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HD.AMR.Desktop.ViewModels"
             xmlns:views="using:HD.AMR.Desktop.Views"
             x:Class="HD.AMR.Desktop.Views.ArucoCalibrationView"
             x:DataType="vm:ArucoCalibrationViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.axis">
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- 프리뷰 상태 배지: 기본 회색, 대상 마커 검출 시 초록 강조 -->
        <Style Selector="TextBlock.previewStatus">
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.previewStatus.found">
            <Setter Property="Foreground" Value="{DynamicResource AppGoodBrush}" />
        </Style>
    </UserControl.Styles>

    <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
        <TextBlock Classes="page-title" Text="장착 보정 (ArUco)" />
        <TextBlock Classes="page-subtitle" TextWrapping="Wrap"
                   Text="① ArUco로 Tool TCP → 카메라 변환(T_T_C)을 보정한 뒤, ② 설치 도면에서 확인한 AMR 원점 기준 코봇 BASE 장착 자세(T_A_B)를 직접 입력합니다." />

        <!-- 공유 설정 — 단일 원천 -->
        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Classes="cardHead" Text="TTC hand-eye 보정 설정" />
                <WrapPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Classes="axis" Text="카메라 Tool 번호" />
                        <NumericUpDown Value="{Binding Tool}" Minimum="0" Maximum="15" Increment="1" FormatString="0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Classes="axis" Text="ArUco ID" />
                        <NumericUpDown Value="{Binding MarkerId}" Minimum="0" Maximum="49" Increment="1" FormatString="0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Classes="axis" Text="마커 크기 (mm)" />
                        <NumericUpDown Value="{Binding MarkerSizeMm}" Minimum="10" Increment="1" />
                    </StackPanel>
                </WrapPanel>
                <Border Classes="alert"><TextBlock TextWrapping="Wrap" FontSize="12"
                    Text="T_T_C는 선택한 Tool TCP 기준입니다. 카메라에 컨트롤러 TOOL이 없으면 0(플랜지)을 사용하세요." /></Border>
                <TextBlock Text="{Binding StepGuideText}" FontWeight="SemiBold" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- 실시간 카메라 뷰 — 마커가 실제로 읽히는지 눈으로 확인한다. 검출 박스+ID 는 영상에 그려져 온다. -->
        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Classes="cardHead" Text="카메라 실시간 뷰 (ArUco 검출)" />
                <Border Height="280" Background="Black" CornerRadius="6" ClipToBounds="True">
                    <Panel>
                        <TextBlock Text="카메라 영상 없음" Foreground="Gray"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{Binding PreviewImage}" Stretch="Uniform" />
                    </Panel>
                </Border>
                <TextBlock Classes="previewStatus" Classes.found="{Binding TargetMarkerFound}"
                           Text="{Binding PreviewStatusText}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TabControl SelectedIndex="{Binding SelectedStep}">
            <TabItem Header="① 핸드아이 측정 (T_T_C)">
                <views:HandEyeView DataContext="{Binding HandEyeStep}" Margin="0,8,0,0" />
            </TabItem>
            <TabItem Header="② T_A_B 직접 입력" IsEnabled="{Binding MountStepReady}">
                <views:ArucoMountCalibrationView DataContext="{Binding MountStep}" Margin="0,8,0,0" />
            </TabItem>
        </TabControl>
    </StackPanel>
</UserControl>
