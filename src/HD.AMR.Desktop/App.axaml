<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:HD.AMR.Desktop"
             x:Class="HD.AMR.Desktop.App"
             RequestedThemeVariant="Dark">
    <!-- HD_ACS 데스크톱과 통일 — Fluent 다크 고정 + ACS와 같은 브러시 키(Themes/Brushes.axaml). -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://HD.AMR.Desktop/Themes/Brushes.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Fluent 액센트(accent 버튼·ListBox 선택·포커스 링·탭 밑줄)를 ACS 운영 화면(docs/ACS_UI.jpg)의 파랑으로 고정
                 — OS 액센트 설정과 무관하게 두 앱이 같은 색으로 보이도록. -->
            <Color x:Key="SystemAccentColor">#1E7FFF</Color>
            <Color x:Key="SystemAccentColorDark1">#186BDB</Color>
            <Color x:Key="SystemAccentColorDark2">#1259B8</Color>
            <Color x:Key="SystemAccentColorDark3">#0D4694</Color>
            <Color x:Key="SystemAccentColorLight1">#4C99FF</Color>
            <Color x:Key="SystemAccentColorLight2">#79B2FF</Color>
            <Color x:Key="SystemAccentColorLight3">#A6CCFF</Color>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://HD.AMR.Desktop/Styles/Shared.axaml" />
    </Application.Styles>

</Application>
