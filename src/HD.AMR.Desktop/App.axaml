<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:HD.AMR.Desktop"
             x:Class="HD.AMR.Desktop.App"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://HD.AMR.Desktop/Styles/Shared.axaml" />
    </Application.Styles>

</Application>
